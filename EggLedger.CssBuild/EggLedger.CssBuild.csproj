<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Build-time CSS compiler for EggLedger.Web: compiles the global sheet (palette tokens, base, true globals, shared EggIdentity.Styles component layer) into wwwroot/styles.css via MonorailCss.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
    <MinVerSkip>true</MinVerSkip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonorailCss" />
    <PackageReference Include="EggIdentity.Styles" />
  </ItemGroup>

</Project>
