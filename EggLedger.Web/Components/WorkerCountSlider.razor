<div class="wcs @ZoneClass(WorkerCount)" style="--wcs-pos: @($"{(WorkerCount - 0.5) * 10}%")">
    <div class="wcs-marker">
        <span class="wcs-marker-value">
            @WorkerCount
        </span>
        <div class="wcs-marker-line">
        </div>
    </div>
    <div class="wcs-cells">
        @foreach (var n in Enumerable.Range(1, SettingsModel.MaxWorkerCount)) {
            <div class="wcs-cell @CellClass(n) @(n > WorkerCount ? "wcs-cell-off" : "")"
                 @onclick="() => SetAsync(n)">
            </div>
        }
    </div>
    <div class="wcs-legend">
        <span class="wcs-legend-safe">Safe</span>
        <span class="wcs-legend-caution">Caution</span>
        <span class="wcs-legend-risky">Risky</span>
    </div>
</div>
@if (ShowWarningBox && !WarningRead) {
    <div class="wcs-warning">
        <span class="wcs-warning-title ledger-underline">Warning:</span><br/>
        Higher values fetch missions faster but may trigger API rate limiting.
        Sustained use of higher values can lead to IP blocking and potential further consequences.
        <br/><br/>
        <button type="button" class="wcs-dismiss" @onclick="DismissWarningAsync">I understand</button>
    </div>
}

@code {
    [Parameter] public int WorkerCount { get; set; }

    [Parameter] public EventCallback<int> WorkerCountChanged { get; set; }

    [Parameter] public bool WarningRead { get; set; }

    [Parameter] public EventCallback DismissWarning { get; set; }

    [Parameter] public bool ShowWarningBox { get; set; } = true;

    private static string ZoneClass(int n) {
        return n <= 4 ? "wcs-safe" : n <= 7 ? "wcs-caution" : "wcs-risky";
    }

    private static string CellClass(int n) {
        return n <= 4 ? "wcs-cell-safe" : n <= 7 ? "wcs-cell-caution" : "wcs-cell-risky";
    }

    private async Task SetAsync(int n) {
        await WorkerCountChanged.InvokeAsync(SettingsModel.ClampWorkerCount(n));
    }

    private Task DismissWarningAsync() {
        return DismissWarning.InvokeAsync();
    }

}
