@implements IDisposable
@inject AppStateService AppStateSvc
@inject IPlatformCapabilities Platform
@inject IUpdateStatusProvider UpdateStatus

<div class="sidebar-footer-row">
    <span class="sidebar-footer-info">
        <span class="sidebar-footer-version">
            @if (!string.IsNullOrEmpty(AppStateSvc.AppVersion)) {
                <text>v@(AppStateSvc.AppVersion)</text>
            } else {
                <text>EggLedger</text>
            }
        </span>
        <span class="sidebar-footer-authors">
            by <a class="url-link" href="https://github.com/fanaticscripter" target="_blank" rel="noopener">@@mk2</a>
            &amp; <a class="url-link" href="https://github.com/DavidArthurCole" target="_blank" rel="noopener">@@DavidArthurCole</a>
        </span>
    </span>

    @if (UpdateAvailable) {
        <button type="button" class="sidebar-footer-badge" title="New version available" aria-label="New version available"
                @onclick="OpenUpdate">
            <span class="sidebar-footer-dot"></span>
        </button>
    }

    <span class="sidebar-footer-actions">
        <button type="button" class="sidebar-footer-btn" title="About" aria-label="About" @onclick="OnAbout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <line x1="12" y1="11" x2="12" y2="16"/>
                <line x1="12" y1="8" x2="12" y2="8.01"/>
            </svg>
        </button>
        <button type="button" class="sidebar-footer-btn" title="Terms" aria-label="Terms" @onclick="OnTerms">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 3 14 8 19 8"/>
                <line x1="9" y1="13" x2="15" y2="13"/>
                <line x1="9" y1="17" x2="15" y2="17"/>
            </svg>
        </button>
        <button type="button" class="sidebar-footer-btn" title="Privacy" aria-label="Privacy" @onclick="OnPrivacy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15" aria-hidden="true">
                <path d="M12 3l7 3v6c0 4.2-2.9 7.8-7 9-4.1-1.2-7-4.8-7-9V6z"/>
            </svg>
        </button>
        <button type="button" class="sidebar-footer-btn text-rose-500 hover:text-rose-400" title="Support the project" aria-label="Support the project" @onclick="OnSupport">
            <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15" aria-hidden="true">
                <path d="M12 21s-6.716-4.35-9.428-8.35C.86 9.9 1.5 6.5 4.2 5.3c1.9-.84 4.02-.16 5.3 1.36L12 9l2.5-2.34c1.28-1.52 3.4-2.2 5.3-1.36 2.7 1.2 3.34 4.6 1.628 7.35C18.716 16.65 12 21 12 21z"/>
            </svg>
        </button>
        <a class="sidebar-footer-btn" href="https://github.com/EggIncTools/EggLedger" target="_blank" rel="noopener"
           title="EggLedger on GitHub" aria-label="EggLedger on GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" width="15" height="15" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
        </a>
    </span>
</div>

<DesktopOnly>
    <UpdateModal @ref="_updateModal"/>
</DesktopOnly>

@code {
    [Parameter] public EventCallback OnAbout { get; set; }

    [Parameter] public EventCallback OnTerms { get; set; }

    [Parameter] public EventCallback OnPrivacy { get; set; }

    [Parameter] public EventCallback OnSupport { get; set; }

    private UpdateModal? _updateModal;

    private bool UpdateAvailable =>
        Platform.IsDesktop && !string.IsNullOrEmpty(UpdateStatus.AvailableVersion);

    protected override void OnInitialized() {
        AppStateSvc.Changed += OnStateChanged;
        if (Platform.IsDesktop) {
            UpdateStatus.Changed += OnStateChanged;
        }
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    private void OpenUpdate() {
        _updateModal?.Open();
    }

    public void Dispose() {
        AppStateSvc.Changed -= OnStateChanged;
        if (Platform.IsDesktop) {
            UpdateStatus.Changed -= OnStateChanged;
        }
    }

}
