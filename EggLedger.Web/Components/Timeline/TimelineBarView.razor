@using System.Globalization
@inject IUserTimeZoneProvider TzProvider

<div class="timeline-bar timeline-dur-@Bar.DurationIndex @CapModifierClass tooltip-host @(Bar.ContinuesLeft ? "timeline-bar-cut-l" : "") @(Bar.ContinuesRight ? "timeline-bar-cut-r" : "")" style="@BarStyle" data-tt-mode="cursor-x" @onclick="@(() => OnSelect.InvokeAsync(Bar.MissionId))">
    <div class="timeline-bar-track">
        <div class="timeline-bar-fill"></div>
    </div>
    @if (!Bar.ContinuesLeft) {
        <div class="timeline-bar-edge timeline-bar-edge-start">
            <span class="timeline-bar-edge-label">@FormatEdgeTime(Bar.Mission.LaunchDT)</span>
        </div>
    }
    @if (!Bar.ContinuesRight) {
        <div class="timeline-bar-edge timeline-bar-edge-end">
            <span class="timeline-bar-edge-label">@FormatEdgeTime(Bar.Mission.ReturnDT)</span>
        </div>
    }
    @if (Bar.ShowBubble) {
        <span class="timeline-bar-bubble tt-anchor">
            <img class="timeline-bar-ship" src="@Bar.ShipIconPath" alt="@Bar.ShipName"/>
            @if (Bar.TargetIconPath is not null) {
                <img class="timeline-bar-target" src="@Bar.TargetIconPath" alt=""/>
            }
        </span>
    }
    <div class="tooltip-floating tooltip-fixed text-sm">
        <span class="font-bold">@Bar.ShipName</span>
        <span class="timeline-dur-text-@Bar.DurationIndex">@Bar.Mission.DurationString</span><br/>
        <span class="text-gray-400">Launched:</span> @FormatTime(Bar.Mission.LaunchDT)<br/>
        <span class="text-gray-400">@(Bar.IsActive ? "Returns:" : "Returned:")</span> @FormatTime(Bar.Mission.ReturnDT)<br/>
        <span class="text-gray-400">Capacity:</span> @Bar.Mission.Capacity
        @if (!string.IsNullOrEmpty(Bar.Mission.Target) && Bar.Mission.Target != "UNKNOWN") {
            <br/>
            <span class="text-gray-400">Target: </span>
            @NameFormatting.TargetDisplayName(Bar.Mission.Target)
        }
        @if (!Bar.HasData) {
            <br/>
            <span class="text-gray-500 italic">Still flying, no drop data yet</span>
        }
    </div>
</div>

@code {
    [Parameter] public required TimelineBar Bar { get; set; }
    [Parameter] public bool RecolorDC { get; set; }
    [Parameter] public bool RecolorBC { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private string BarStyle =>
        FormattableString.Invariant($"--bar-start:{Bar.LeftPercent};--bar-size:{Bar.WidthPercent};--bar-fill:{Bar.FillPercent};--bar-z:{Bar.StackOrder};");

    private string CapModifierClass {
        get {
            if (RecolorBC && Bar.Mission.IsBuggedCap) {
                return "timeline-bar-buggedcap";
            }

            if (RecolorDC && Bar.Mission.IsDubCap) {
                return "timeline-bar-dubcap";
            }

            return "";
        }
    }

    private string FormatTime(long unixSeconds) {
        return TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds), TzProvider.TimeZone)
            .ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture);
    }

    private string FormatEdgeTime(long unixSeconds) {
        return TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds), TzProvider.TimeZone)
            .ToString("M/d h:mm tt", CultureInfo.InvariantCulture);
    }

}
