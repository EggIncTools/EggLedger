@using System.Globalization
@* Single-mode ship display: identity + details + capacity badge, then drops, then the footer tip. *@

<div class="ship-display @MultiClass">
    <div class="ship-display-head">
        <div class="ship-display-cap @CapClass">
            <img class="ship-display-cap-icon"
                 alt="@(Mission.IsBuggedCap ? "Skull Emoji" : "Artifact Crate")"
                 src="@(Mission.IsBuggedCap ? ContentPaths.Asset("images/skull.png") : ContentPaths.Asset("images/icon_afx_chest_2.png"))"/>
            <span class="ship-display-cap-text">
                @(Mission.IsBuggedCap
                    ? "0.6x Capacity"
                    : Data.CapacityModifier.ToString("0.##", CultureInfo.InvariantCulture) + "x Capacity")
            </span>
        </div>

        <div class="panel-muted ship-display-card ship-display-ident">
            @if (!string.IsNullOrEmpty(Mission.ShipEnumString)) {
                <img class="ship-display-ship-img" src="@ContentPaths.Asset($"images/ships/{Mission.ShipEnumString}.png")" alt="@Mission.ShipString"/>
            }
            <span class="@DurationClass">@Mission.ShipString</span>
            @if (Mission.Level > 0) {
                <span class="ship-display-stars text-goldenstar">@(new string('★', Mission.Level))</span>
            }
        </div>

        <div class="panel-muted ship-display-card ship-display-details">
            <div>Launched: @Format(Data.LaunchDT)</div>
            <div>Returned: @Format(Data.ReturnDT)</div>
            <div>Duration: @Data.DurationStr</div>
            <div>Capacity: @Mission.Capacity</div>
            @if (HasTarget) {
                <div class="ship-display-target">
                    <span>Sensor Target:</span>
                    <div class="ship-display-target-chip">@ProperCase(Mission.Target.Replace("_", " ", StringComparison.Ordinal))</div>
                </div>
            }
        </div>
    </div>

    <DropDisplayContainer Artifacts="Data.Artifacts"
                          Stones="Data.Stones"
                          Ingredients="Data.Ingredients"
                          StoneFragments="Data.StoneFragments"
                          MennoData="Data.MennoData"
                          ShowExpectedDrops="ShowExpectedDrops"/>

    @if (!IsMulti && !HideFooterTip) {
        <div class="ship-display-tip">
            Hover mouse over an item to show details.<br/>
            Click to open the relevant
            <a class="ledger-underline" target="_blank" rel="noopener" href="https://wasmegg-carpet.netlify.app/artifact-explorer/">artifact explorer</a>
            page.
        </div>
    }
</div>

@code {
    [Parameter] public ViewMissionData Data { get; set; } = new();
    [Parameter] public bool ShowExpectedDrops { get; set; }
    [Parameter] public bool IsMulti { get; set; }
    [Parameter] public bool HideFooterTip { get; set; }
    private DatabaseMission Mission => Data.MissionInfo;

    private string MultiClass => IsMulti ? "ship-display-multi" : "";

    private string CapClass =>
        Mission.IsBuggedCap ? "ship-display-cap-bugged" : Mission.IsDubCap ? "ship-display-cap-double" : "";

    private bool HasTarget =>
        Mission.Target.Length > 0 && !string.Equals(Mission.Target, "UNKNOWN", StringComparison.OrdinalIgnoreCase);

    private string DurationClass =>
        Mission.DurationType is { } d
            ? "text-duration-" + Convert.ToInt32(d, CultureInfo.InvariantCulture)
            : "text-duration-3";

    private static string Format(DateTime dt) {
        return dt.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
    }

    private static string ProperCase(string value) {
        return NameFormatting.ProperCase(value);
    }

}
