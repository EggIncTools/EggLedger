@using System.Globalization
@* One spec-type section: colored label "Label (totalCount)" then grouped drop icons.
   Each icon links to the artifact explorer and shows a hover tooltip (name, tier, rarity,
   count, effect string, and menno expected-drops when enabled). *@

@if (Items is { Count: > 0 }) {
    <div class="@LabelClass">
        @LabelText (@TotalCount)
    </div>
    <div class="drop-grid">
        @foreach (var item in Items) {
            <div class="drop-rep tooltip-host tooltip-trigger" style="@(ReferenceEquals(_hovered, item) ? $"--tt-anchor: --{_anchorId}" : null)">
                <a class="@RarityBgClass(item)" target="_blank" rel="noopener" href="@ExplorerUrl(item)"
                   @onmouseenter="@(() => ShowTooltip(item))" @onmouseleave="HideTooltip">
                    <img class="drop-img" loading="lazy" decoding="async" alt="@item.GameName" src="@SpecPath(item)"/>
                    @if (item.Count > 1) {
                        <span class="drop-count @NumToDigClass(item.Count)">@item.Count</span>
                    }
                </a>
                @if (ReferenceEquals(_hovered, item)) {
                    <div class="tooltip-floating tooltip-fixed tooltip-toggle drop-tt">
                        @item.GameName (T@(item.Level + SpecPathOffset(item)))
                        @if (item.SpecType == "Artifact") {
                            <span class="text-rarity-@item.Rarity">@FilterOptions.RarityWord(item.Rarity) </span>
                        }
                        × @item.Count
                        @if (item.SpecType is "Artifact" or "Stone") {
                            <br/>
                            var bound = BoundEffectString(item.EffectString);
                            <span>
                                @bound.Prefix<span class="drop-tt-num">@bound.Highlight</span>@bound.Suffix
                            </span>
                        }
                        @if (ShowPerShip && LifetimeMissionCount > 0) {
                            <hr class="drop-tt-rule"/>
                            var perShip = (double)item.Count / LifetimeMissionCount;
                            <span>
                                (<span class="drop-tt-num">@perShip.ToString("0.00000", CultureInfo.InvariantCulture)</span> per ship -
                                <span class="drop-tt-num">1</span> : <span class="drop-tt-num">@((1 / perShip).ToString("0.00", CultureInfo.InvariantCulture))</span>)
                            </span>
                        }
                        @if (LifetimeExpected) {
                            <hr class="drop-tt-rule"/>
                            var lifetimeCalc = DropCalcs(item);
                            @if (lifetimeCalc is null || lifetimeCalc.Value.Total == 0) {
                                <span class="drop-tt-err">Not enough data to determine drop rate.</span>
                            } else {
                                <span class="drop-tt-muted">
                                    <span class="drop-tt-num">@(((double)lifetimeCalc.Value.Seen / lifetimeCalc.Value.Total * MissionTotalDrops).ToString("0.00", CultureInfo.InvariantCulture))</span>
                                    <span> expected drops</span>
                                </span>
                            }
                        }
                        @if (ShowExpectedDrops) {
                            <hr class="drop-tt-rule"/>
                            var calc = DropCalcs(item);
                            @if (calc is null) {
                                <span class="drop-tt-err">Not enough data to determine drop rate.</span>
                            } else {
                                <span class="drop-tt-muted">
                                    <span class="drop-tt-num">@calc.Value.Seen.ToString("N0", CultureInfo.InvariantCulture)</span>
                                    <span> seen out of </span>
                                    <span class="drop-tt-num">@calc.Value.Total.ToString("N0", CultureInfo.InvariantCulture)</span>
                                    <span> drops</span><br/>
                                    <span>(Average of <span class="drop-tt-num">@ExpectedPerShip(item)</span> expected in this ship)</span>
                                </span>
                            }
                        }
                    </div>
                }
            </div>
        }
    </div>
    <br/>
}

@code {

    [Parameter] public string Type { get; set; } = "";

    [Parameter] public IReadOnlyList<DropLike>? Items { get; set; }
    [Parameter] public MissionMennoData? MennoData { get; set; }
    [Parameter] public bool ShowExpectedDrops { get; set; }

    [Parameter] public int MissionTotalDrops { get; set; }

    [Parameter] public int LifetimeMissionCount { get; set; }

    [Parameter] public bool ShowPerShip { get; set; }

    [Parameter] public bool LifetimeExpected { get; set; }

    private DropLike? _hovered;
    private readonly string _anchorId = "tt-" + Guid.NewGuid().ToString("N");

    private void ShowTooltip(DropLike item) {
        _hovered = item;
    }

    private void HideTooltip() {
        _hovered = null;
    }

    private int TotalCount {
        get {
            var sum = 0;
            if (Items is not null) {
                foreach (var i in Items) {
                    sum += i.Count;
                }
            }

            return sum;
        }
    }

    private string LabelText => Type switch {
        "artifact" => "Artifacts",
        "stone" => "Eggfinity Stones",
        "ingredient" => "Ingredients",
        "stone_fragment" => "Stone Fragments",
        _ => "Unknown"
    };

    private string LabelClass => "drop-label " + Type switch {
        "artifact" => "drop-label-artifact",
        "stone" => "drop-label-stone",
        "ingredient" or "stone_fragment" => "drop-label-ingredient",
        _ => "drop-label-unknown"
    };


    private static int SpecPathOffset(DropLike item) {
        return item.SpecType == "Stone" ? 2 : 1;
    }


    private static string RarityBgClass(DropLike item) {
        return item.SpecType == "Artifact" ? "drop-link bg-r-" + item.Rarity : "drop-link bg-r-0";
    }

    private static string ExplorerUrl(DropLike item) {
        var slug = item.Name
            .Replace("_FRAGMENT", "", StringComparison.Ordinal)
            .ToLowerInvariant()
            .Replace("_", "-", StringComparison.Ordinal);
        return $"https://wasmegg-carpet.netlify.app/artifact-explorer/#/artifact/{slug}-{item.Level + SpecPathOffset(item)}";
    }


    private static string NumToDigClass(int num) {
        return num switch {
            > 999999 => "drop-count-7",
            > 99999 => "drop-count-6",
            > 9999 => "drop-count-5",
            > 999 => "drop-count-4",
            > 99 => "drop-count-3",
            > 9 => "drop-count-2",
            _ => "drop-count-1"
        };
    }

    private static string SpecPath(DropLike item) {
        var fixedName = ArtifactNameFixups.ApplyDisplayNameOverrides(
            item.Name.Replace("_FRAGMENT", "", StringComparison.Ordinal));
        return ContentPaths.Asset($"images/artifacts/{fixedName}/{fixedName}_{item.Level + SpecPathOffset(item)}.png");
    }


    private static (string Prefix, string Highlight, string Suffix) BoundEffectString(string str) {
        if (str.StartsWith("!!", StringComparison.Ordinal)) {
            var open = str.IndexOf('<', StringComparison.Ordinal);
            var close = open >= 0 ? str.IndexOf('>', open) : -1;
            return close > open
                ? (str.Substring(2, open - 2), str.Substring(open + 1, close - open - 1), "")
                : ("?", "?", "?");
        }

        var lb = str.IndexOf('[', StringComparison.Ordinal);
        var rb = lb >= 0 ? str.IndexOf(']', lb) : -1;
        return rb > lb
            ? (str.Substring(0, lb), str.Substring(lb + 1, rb - lb - 1), str.Substring(rb + 1))
            : ("?", "?", "?");
    }


    private (long Seen, long Total)? DropCalcs(DropLike item) {
        if (MennoData?.Configs is null) {
            return null;
        }

        foreach (var c in MennoData.Configs) {
            var ac = c.ArtifactConfiguration;
            if (ac?.ArtifactType is null || ac.ArtifactRarity is null) {
                continue;
            }

            if (ac.ArtifactType.Id == item.Id && ac.ArtifactLevel == item.Level && ac.ArtifactRarity.Id == item.Rarity) {
                return (c.TotalDrops, MennoData.TotalDropsCount);
            }
        }

        return null;
    }


    private string ExpectedPerShip(DropLike item) {
        var calc = DropCalcs(item);
        if (calc is null || calc.Value.Total == 0) {
            return "";
        }

        var v = (double)calc.Value.Seen / calc.Value.Total * MissionTotalDrops;
        return v.ToString("0.000", CultureInfo.InvariantCulture);
    }

}
