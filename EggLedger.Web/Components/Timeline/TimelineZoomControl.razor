@using EggLedger.Web.Missions.Timeline

<div class="tile-group w-full">
    @foreach (var z in Zooms) {
        <button type="button" class="tile-group-item flex-1 @(Value == z ? "active" : "")" @onclick="@(() => OnValueChanged.InvokeAsync(z))">@z.Label()</button>
    }
</div>

@code {
    private static readonly TimelineZoom[] Zooms = [TimelineZoom.Day, TimelineZoom.Week, TimelineZoom.Month];

    [Parameter] public TimelineZoom Value { get; set; }
    [Parameter] public EventCallback<TimelineZoom> OnValueChanged { get; set; }
}
