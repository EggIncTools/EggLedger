@using System.Globalization
@* Horizontal bar chart (CSS-width bars), sortable by chart_type (bar_desc / bar_asc).
   Colors come from per-label overrides or the base color. *@

<div class="rbar">
    @foreach (var pair in SortedPairs()) {
        <span class="rbar-label" data-tt="@pair.Label">@pair.Label</span>
        <div class="rbar-track">
            <div class="rbar-fill"
                 style="--rbar-w: @BarWidth(pair.Value)%; --rbar-color: @BarColor(pair.Label);"
                 data-tt="@BarTitle(pair.Label, pair.Value)">
            </div>
        </div>
        <span class="rbar-value">@FormatValue(pair.Value)</span>
    }
    @if (!string.IsNullOrEmpty(UnitLabel)) {
        <div class="rbar-unit">@UnitLabel</div>
    }
</div>

@code {
    [Parameter] [EditorRequired] public ReportResult Result { get; set; } = new();
    [Parameter] [EditorRequired] public string Color { get; set; } = "#6366f1";
    [Parameter] public string? UnitLabel { get; set; }
    [Parameter] public string? LabelColors { get; set; }

    [Parameter] public string? ChartType { get; set; }

    private string UnitSuffix => string.IsNullOrEmpty(UnitLabel) ? "" : " " + UnitLabel;

    private IReadOnlyDictionary<string, string> ParsedColors =>
        SliceColors.ParseLabelColors(LabelColors);

    private List<double> DisplayValues() {
        return Result.IsFloat ? Result.FloatValues : Result.Values.Select(v => (double)v).ToList();
    }

    private double MaxVal() {
        return Math.Max(DisplayValues().DefaultIfEmpty(0).Max(), 1);
    }

    private List<(string Label, double Value)> SortedPairs() {
        var values = DisplayValues();
        var pairs = Result.Labels
            .Select((label, i) => (Label: label, Value: i < values.Count ? values[i] : 0))
            .ToList();
        return ChartType switch {
            "bar_desc" => pairs.OrderByDescending(p => p.Value).ToList(),
            "bar_asc" => pairs.OrderBy(p => p.Value).ToList(),
            _ => pairs
        };
    }

    private int BarWidth(double val) {
        return (int)Math.Round(val / MaxVal() * 100);
    }

    private string BarColor(string label) {
        return ParsedColors.TryGetValue(label, out var c) && !string.IsNullOrEmpty(c) ? c : Color;
    }

    private string BarTitle(string label, double value) {
        return $"{label}\n{FormatValue(value)}{UnitSuffix}";
    }

    private string FormatValue(double val) {
        return Result.IsFloat
            ? val.ToString("0.00", CultureInfo.InvariantCulture)
            : ((long)val).ToString(CultureInfo.InvariantCulture);
    }

}
