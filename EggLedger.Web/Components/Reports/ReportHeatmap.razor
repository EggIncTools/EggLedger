@* Heatmap table over a 2D result; HeatmapGeometry owns color, threshold suppression,
   and formatting. Axis drag-reorder deferred. Optional secondary-value sub-line and
   color-value override drive the Menno dual_value mode. *@

<div class="hmap">
    <table class="hmap-table">
        <thead>
        <tr>
            <th class="hmap-corner"></th>
            @foreach (var col in Result.ColLabels) {
                <th class="hmap-col" data-tt="@col">@col</th>
            }
        </tr>
        </thead>
        <tbody>
        @for (var r = 0; r < Result.RowLabels.Count; r++) {
            <tr>
                <td class="hmap-row" data-tt="@Result.RowLabels[r]">@Result.RowLabels[r]</td>
                @for (var c = 0; c < Result.ColLabels.Count; c++) {
                    var cell = Cell(r, c);
                    <td class="hmap-cell"
                        style="--hmap-bg: @cell.Style.BackgroundColor; --hmap-fg: @cell.Style.Color;"
                        data-tt="@($"{Result.RowLabels[r]}\n{Result.ColLabels[c]}: {cell.Display}")">
                        <div class="hmap-value">@cell.Display</div>
                        @if (SecondaryValues is not null) {
                            <div class="hmap-value hmap-secondary">@cell.Secondary</div>
                        }
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
</div>

@code {
    [Parameter] [EditorRequired] public ReportResult Result { get; set; } = new();
    [Parameter] [EditorRequired] public string Color { get; set; } = "#6366f1";
    [Parameter] public string? NormalizeBy { get; set; }
    [Parameter] public string? UnfilledColor { get; set; }
    [Parameter] public int MinSampleSize { get; set; }

    [Parameter] public IReadOnlyList<double>? SecondaryValues { get; set; }

    [Parameter] public IReadOnlyList<double>? ColorValues { get; set; }

    private double GlobalMax() {
        return Result.MatrixValues.DefaultIfEmpty(0).Max();
    }

    private (HeatmapCellStyle Style, string Display, string Secondary) Cell(int r, int c) {
        var nCols = Result.ColLabels.Count;
        var flat = r * nCols + c;
        var v = flat < Result.MatrixValues.Count ? Result.MatrixValues[flat] : 0;
        int? missionCount = Result.MissionCountMatrix is { } mc && flat < mc.Count ? (int)mc[flat] : null;
        var below = HeatmapGeometry.IsBelowThreshold(missionCount, MinSampleSize);
        double? colorValue = ColorValues is { } cv && flat < cv.Count ? cv[flat] : null;

        var style = HeatmapGeometry.CellStyle(
            v, GlobalMax(), Color, UnfilledColor ?? "#1f2937", NormalizeBy, colorValue, below);
        var display = HeatmapGeometry.DisplayValue(v, NormalizeBy, below);
        var secondary = "";
        if (SecondaryValues is { } sv) {
            var s = flat < sv.Count ? sv[flat] : 0;
            secondary = HeatmapGeometry.SecondaryDisplayValue(s, NormalizeBy, below);
        }

        return (style, display, secondary);
    }

}
