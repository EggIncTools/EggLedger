@using EggIdentity.Reports
@inject IReportRunner Runner
@inject MennoService Menno
@inject IndexedDbReportStore Store
@inject IDownloadService Downloader
@inject ILogger<ReportCard> Logger

<div class="rc-wrap">
    <EggIdentity.UI.Reports.ReportCard Definition="Report.Definition" Cube="_cube" Source="_source"
                                        Error="@_error" Loading="@(_cube is null && _error is null)">
        <Actions>
            @if (EditMode) {
                @if (Groups.Count > 0) {
                    <select class="rc-group" value="@(Report.Placement.Group ?? "")" @onchange="OnGroupSelectChanged">
                        <option value="">No group</option>
                        @foreach (var g in Groups) {
                            <option value="@g.Id">@g.Name</option>
                        }
                    </select>
                }
                <button type="button" class="rc-link" disabled="@(_copying || _deleting)" @onclick="CopyAsync">
                    @(_copying ? "Copying..." : "Copy")
                </button>
                <button type="button" class="rc-link rc-link-accent"
                        disabled="@(_copying || _deleting)" @onclick="() => OnEdit.InvokeAsync(Report)">
                    Edit
                </button>
                @if (_confirmingDelete) {
                    <span class="rc-err">Delete?</span>
                    <button type="button" class="rc-link" @onclick="() => _confirmingDelete = false">Cancel</button>
                    <button type="button" class="rc-link rc-link-danger rc-link-strong"
                            disabled="@_deleting" @onclick="DeleteAsync">
                        @(_deleting ? "Deleting..." : "Yes")
                    </button>
                } else {
                    <button type="button" class="rc-link rc-link-danger"
                            disabled="@(_copying || _deleting)" @onclick="() => _confirmingDelete = true">
                        &#10005;
                    </button>
                }
            } else {
                @if (ShowUnpin) {
                    <button type="button" class="rc-chip rc-chip-danger" @onclick="() => OnUnpin.InvokeAsync()">
                        Unpin
                    </button>
                }
                <button type="button" class="rc-chip" disabled="@(_cube is null)" @onclick="ExportAsync">Export</button>
            }
        </Actions>
    </EggIdentity.UI.Reports.ReportCard>

    @if (MennoComparison.ShouldRender(Report.Definition, _userMatrix, _menno)) {
        <table class="rc-menno">
            <caption>Menno</caption>
            <thead>
                <tr>
                    <th></th>
                    @foreach (var c in MennoColLabels) {
                        <th>@c</th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (var r = 0; r < MennoRowLabels.Count; r++) {
                    var row = r;
                    <tr>
                        <th>@MennoRowLabels[row]</th>
                        @for (var c = 0; c < MennoColLabels.Count; c++) {
                            var col = c;
                            <td>@FormatCell(MennoCells?[row][col])</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter, EditorRequired] public LedgerReport Report { get; set; } = null!;
    [Parameter, EditorRequired] public string AccountId { get; set; } = "";
    [Parameter] public bool EditMode { get; set; }
    [Parameter] public IReadOnlyList<ReportGroupRow> Groups { get; set; } = [];
    [Parameter] public EventCallback<LedgerReport> OnEdit { get; set; }
    [Parameter] public EventCallback<LedgerReport> OnDelete { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }
    [Parameter] public bool ShowUnpin { get; set; }
    [Parameter] public EventCallback OnUnpin { get; set; }

    private ReportCube? _cube;
    private IReportSource? _source;
    private ReportMatrix? _userMatrix;
    private ReportMatrix? _menno;
    private string? _error;
    private ReportDefinition? _lastDefinition;
    private bool _confirmingDelete;
    private bool _copying;
    private bool _deleting;

    private bool RatioMode => MennoComparison.CompareMode(Report.Definition) == MennoComparison.Ratio;

    private IReadOnlyList<string> MennoRowLabels => (RatioMode ? _userMatrix : _menno)?.RowLabels ?? [];
    private IReadOnlyList<string> MennoColLabels => (RatioMode ? _userMatrix : _menno)?.ColLabels ?? [];

    private IReadOnlyList<IReadOnlyList<double?>>? MennoCells =>
        _menno is null ? null :
        RatioMode ? MennoComparison.RatioCells(_userMatrix!, _menno) : _menno.Cells;

    private static string FormatCell(double? value) => value?.ToString("0.##") ?? "-";

    private async Task OnGroupSelectChanged(ChangeEventArgs e) {
        var groupId = e.Value?.ToString() ?? "";
        await Store.SetReportGroupAsync(Report.Id, groupId);
        await OnChanged.InvokeAsync();
    }

    private async Task CopyAsync() {
        _copying = true;
        try {
            var newId = Guid.NewGuid().ToString("D");
            var copy = Report with {
                Definition = Report.Definition with { Id = newId, Title = Report.Definition.Title + " (copy)" },
                Placement = Report.Placement with { ReportId = newId },
            };
            await Store.InsertReportAsync(ReportMapping.ToRow(copy, await Store.RetrieveReportAsync(Report.Id)));
            await OnChanged.InvokeAsync();
        } finally {
            _copying = false;
        }
    }

    private async Task DeleteAsync() {
        _deleting = true;
        try {
            await Store.DeleteReportAsync(Report.Id);
            await OnDelete.InvokeAsync(Report);
            await OnChanged.InvokeAsync();
        } finally {
            _deleting = false;
            _confirmingDelete = false;
        }
    }

    private async Task ExportAsync() {
        var json = ReportCodec.Serialize(Report.Definition);
        await Downloader.DownloadJsonAsync(json, SafeFileName(Report.Definition.Title) + ".json");
    }

    private static string SafeFileName(string name) {
        var invalid = Path.GetInvalidFileNameChars();
        var chars = name.Select(c => invalid.Contains(c) ? '_' : c).ToArray();
        var cleaned = new string(chars).Trim();
        return cleaned.Length == 0 ? "report" : cleaned;
    }

    protected override async Task OnParametersSetAsync() {
        if (Report.Definition == _lastDefinition) return;

        _lastDefinition = Report.Definition;
        await RunAsync();
    }

    private async Task RunAsync() {
        _cube = null;
        _menno = null;
        _userMatrix = null;
        _error = null;
        _source = LedgerReportSources.All.FirstOrDefault(s => s.Id == Report.Definition.Query.Source);

        try {
            _cube = await Runner.RunReportAsync(Report.Definition.Query, AccountId);
        } catch (Exception ex) {
            _error = "Failed to run: " + ex.Message;
            Logger.LogDebug(ex, "report run failed");
            StateHasChanged();
            return;
        }

        StateHasChanged();
        await RunMennoComparisonAsync();
    }

    private async Task RunMennoComparisonAsync() {
        if (_cube is null
            || !MennoComparison.Enabled(Report.Definition)
            || Report.Definition.View.Chart != ReportCharts.Heatmap) {
            return;
        }

        try {
            await Menno.EnsureLoadedAsync();

            var groupBy = Report.Definition.Query.GroupBy;
            var measureKey = Report.Definition.Query.Measures.Count > 0
                ? Report.Definition.Query.Measures[0].Key
                : MeasureRequest.RowCountKey;

            _userMatrix = ReportProjection.Matrix(_cube, measureKey, groupBy[0].Dimension, groupBy[1].Dimension, _source);
            _menno = MennoService.ExecuteComparison(Report.Definition, Menno.CachedItems ?? [], _userMatrix);
            StateHasChanged();
        } catch (Exception ex) {
            Logger.LogDebug(ex, "menno comparison for report failed");
            _menno = null;
            _userMatrix = null;
        }
    }
}
