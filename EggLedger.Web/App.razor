<Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(FaultNotFound)">
    <Found Context="routeData">
        <CircuitGuard Name="Root" Scope="FaultScope.Page">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
        </CircuitGuard>
        <FocusOnNavigate RouteData="@routeData" Selector="h1"/>
    </Found>
</Router>
