@implements IDisposable
@inject ReportsViewState State

@if (State.AccountId is null) {
    <p class="text-xs text-gray-500 italic">Select an account to manage reports.</p>
} else {
    <div class="flex flex-col gap-3">
        <div>
            <span class="font-bold text-gray-400">Groups</span>
            <div class="flex flex-col gap-1.5 mt-1">
                @if (State.ShowNewGroup) {
                    <input class="rb-control" type="text" placeholder="Group name" @bind="State.NewGroupName"
                           @bind:event="oninput" @onkeydown="GroupKeyDown"/>
                    <div class="flex gap-1.5">
                        <button type="button" class="rb-control flex-1" @onclick="State.CreateGroupAsync">Add</button>
                        <button type="button" class="rb-control flex-1" @onclick="State.CancelNewGroup">Cancel</button>
                    </div>
                } else {
                    <button type="button" class="rb-control text-left" @onclick="State.BeginNewGroup">+ Group</button>
                }
                <button type="button" class="rb-control text-left @(State.EditMode ? "text-indigo-400" : "")" @onclick="State.ToggleEditMode">
                    @(State.EditMode ? "Done Editing" : "Edit Groups")
                </button>
            </div>
        </div>
    </div>
}

@code {

    protected override async Task OnInitializedAsync() {
        State.Changed += OnStateChanged;
        await State.EnsureInitializedAsync(InvokeAsync);
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    private async Task GroupKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            await State.CreateGroupAsync();
        } else if (e.Key == "Escape") {
            State.CancelNewGroup();
        }
    }

    public void Dispose() {
        State.Changed -= OnStateChanged;
    }

}
