@foreach (var run in _runs) {
    @switch (run.Kind) {
        case LogRunKind.Image:
            <img src="@ContentPaths.Asset("images/" + run.Text)" alt="" class="logline-img"/>
            break;
        case LogRunKind.EidBar:
            <span class="logline-eid"></span>
            break;
        default:
            if (run.Color is { } color) {
                <span class="logline-colored" style="--logline-color: @color">@run.Text</span>
            } else {
                <span class="@(IsError ? "logline-err" : "logline-text")">@run.Text</span>
            }
            break;
    }
}
