@implements IDisposable
@inject LedgerShellState Shell

<div class="options-host">
    <div class="options-host-body">
        <CircuitGuard Name="Options" Scope="FaultScope.Panel">
            @if (Shell.View == LedgerView.Drops) {
                <DropsOptionsPanel/>
            } else if (Shell.View != LedgerView.Reports) {
                <ShipsOptionsPanel/>
            }
        </CircuitGuard>
    </div>
</div>

@code {

    protected override void OnInitialized() {
        Shell.Changed += OnShellChanged;
    }

    private void OnShellChanged() {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        Shell.Changed -= OnShellChanged;
    }

}
