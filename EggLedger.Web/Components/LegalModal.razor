<ModalOverlay @ref="_modal" OnClose="Close"
              ContainerClass="w-[92vw] max-w-[60rem] max-h-[88vh] flex flex-col border border-gray-600 rounded-lg bg-darker text-gray-300 shadow-2xl">
    <div class="flex items-center justify-between shrink-0 px-4 py-3 border-b border-gray-700">
        <h2 class="text-sm font-bold text-gray-300">@Title</h2>
        <CloseButton OnClick="Close" Class="text-gray-500 hover:text-gray-300" IconClass="w-4 h-4"/>
    </div>

    <div class="legal-page flex-1 min-h-0 overflow-y-auto px-6 py-5">
        <div class="prose-legal">
            @if (Kind == LegalDocument.Terms) {
                <TermsContent OnCrossLink="OnKindChange"/>
            } else {
                <PrivacyContent OnCrossLink="OnKindChange"/>
            }
        </div>
    </div>
</ModalOverlay>

@code {
    [Parameter] [EditorRequired] public LegalDocument Kind { get; set; }

    [Parameter] public EventCallback<LegalDocument> OnKindChange { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private ModalOverlay? _modal;

    private string Title => Kind == LegalDocument.Terms ? "Terms of Service" : "Privacy & Cookies";

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender) {
            _modal?.Open();
        }
    }

    private Task Close() {
        return OnClose.InvokeAsync();
    }

}
