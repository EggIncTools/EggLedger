@inject IndexedDbReportStore Store
@inject IDownloadService Downloader
@inject ReportsViewState State
@inject TimeProvider Time
@inject ILogger<ReportGrid> Logger
@using System.Text.Json
@using System.Text.Json.Nodes
@using EggIdentity.Reports
@using EggLedger.Web.Settings
@implements IDisposable

<div class="rgrid">
    @if (!string.IsNullOrEmpty(_actionMessage)) {
        <span class="rgrid-msg @(_actionMessageIsError ? "rgrid-msg-err" : "")">@_actionMessage</span>
    }
    @if (_reports.Count == 0) {
        <div class="rgrid-empty">No reports yet. Click "New Report" to create one.</div>
    } else {
        <EggIdentity.UI.Reports.ReportGrid Placements="@_placements" Editable="@EditMode" PlacementsChanged="OnPlacementsChangedAsync">
            <Item Context="placement">
                <ReportCard Report="@_byId[placement.ReportId]" AccountId="@AccountId" EditMode="@EditMode" Groups="@Groups"
                            OnEdit="@OnEdit" OnChanged="ReloadAsync"/>
            </Item>
        </EggIdentity.UI.Reports.ReportGrid>
    }
</div>

@code {
    [Parameter] [EditorRequired] public string AccountId { get; set; } = "";

    [Parameter] public string? GroupFilter { get; set; }

    [Parameter] public bool EditMode { get; set; }
    [Parameter] public IReadOnlyList<ReportGroupRow> Groups { get; set; } = [];
    [Parameter] public EventCallback<LedgerReport> OnEdit { get; set; }
    private List<LedgerReport> _reports = [];
    private List<ReportPlacement> _placements = [];
    private Dictionary<string, LedgerReport> _byId = [];
    private string? _actionMessage;
    private bool _actionMessageIsError;

    protected override void OnInitialized() {
        State.Changed += OnStateChanged;
    }

    protected override async Task OnParametersSetAsync() {
        if (string.IsNullOrEmpty(AccountId)) {
            RecomputeReports([]);
            return;
        }

        await State.EnsureAccountLoadedAsync();
        RecomputeReports(State.Reports);
    }

    private void OnStateChanged() {
        InvokeAsync(() => {
            RecomputeReports(State.Reports);
            StateHasChanged();
        });
    }

    private void RecomputeReports(IReadOnlyList<LedgerReport> source) {
        var filtered = GroupFilter is null ? source : source.Where(r => r.Placement.Group == GroupFilter);
        _reports = [.. filtered];
        _placements = [.. _reports.Select(r => r.Placement with { Group = null })];
        _byId = _reports.ToDictionary(r => r.Id);
    }

    public Task ReloadAsync() => State.LoadReportsAsync();

    private async Task OnPlacementsChangedAsync(IReadOnlyList<ReportPlacement> changed) {
        foreach (var placement in changed) {
            var row = await Store.RetrieveReportAsync(placement.ReportId);
            if (row is null) continue;
            await Store.UpdateReportAsync(ReportMapping.WithPlacement(row, placement with { Group = string.IsNullOrEmpty(row.GroupId) ? null : row.GroupId }));
        }

        await State.LoadReportsAsync();
    }

    public async Task ExportAllAsync() {
        var rows = await Store.RetrieveAccountReportsAsync(AccountId);
        var groups = await Store.RetrieveAccountGroupsAsync(AccountId);
        var blob = CloudReportsBlob.Pack(rows, groups, Logger);
        var json = JsonSerializer.Serialize(blob, new JsonSerializerOptions { WriteIndented = true });
        await Downloader.DownloadJsonAsync(json, $"reports-export-{Time.GetUtcNow():yyyyMMdd-HHmmss}.json");
        _actionMessage = $"Exported {rows.Count} report(s)";
        _actionMessageIsError = false;
        StateHasChanged();
        ClearMessageLater();
    }

    public async Task ImportAsync(string json) {
        if (string.IsNullOrWhiteSpace(json)) return;

        try {
            var blob = ParseImportedBlob(json);
            int count = 0;
            foreach (var r in blob.Unpack(Logger)) {
                var newId = Guid.NewGuid().ToString("D");
                var report = r with {
                    AccountId = AccountId,
                    Definition = r.Definition with { Id = newId },
                    Placement = r.Placement with { ReportId = newId },
                };
                await Store.InsertReportAsync(ReportMapping.ToRow(report));
                count++;
            }

            _actionMessage = $"Imported {count} report(s)";
            _actionMessageIsError = false;
        } catch (JsonException) {
            _actionMessage = "Import failed - invalid file";
            _actionMessageIsError = true;
        }

        await ReloadAsync();
        ClearMessageLater();
    }

    private static CloudReportsBlob ParseImportedBlob(string json) {
        var trimmed = json.TrimStart();
        if (trimmed.StartsWith('[')) {
            var array = JsonSerializer.Deserialize<List<JsonObject>>(json) ?? [];
            return new CloudReportsBlob { Reports = array };
        }

        return JsonSerializer.Deserialize<CloudReportsBlob>(json) ?? new CloudReportsBlob();
    }

    private void ClearMessageLater() =>
        _ = ClearMessageLaterAsync();

    private async Task ClearMessageLaterAsync() {
        await Task.Delay(5000);
        _actionMessage = null;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() =>
        State.Changed -= OnStateChanged;

}
