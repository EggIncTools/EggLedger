@using EggIdentity.UI.Canvas
@using EggLedger.Web.Components.Cards

<div class="@RootClass" data-missionid="@Data.Mission.MissiondId">
    @if (!Embedded && MultiViewMode == MultiViewMode.Free) {
        <input type="checkbox" class="mc-check"
               checked="@IsSelected"
               @onclick="@(e => OnToggleSelected.InvokeAsync((Data.Mission.MissiondId, e.ShiftKey)))"/>
    }
    @if (Embedded) {
        @Canvas
    } else {
        <button type="button" class="mc-btn" @onclick="@(() => OnView.InvokeAsync(Data.Mission.MissiondId))">
            @Canvas
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public required CardTemplate Template { get; set; }
    [Parameter, EditorRequired] public required MissionCardData Data { get; set; }
    [Parameter] public bool Embedded { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public bool IsBeingViewed { get; set; }
    [Parameter] public MultiViewMode MultiViewMode { get; set; }
    [Parameter] public bool RecolorDC { get; set; }
    [Parameter] public bool RecolorBC { get; set; }
    [Parameter] public EventCallback<string> OnView { get; set; }
    [Parameter] public EventCallback<(string MissionId, bool Shift)> OnToggleSelected { get; set; }

    private RenderFragment Canvas => __builder => {
        <CanvasView Doc="Template.Doc" Class="mc-canvas">
            <ItemBody Context="item">
                <CardElement Item="item" Data="Data" Colorize="Template.ColorizeByDuration"/>
            </ItemBody>
        </CanvasView>
    };

    private string CustomClass =>
        string.IsNullOrEmpty(Template.CustomCss) ? "" : "mission-card-custom-" + CustomCssSanitizer.SlugFor(Template.Name);

    private string RootClass {
        get {
            var classes = "mc";
            if (Embedded) classes += " mc-embedded";
            if (IsBeingViewed) classes += " mc-viewed";
            if (RecolorDC && Data.Mission.IsDubCap) classes += " mc-dubcap";
            if (RecolorBC && Data.Mission.IsBuggedCap) classes += " mc-buggedcap";
            if (!string.IsNullOrEmpty(CustomClass)) classes += " " + CustomClass;
            return classes;
        }
    }
}
