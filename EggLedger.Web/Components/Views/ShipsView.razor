@implements IDisposable
@implements IShipsViewActions
@inject ShipsViewState State

@if (State.AccountId is null) {
    <NoAccountState/>
} else if (State.Loading && State.AllMissions is null) {
    <div class="ships-skeleton" aria-busy="true" aria-label="Loading missions">
        <div class="ships-skeleton-controls">
            <span class="skel skel-tile"></span>
            <span class="skel skel-tile skel-tile-wide"></span>
            <span class="skel skel-tile"></span>
        </div>
        @for (var i = 0; i < 10; i++) {
            <div class="ships-skeleton-row">
                <span class="skel skel-date"></span>
                <span class="skel skel-name"></span>
                <span class="skel skel-stars"></span>
            </div>
        }
    </div>
} else if (State.AllMissions is null || State.AllMissions.Count == 0) {
    <NoDataFallback/>
} else {
    <div class="ships-ready">
    @if (State.ViewMode == ShipsViewMode.Calendar) {
        <MissionCalendarView Missions="State.TabFiltered ?? Array.Empty<DatabaseMission>()"
                             InFlightMissions="@State.TabFilteredInFlight"
                             AllMissions="State.TabFilteredAll ?? Array.Empty<DatabaseMission>()"
                             HasActiveFilter="State.HasActiveFilter"
                             RecolorDC="State.Opts.RecolorDC"
                             RecolorBC="State.Opts.RecolorBC"
                             ShowEvents="State.Opts.CalendarEvents"
                             HiddenEventTypes="State.Opts.CalendarHiddenEventTypes"
                             MinEventChance="State.Opts.CalendarMinChance"
                             Templates="State.CardTemplates"
                             DataFor="State.DataFor"
                             OnViewMission="ViewMissionAsync"
                             LeadingControls="CalendarLeadingControls"/>
    } else {
        <div class="ships-controls">
            @RenderModeTiles()
            @if (State.HasBothTypes) {
                @RenderTileSelector()
            }
            @RenderListControlSet()
        </div>
        <MissionResultsTable Grouping="State.Grouping"
                             ViewByDate="State.Opts.ViewByDate"
                             MultiViewMode="State.Opts.MultiViewMode"
                             RecolorDC="State.Opts.RecolorDC"
                             RecolorBC="State.Opts.RecolorBC"
                             Template="State.CardTemplates.For(CardSlot.List)"
                             DataFor="State.DataFor"
                             Columns="3"
                             SelectedIds="State.MultiSelectedIds"
                             TabFiltered="State.TabFiltered ?? Array.Empty<DatabaseMission>()"
                             MissionBeingViewed="State.MissionBeingViewed"
                             FlatMissions="State.FlatSorted"
                             OnViewMission="ViewMissionAsync"
                             OnViewRow="ViewRowAsync"
                             OnSelectionChanged="StateHasChanged"
                             OnGroupingChanged="StateHasChanged"/>
    }

    <MissionOverlay @ref="_overlay"
                    AccountId="@State.AccountId"
                    FilteredMissions="State.FlatSorted ?? State.TabFiltered ?? Array.Empty<DatabaseMission>()"
                    SortMethod="State.Opts.SortMethod"
                    ShowExpectedDrops="true"/>

    <Disclosure Label="Reports" @bind-Open="_widgetsOpen" Class="ledger-section ledger-section-inset">
        @if (State.AccountId is { } accountId) {
            <PinnedReportsStrip AccountId="@accountId" View="@PinnedReportViews.Missions"/>
        }
    </Disclosure>
    </div>
}

@code {
    private static readonly IReadOnlyList<SegmentedOption<ShipsViewMode>> ModeTiles = [
        new(ShipsViewMode.List, "List"),
        new(ShipsViewMode.Calendar, "Calendar")
    ];

    private MissionOverlay? _overlay;
    private bool _widgetsOpen = true;

    protected override void OnInitialized() {
        State.Changed += OnStateChanged;
        State.Actions = this;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        await Task.Yield();
        await State.EnsureInitializedAsync(InvokeAsync);
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    private void SetViewMode(ShipsViewMode mode) {
        State.SetViewMode(mode);
    }

    private void SelectTab(int? tab) {
        State.SelectTab(tab);
    }

    private RenderFragment RenderModeTiles() => __builder => {
        <Segmented T="ShipsViewMode" Options="ModeTiles" Selected="State.ViewMode" SelectedChanged="SetViewMode" AriaLabel="Mission view"/>
    };

    private RenderFragment CalendarLeadingControls => __builder => {
        @RenderModeTiles()
        @if (State.HasBothTypes) {
            @RenderTileSelector()
        }
    };

    private IReadOnlyList<SegmentedOption<int?>> TypeTiles() => [
        new(null, "All", State.Filtered?.Count ?? 0),
        new(0, "Home", State.CountOfType(0)),
        new(1, "Virtue", State.CountOfType(1))
    ];

    private RenderFragment RenderTileSelector() => __builder => {
        <Segmented T="int?" Options="TypeTiles()" Selected="State.Opts.MissionTypeTab" SelectedChanged="SelectTab" AriaLabel="Mission type"/>
    };

    private IReadOnlyList<SegmentedOption<MultiViewMode>> MultiTiles() => [
        new(MultiViewMode.Off, "Off", Title: "Multi-select off"),
        new(MultiViewMode.Row, "Row/Date",
            Title: State.Opts.SortByDropCount ? "Row/Date select is unavailable while sorting by drop count" : "Select a whole row or date",
            Disabled: State.Opts.SortByDropCount),
        new(MultiViewMode.Free, "Free", Title: "Select missions one by one")
    ];

    private bool AllMultiSelected =>
        (State.TabFiltered?.Count ?? 0) > 0 && State.MultiSelectedIds.Count >= (State.TabFiltered?.Count ?? 0);

    private RenderFragment RenderListControlSet() => __builder => {
        <div class="list-control-set">
            <Segmented T="MultiViewMode" Options="MultiTiles()" Selected="State.Opts.MultiViewMode" SelectedChanged="State.SetMultiViewAsync" AriaLabel="Multi-select"/>
            @if (State.Opts.MultiViewMode == MultiViewMode.Free) {
                <div class="list-control-actions">
                    <button type="button" class="list-control-action-btn" disabled="@(State.MultiSelectedIds.Count == 0)" @onclick="ViewSelectedMultiAsync">
                        View Selected (@State.MultiSelectedIds.Count)
                    </button>
                    @if (State.MultiSelectedIds.Count > 0) {
                        <button type="button" class="list-control-action-btn" @onclick="DeselectAllMulti">Deselect All</button>
                    }
                    @if (!AllMultiSelected) {
                        <button type="button" class="list-control-action-btn" @onclick="SelectAllMulti">Select All</button>
                    }
                </div>
            }
        </div>
    };

    private async Task ViewSelectedMultiAsync() {
        var ids = (State.TabFiltered ?? Array.Empty<DatabaseMission>())
            .Select(m => m.MissiondId)
            .Where(State.MultiSelectedIds.Contains)
            .ToList();
        await ViewRowAsync(ids);
    }

    private void SelectAllMulti() {
        foreach (var m in State.TabFiltered ?? Array.Empty<DatabaseMission>()) State.MultiSelectedIds.Add(m.MissiondId);
    }

    private void DeselectAllMulti() {
        State.MultiSelectedIds.Clear();
    }

    public async Task ResortAsync(MissionSortMethod method) {
        if (_overlay is not null) await _overlay.ReSortAsync(method);
    }

    private async Task ViewMissionAsync(string missionId) {
        State.SetMissionBeingViewed(missionId);
        if (_overlay is not null) await _overlay.OpenAsync(missionId);
    }

    private async Task ViewRowAsync(IReadOnlyList<string> missionIds) {
        if (missionIds.Count == 0 || _overlay is null) return;

        if (missionIds.Count == 1) {
            await ViewMissionAsync(missionIds[0]);
            return;
        }

        State.SetMissionBeingViewed(null);
        await _overlay.OpenMultiAsync(missionIds);
    }

    public void Dispose() {
        State.Changed -= OnStateChanged;
        if (ReferenceEquals(State.Actions, this)) State.Actions = null;
    }

}
