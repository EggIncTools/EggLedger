@using EggIdentity.UI
<div class="mcc-size">
<ModalHost Open="_open" OnClose="Close" Title="Mission Card Layout" Width="ModalWidth.Custom">
    <div class="mcc">
        <div class="mcc-form">
            <div class="panel-muted mcc-box">
                <span class="mcc-heading">Preset</span>
                <TileGroup TValue="string" Options="PresetTiles()" Selected="_editingPresetName" OnSelect="SwitchTo" Wrap="true"/>
                <div class="mcc-actions">
                    <button type="button" class="toggle-link mcc-link" @onclick="@(() => BeginNaming(NameAction.SaveAsNew))">Save as new</button>
                    <button type="button" class="toggle-link mcc-link" @onclick="@(() => BeginNaming(NameAction.Duplicate))">Duplicate</button>
                    <button type="button" class="toggle-link mcc-link" disabled="@IsClassic" @onclick="@(() => BeginNaming(NameAction.Rename))">Rename</button>
                    <button type="button" class="toggle-link mcc-link" disabled="@IsClassic" @onclick="Delete">Delete</button>
                </div>
                @if (_pendingNameAction is not null) {
                    <div class="mcc-naming">
                        <input class="mcc-input" @bind="_pendingNameInput" @bind:event="oninput" placeholder="Preset name"/>
                        <button type="button" class="toggle-link mcc-link" @onclick="ConfirmNaming" disabled="@(!CanConfirmNaming)">Confirm</button>
                        <button type="button" class="toggle-link mcc-link" @onclick="@(() => _pendingNameAction = null)">Cancel</button>
                        @if (_nameError is not null) {
                            <span class="mcc-error">@_nameError</span>
                        }
                    </div>
                }
            </div>

            <div class="panel-muted mcc-box">
                <span class="mcc-heading">Layout</span>
                <TileGroup TValue="CardLayout" Options="LayoutTiles" Selected="_form.Layout" OnSelect="SetLayout"/>
            </div>

            <div class="panel-muted mcc-box">
                <span class="mcc-heading">Fields</span>
                <div class="mcc-fields">
                    @foreach (var slot in _form.Fields.OrderBy(f => f.Order)) {
                        <div class="mcc-field">
                            <input type="checkbox" checked="@slot.Enabled" @onchange="@(e => SetFieldEnabled(slot, e))"/>
                            <span class="mcc-field-name">@slot.Field</span>
                            <button type="button" class="mcc-move" disabled="@IsFirst(slot)" @onclick="@(() => MoveField(slot, -1))" aria-label="Move up">&uarr;</button>
                            <button type="button" class="mcc-move" disabled="@IsLast(slot)" @onclick="@(() => MoveField(slot, 1))" aria-label="Move down">&darr;</button>
                        </div>
                    }
                </div>
            </div>

            <div class="panel-muted mcc-box mcc-checks">
                <label class="mcc-check">
                    <input type="checkbox" @bind="_form.ColorizeByDuration"/> Colorize by duration
                </label>
                <label class="mcc-check">
                    <input type="checkbox" @bind="_form.ShowExpectedDropsPerShip"/> Show expected drops per ship
                </label>
            </div>

            <div class="panel-muted mcc-box">
                <span class="mcc-heading">Colors</span>
                <div class="mcc-colors">
                    <div class="mcc-color">
                        <span class="mcc-color-label">Background</span>
                        <ColorPicker Value="@(_form.BackgroundColor ?? ColorPickerMath.Fallback)" ValueChanged="@(v => _form.BackgroundColor = v)"/>
                        <button type="button" class="toggle-link mcc-link" @onclick="@(() => _form.BackgroundColor = null)">Reset</button>
                    </div>
                    <div class="mcc-color">
                        <span class="mcc-color-label">Border</span>
                        <ColorPicker Value="@(_form.BorderColor ?? ColorPickerMath.Fallback)" ValueChanged="@(v => _form.BorderColor = v)"/>
                        <button type="button" class="toggle-link mcc-link" @onclick="@(() => _form.BorderColor = null)">Reset</button>
                    </div>
                    <div class="mcc-color">
                        <span class="mcc-color-label">Accent</span>
                        <ColorPicker Value="@(_form.AccentColor ?? ColorPickerMath.Fallback)" ValueChanged="@(v => _form.AccentColor = v)"/>
                        <button type="button" class="toggle-link mcc-link" @onclick="@(() => _form.AccentColor = null)">Reset</button>
                    </div>
                </div>
            </div>

            <div class="panel-muted mcc-box">
                <label class="mcc-css-label">
                    Custom CSS
                    <textarea class="mcc-input mcc-css" rows="6" @bind="_form.CustomCss" @bind:event="oninput"></textarea>
                </label>
                <div class="mcc-css-foot">
                    <span class="mcc-css-count">@(_form.CustomCss?.Length ?? 0) / 20000</span>
                    @if (_cssError is not null) {
                        <span class="mcc-error">@_cssError</span>
                    }
                </div>
            </div>

            <button type="button" class="btn-primary" @onclick="Save" disabled="@(_cssError is not null)">Save</button>
        </div>

        <div class="mcc-preview">
            <span class="mcc-preview-title">Preview</span>
            <div class="mcc-preview-body">
                <MissionCardCustomStyle Config="_form.ToConfig()"/>
                @if (_previewMission is not null) {
                    <MissionCard Mission="_previewMission" Config="_form.ToConfig()" ViewByDate="false" ViewMissionTimes="true"/>
                } else {
                    <span class="mcc-preview-empty">No missions loaded to preview.</span>
                }
            </div>
        </div>
    </div>
</ModalHost>
</div>

@code {
    [Parameter] public CardPresetSet PresetSet { get; set; } = CardPresetSet.Default;
    [Parameter] public EventCallback<CardPresetSet> OnSave { get; set; }
    [Parameter] public DatabaseMission? PreviewMission { get; set; }

    private bool _open;
    private CardConfigForm _form = new();
    private string? _cssError;
    private DatabaseMission? _previewMission => PreviewMission;
    private string _editingPresetName = "Classic";

    private static readonly IReadOnlyList<TileGroup<CardLayout>.Tile> LayoutTiles = [
        new(CardLayout.CompactRow, b => b.AddContent(0, "Compact row")),
        new(CardLayout.Grid, b => b.AddContent(0, "Grid")),
        new(CardLayout.Cards, b => b.AddContent(0, "Cards (beta)"), Title: "Stacked mission cards in List, cards inside Calendar bars, and an agenda view on phones")
    ];

    private IReadOnlyList<TileGroup<string>.Tile> PresetTiles() =>
        [.. PresetSet.Presets.Select(p => new TileGroup<string>.Tile(p.Name, b => b.AddContent(0, p.Name)))];

    private bool IsClassic => _editingPresetName == "Classic";

    private void SetLayout(CardLayout layout) {
        _form.Layout = layout;
    }

    public Task OpenAsync() {
        _editingPresetName = PresetSet.ActivePresetName;
        _form = CardConfigForm.From(PresetSet.ActivePreset());
        _cssError = null;
        _open = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public void Close() {
        _open = false;
    }

    private void SetFieldEnabled(CardFieldSlot slot, ChangeEventArgs e) {
        var enabled = e.Value is bool b && b;
        var idx = _form.Fields.FindIndex(f => f.Field == slot.Field);
        _form.Fields[idx] = slot with { Enabled = enabled };
        ValidateCss();
    }

    private bool IsFirst(CardFieldSlot slot) {
        return _form.Fields.OrderBy(f => f.Order).First().Field == slot.Field;
    }

    private bool IsLast(CardFieldSlot slot) {
        return _form.Fields.OrderBy(f => f.Order).Last().Field == slot.Field;
    }

    private void MoveField(CardFieldSlot slot, int delta) {
        var ordered = _form.Fields.OrderBy(f => f.Order).ToList();
        var idx = ordered.FindIndex(f => f.Field == slot.Field);
        var newIdx = idx + delta;
        if (newIdx < 0 || newIdx >= ordered.Count) return;

        (ordered[idx], ordered[newIdx]) = (ordered[newIdx], ordered[idx]);
        for (var i = 0; i < ordered.Count; i++) {
            var formIdx = _form.Fields.FindIndex(f => f.Field == ordered[i].Field);
            _form.Fields[formIdx] = ordered[i] with { Order = i };
        }
    }

    private void ValidateCss() {
        CustomCssSanitizer.TryScope(_form.Name, _form.CustomCss, out _, out _cssError);
    }

    private async Task Save() {
        ValidateCss();
        if (_cssError is not null) return;

        var updated = _form.ToConfig();
        var others = PresetSet.Presets.Where(p => p.Name != _editingPresetName).ToList();
        others.Add(updated);
        await CommitAsync(others, updated.Name);
        Close();
    }

    private enum NameAction {
        SaveAsNew,
        Duplicate,
        Rename
    }

    private NameAction? _pendingNameAction;
    private string _pendingNameInput = "";
    private string? _nameError;

    private bool CanConfirmNaming =>
        !string.IsNullOrWhiteSpace(_pendingNameInput)
        && (!PresetSet.Presets.Any(p => p.Name == _pendingNameInput) || (_pendingNameAction == NameAction.Rename && _pendingNameInput == _editingPresetName));

    private void BeginNaming(NameAction action) {
        _pendingNameAction = action;
        _pendingNameInput = action == NameAction.Duplicate ? _editingPresetName + " copy" : "";
        _nameError = null;
    }

    private void SwitchTo(string name) {
        _editingPresetName = name;
        _form = CardConfigForm.From(PresetSet.Presets.First(p => p.Name == name));
        _pendingNameAction = null;
        ValidateCss();
    }

    private async Task ConfirmNaming() {
        if (!CanConfirmNaming || _pendingNameAction is not { } action) return;

        var name = _pendingNameInput.Trim();
        if (PresetSet.Presets.Any(p => p.Name == name) && !(action == NameAction.Rename && name == _editingPresetName)) {
            _nameError = "A preset with that name already exists.";
            return;
        }

        switch (action) {
            case NameAction.SaveAsNew:
                _form.Name = name;
                _editingPresetName = name;
                await CommitAsync(PresetSet.Presets.Append(_form.ToConfig()).ToList(), name);
                break;
            case NameAction.Duplicate:
                var duplicate = PresetSet.Presets.First(p => p.Name == _editingPresetName) with { Name = name };
                _editingPresetName = name;
                _form = CardConfigForm.From(duplicate);
                await CommitAsync(PresetSet.Presets.Append(duplicate).ToList(), name);
                break;
            case NameAction.Rename:
                var renamed = _form.ToConfig() with { Name = name };
                var others = PresetSet.Presets.Where(p => p.Name != _editingPresetName).ToList();
                others.Add(renamed);
                _editingPresetName = name;
                _form.Name = name;
                await CommitAsync(others, name);
                break;
        }

        _pendingNameAction = null;
    }

    private async Task Delete() {
        if (_editingPresetName == "Classic") return;

        var remaining = PresetSet.Presets.Where(p => p.Name != _editingPresetName).ToList();
        _editingPresetName = "Classic";
        _form = CardConfigForm.From(remaining.First(p => p.Name == "Classic"));
        await CommitAsync(remaining, "Classic");
    }

    private async Task CommitAsync(List<MissionCardConfig> presets, string activeName) {
        await OnSave.InvokeAsync(new CardPresetSet(presets, activeName));
    }

    private sealed class CardConfigForm {
        public string Name { get; set; } = "Classic";
        public CardLayout Layout { get; set; }
        public List<CardFieldSlot> Fields { get; set; } = [];
        public bool ColorizeByDuration { get; set; }
        public bool ShowExpectedDropsPerShip { get; set; }
        public string? BackgroundColor { get; set; }
        public string? BorderColor { get; set; }
        public string? AccentColor { get; set; }
        public string? CustomCss { get; set; }

        public static CardConfigForm From(MissionCardConfig c) {
            return new CardConfigForm {
                Name = c.Name,
                Layout = c.Layout,
                Fields = [.. c.WithAllFields().Fields],
                ColorizeByDuration = c.ColorizeByDuration,
                ShowExpectedDropsPerShip = c.ShowExpectedDropsPerShip,
                BackgroundColor = c.BackgroundColor,
                BorderColor = c.BorderColor,
                AccentColor = c.AccentColor,
                CustomCss = c.CustomCss
            };
        }

        public MissionCardConfig ToConfig() {
            return new MissionCardConfig(
                Name, Layout, Fields, ColorizeByDuration, ShowExpectedDropsPerShip, BackgroundColor, BorderColor, AccentColor, CustomCss);
        }
    }

}
