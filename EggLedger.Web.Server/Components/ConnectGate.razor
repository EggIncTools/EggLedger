@inject AppConfig Cfg
@inject NavigationManager Nav
@inject IdentityApiClient Identity
@inject ILogger<ConnectGate> Logger
@inject ConsentReader Consent
@inject ConsentOptions ConsentConfig
@inject ViewerCookies Cookies
@using EggIdentity.Consent
@using EggIdentity.UI
@using EggLedger.Web.State
@implements IDisposable
<div class="connect-gate">
    <div class="connect-gate-card">
        <img class="connect-gate-logo" src="@ContentPaths.Asset("images/icon-512.png")" alt="EggLedger" width="48" height="48"/>
        <h1 class="connect-gate-title">Log in to EggLedger</h1>
        <p class="connect-gate-lead">
            Your mission history is stored server-side under your account, private to you.
        </p>
        <div class="connect-gate-actions">
            @if (!string.IsNullOrEmpty(Cfg.IdentityWidgetUrl)) {
                @if (FunctionalAllowed) {
                    <Menu Class="auth-source-anchor" TriggerClass="discord-btn" Open="_open" OpenChanged="OnOpenChangedAsync">
                        <Trigger>@(_loading ? "Loading..." : "Login")</Trigger>
                        <ChildContent>
                            @if (_sources is not null) {
                                @foreach (var source in _sources) {
                                    <a class="auth-source-btn" href="@Abs(source.Url)">
                                        @if (!string.IsNullOrEmpty(source.IconUrl)) {
                                            <img class="auth-source-logo" src="@Abs(source.IconUrl)" alt=""/>
                                        }
                                        <span>@source.Name</span>
                                    </a>
                                }
                            } else if (_error is not null) {
                                <p class="auth-source-error">@_error</p>
                            }
                        </ChildContent>
                    </Menu>
                } else {
                    <button type="button" class="discord-btn" disabled>Login</button>
                }
            }
        </div>
        @if (!FunctionalAllowed) {
            <p class="connect-gate-note">
                @if (Consent.Current is null) {
                    <span>Choose "Accept all" or enable Functional cookies in the banner to log in.</span>
                } else {
                    <span>Logging in needs functional cookies.</span>
                    <button type="button" class="connect-gate-consent-btn" @onclick="AllowFunctional">Allow functional cookies</button>
                }
            </p>
        }
    </div>
</div>

@code {
    private List<LoginSourceResponse>? _sources;
    private bool _open;
    private bool _loading;
    private string? _error;

    private bool FunctionalAllowed => Consent.Allows(ConsentCategory.Functional);

    protected override void OnInitialized() => Consent.Changed += OnConsentChanged;

    private void OnConsentChanged(object? sender, EventArgs e) => _ = InvokeAsync(StateHasChanged);

    private void AllowFunctional() {
        var now = DateTimeOffset.FromUnixTimeSeconds(DateTimeOffset.UtcNow.ToUnixTimeSeconds());
        var state = new ConsentState(true, Consent.Current?.Analytics ?? false, ConsentConfig.PolicyVersion, now);
        Cookies.Set(ConsentCookie.Name, ConsentCookie.Format(state));
        Consent.Set(state);
    }

    private async Task OnOpenChangedAsync(bool open) {
        _open = open;
        if (!open) {
            _sources = null;
            _error = null;
            return;
        }

        _loading = true;
        try {
            var response = await Identity.GetLoginSourcesAsync(Nav.Uri, CancellationToken.None);
            if (response.Sources.Count == 0) {
                _error = "No login providers configured.";
            } else {
                _sources = response.Sources;
            }
        } catch (HttpRequestException ex) {
            Logger.LogDebug(ex, "login: failed to fetch login sources");
            _error = "Login temporarily unavailable.";
        } finally {
            _loading = false;
        }
    }

    private string Abs(string url) {
        return url.StartsWith("http", StringComparison.Ordinal)
            ? url
            : $"{Cfg.IdentityWidgetUrl.TrimEnd('/')}/{url.TrimStart('/')}";
    }

    public void Dispose() => Consent.Changed -= OnConsentChanged;

}
