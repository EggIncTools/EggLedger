@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceProvider Services
@inject AppStateService AppStateSvc
@inject LedgerShellState Shell
@inject IPlatformCapabilities Platform
@inject IUpdateStatusProvider UpdateStatus

<div class="ledger-about">
    @if (Services.GetService<ISuiteChromeSlot>() is { } suiteChrome) {
        <div class="ledger-about-suite">@suiteChrome.Render()</div>
    }

    <span class="ledger-about-info">
        <img class="ledger-about-logo" src="@ContentPaths.Asset("images/icon-512.png")" alt="" width="22" height="22"/>
        <span class="ledger-about-brand">EggLedger</span>
        @if (AppVersionInfo.Display is { Length: > 0 } version) {
            if (AppVersionInfo.CommitUrl is { } commitUrl) {
                <a class="ledger-about-version" href="@commitUrl" target="_blank" rel="noopener" aria-label="View commit on GitHub">@version</a>
            } else {
                <span class="ledger-about-version">@version</span>
            }
        }
        @if (UpdateAvailable) {
            <button type="button" class="ledger-about-badge" aria-label="New version available"
                    @onclick="OpenUpdate">
                <span class="ledger-about-dot"></span>
            </button>
        }
        <span class="ledger-about-authors">
            by <a class="url-link" href="https://github.com/fanaticscripter" target="_blank" rel="noopener">@@mk2</a>
            &amp; <a class="url-link" href="https://github.com/DavidArthurCole" target="_blank" rel="noopener">@@DavidArthurCole</a>
        </span>
    </span>

    <span class="ledger-about-actions">
        <button type="button" class="ledger-about-btn" aria-label="All settings" aria-haspopup="dialog" @onclick="OpenSettings">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
        </button>
        <button type="button" class="ledger-about-btn" aria-label="About" @onclick="OpenAbout">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <line x1="12" y1="11" x2="12" y2="16"/>
                <line x1="12" y1="8" x2="12" y2="8.01"/>
            </svg>
        </button>
        <button type="button" class="ledger-about-btn" aria-label="Terms" @onclick="OpenTerms">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
                <polyline points="14 3 14 8 19 8"/>
                <line x1="9" y1="13" x2="15" y2="13"/>
                <line x1="9" y1="17" x2="15" y2="17"/>
            </svg>
        </button>
        <button type="button" class="ledger-about-btn" aria-label="Privacy" @onclick="OpenPrivacy">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18" aria-hidden="true">
                <path d="M12 3l7 3v6c0 4.2-2.9 7.8-7 9-4.1-1.2-7-4.8-7-9V6z"/>
            </svg>
        </button>
        <a class="ledger-about-btn" href="https://github.com/EggIncTools/EggLedger" target="_blank" rel="noopener"
           aria-label="EggLedger on GitHub">
            <svg viewBox="0 0 16 16" fill="currentColor" width="18" height="18" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
        </a>
    </span>
</div>

<DesktopOnly>
    <UpdateModal @ref="_updateModal"/>
</DesktopOnly>

@code {
    private UpdateModal? _updateModal;

    private bool UpdateAvailable =>
        Platform.IsDesktop && !string.IsNullOrEmpty(UpdateStatus.AvailableVersion);

    protected override void OnInitialized() {
        AppStateSvc.Changed += OnStateChanged;
        if (Platform.IsDesktop) UpdateStatus.Changed += OnStateChanged;
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    private void OpenUpdate() {
        _updateModal?.Open();
    }

    private void OpenSettings() {
        Shell.SettingsOpen = true;
    }

    private void OpenAbout() {
        Shell.AboutOpen = true;
    }

    private void OpenTerms() {
        Shell.Legal = LegalDocument.Terms;
    }

    private void OpenPrivacy() {
        Shell.Legal = LegalDocument.Privacy;
    }

    public void Dispose() {
        AppStateSvc.Changed -= OnStateChanged;
        if (Platform.IsDesktop) UpdateStatus.Changed -= OnStateChanged;
    }

}
