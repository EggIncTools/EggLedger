<ErrorBoundary @ref="_boundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent>
        <div class="errb">
            <span class="errb-title">Something went wrong.</span>
            <span class="errb-text">This view hit an error and could not load.</span>
            <button type="button" class="btn-primary" @onclick="Recover">
                Try Again
            </button>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ErrorBoundary? _boundary;

    private void Recover() {
        _boundary?.Recover();
    }

}
