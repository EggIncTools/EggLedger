@if (!HasAccount) {
    <section class="flex-1 flex flex-col w-full mx-auto px-4 overflow-hidden bg-darker">
        <p class="text-gray-500 italic">@NoAccountMessage</p>
    </section>
} else if (IsLoading) {
    <section class="flex-1 flex flex-col w-full mx-auto px-4 overflow-hidden bg-darker">
        @(LoadingContent ?? DefaultLoading)
    </section>
} else if (IsEmpty) {
    <section class="flex-1 flex flex-col w-full mx-auto px-4 overflow-hidden bg-darker">
        <NoDataFallback/>
    </section>
} else {
    <section class="flex-1 flex flex-col w-full mx-auto px-4 overflow-hidden bg-darker">
        <div class="flex flex-col md:flex-row md:items-stretch gap-0_75rem mt-0_75rem flex-1 min-h-0">
            <div class="filter-panel mt-0 @(_hideFilter ? "md:w-auto md:flex-none" : "md:w-[30%]")">
                <span class="mr-0_5rem h-20 font-bold text-gray-400">Filter</span>
                <button type="button" class="text-base toggle-link whitespace-nowrap" @onclick="@(() => _hideFilter = !_hideFilter)">
                    @(_hideFilter ? "Show" : "Hide")
                </button>
                @if (!_hideFilter) {
                    <MissionFilterBar FieldCtx="FieldCtx"
                                      Applying="Applying"
                                      LastResultText="@LastResultText"
                                      OnApply="OnApply"/>
                }
            </div>

            <div class="flex-1 flex flex-col min-h-0 px-2 pb-20 overflow-auto shadow-sm bg-darkest rounded-md">
                @ChildContent
            </div>
        </div>
    </section>
}

@code {
    [Parameter] public bool HasAccount { get; set; }
    [Parameter] public string NoAccountMessage { get; set; } = "";
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public RenderFragment? LoadingContent { get; set; }
    [Parameter] public bool IsEmpty { get; set; }
    [Parameter] public required FilterFieldCtx FieldCtx { get; set; }
    [Parameter] public bool Applying { get; set; }
    [Parameter] public string LastResultText { get; set; } = "";
    [Parameter] public EventCallback<MissionFilterBar.LegacyFilter> OnApply { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _hideFilter;

    private static readonly RenderFragment DefaultLoading = __builder => {
        <p class="text-gray-500 italic">Loading...</p>
    };
}
