@inject LedgerShellState Shell

<EmptyState Icon="database" Title="@Message" Hint="Choose an account in the sidebar account selector, then press Fetch.">
    <button type="button" class="btn-secondary" @onclick="Shell.RequestAccountPopover">Choose account</button>
</EmptyState>

@code {
    [Parameter] public string Message { get; set; } = "No mission data has been loaded yet.";
}
