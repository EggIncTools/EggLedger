@inject IndexedDbPinnedReportStore PinStore
@inject IndexedDbReportStore ReportStore

<div class="pinned-reports-strip">
    <div class="pinned-reports-header flex items-center justify-end mb-2">
        <SearchablePicker Options="_pickerOptions" OverlayKind="drop" Placeholder="Add a report" OnSelect="OnPickAsync"
                          TriggerClass="text-xs text-gray-400 hover:text-gray-200 bg-darker border border-gray-700 rounded px-2 py-1 leading-none">
            <TriggerContent>+</TriggerContent>
        </SearchablePicker>
    </div>
    @if (_defs.Count == 0) {
        <p class="text-xs text-gray-500 italic">No pinned reports yet. Add one with the + button.</p>
    } else {
        <div class="report-grid grid gap-3 relative" style="grid-template-columns: repeat(8, 1fr); grid-auto-rows: 144px;">
            @for (var i = 0; i < _defs.Count; i++) {
                var def = _defs[i];
                var pos = _positions[i];
                var pinId = _resolvedPins[i].Id;
                <div @key="pinId" class="pinned-report-card relative" style="grid-column: @pos.Col / span @pos.W; grid-row: @pos.Row / span @pos.H;">
                    <ReportCard Def="def" Pos="pos" AccountId="@AccountId" ShowUnpin="true" OnUnpin="() => UnpinAsync(pinId)"/>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] [EditorRequired] public string AccountId { get; set; } = "";
    [Parameter] [EditorRequired] public string View { get; set; } = "";

    private List<PinnedReportRow> _pins = [];
    private List<PinnedReportRow> _resolvedPins = [];
    private List<ReportDefinition> _defs = [];
    private List<GridCardPos> _positions = [];
    private List<FilterOption> _pickerOptions = [];
    private string _loadedKey = "";

    protected override async Task OnParametersSetAsync() {
        var key = AccountId + ":" + View;
        if (key == _loadedKey) {
            return;
        }

        _loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync() {
        if (string.IsNullOrEmpty(AccountId)) {
            _pins = [];
            _resolvedPins = [];
            _defs = [];
            _positions = [];
            _pickerOptions = [];
            return;
        }

        _pins = [.. await PinStore.RetrieveAsync(AccountId, View)];

        if (_pins.Count == 0 && View == PinnedReportViews.Lifetime) {
            var defaults = new[] { ReportTemplates.ShipMix, ReportTemplates.DurationMix, ReportTemplates.RarityMix };
            for (var i = 0; i < defaults.Length; i++) {
                await PinStore.InsertAsync(new PinnedReportRow {
                    AccountId = AccountId,
                    View = View,
                    Kind = PinnedReportKinds.Template,
                    RefId = defaults[i],
                    SortOrder = i,
                });
            }

            await PinStore.InsertAsync(new PinnedReportRow {
                AccountId = AccountId,
                View = View,
                Kind = PinnedReportKinds.Template,
                RefId = PinnedReportSentinels.LifetimeSeedMarker,
                SortOrder = defaults.Length,
            });

            _pins = [.. await PinStore.RetrieveAsync(AccountId, View)];
        }

        var resolvedPins = new List<PinnedReportRow>();
        var defs = new List<ReportDefinition>();
        foreach (var pin in _pins) {
            ReportDefinition? def = null;
            if (pin.Kind == PinnedReportKinds.Template) {
                def = ReportTemplates.Find(pin.RefId);
                if (def is not null) {
                    def.AccountId = AccountId;
                }
            } else {
                var row = await ReportStore.RetrieveReportAsync(pin.RefId);
                if (row is not null) {
                    def = ReportMapping.ToDefinition(row);
                }
            }
            if (def is null) {
                continue;
            }
            resolvedPins.Add(pin);
            defs.Add(def);
        }

        _resolvedPins = resolvedPins;
        _defs = defs;
        _positions = ReportGridLayout.BuildOccupancyFromLayout(_defs).CardPositions;

        var pinnedUserIds = _pins.Where(p => p.Kind == PinnedReportKinds.User).Select(p => p.RefId).ToHashSet();
        var pinnedTemplateIds = _pins.Where(p => p.Kind == PinnedReportKinds.Template).Select(p => p.RefId).ToHashSet();
        var userReports = await ReportStore.RetrieveAccountReportsAsync(AccountId);
        _pickerOptions = [
            .. userReports.Where(r => !pinnedUserIds.Contains(r.Id)).Select(r => new FilterOption { Value = "user:" + r.Id, Text = r.Name }),
            .. ReportTemplates.All.Where(t => !pinnedTemplateIds.Contains(t.Id)).Select(t => new FilterOption { Value = "template:" + t.Id, Text = t.Name + " (template)" }),
        ];
    }

    private async Task OnPickAsync(FilterOption opt) {
        var parts = opt.Value.Split(':', 2);
        if (parts.Length != 2) {
            return;
        }

        var kind = parts[0] == "template" ? PinnedReportKinds.Template : PinnedReportKinds.User;
        var refId = parts[1];
        if (_pins.Any(p => p.Kind == kind && p.RefId == refId)) {
            return;
        }

        await PinStore.InsertAsync(new PinnedReportRow {
            AccountId = AccountId,
            View = View,
            Kind = kind,
            RefId = refId,
            SortOrder = _pins.Count,
        });

        await LoadAsync();
    }

    private async Task UnpinAsync(string pinId) {
        await PinStore.DeleteAsync(pinId);
        await LoadAsync();
    }
}
