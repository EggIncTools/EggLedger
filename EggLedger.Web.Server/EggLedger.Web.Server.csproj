<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>EggLedger Blazor Server host. Runs the EggLedger.Web RCL UI server-side over a SignalR circuit, so decode and crypto use native APIs (no /decode wire). Folds in the sync server in later migration phases.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggLedger.Web\EggLedger.Web.csproj" />
    <ProjectReference Include="..\EggLedger.Domain\EggLedger.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EggIdentity.Auth" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Bot" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Bot.AdminUi" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Contract" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Db" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Fallback" Version="2.1.7" />
    <PackageReference Include="EggIdentity.AdminUi" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Client" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Metrics" Version="2.1.7" />
    <PackageReference Include="EggIdentity.Metrics.AdminUi" Version="2.1.7" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggLedger.Web.Server.Tests" />
  </ItemGroup>

</Project>
