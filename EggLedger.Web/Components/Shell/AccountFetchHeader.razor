@using EggIdentity.Contract
@using EggIdentity.UI
@using EggIdentity.UI.Suite
@using Microsoft.Extensions.DependencyInjection
@implements IDisposable
@inject IServiceProvider Services
@inject ActiveAccount Active
@inject AppStateService AppStateSvc
@inject AccountLoader Loader
@inject FetchOrchestrator Fetch
@inject MissionQueryHandlers Queries
@inject IndexedDbSettings SettingsStore
@inject SettingsWriteCoordinator Writer
@inject IPlatformCapabilities Platform
@inject NavigationManager Nav
@inject LedgerShellState Shell
@inject TimeProvider Time
@inject ILogger<AccountFetchHeader> Logger

<NavigationLock ConfirmExternalNavigation="@(!Fetch.IsIdle)"/>

<div class="account-bar">
    <button type="button" class="account-rail-chip" title="@ChipTitle" aria-label="Expand sidebar" @onclick="RequestExpand">
        <span class="account-chip-dot" style="--acct-color: #@ChipColor"></span>
    </button>

    <div class="account-full">
        @if (Services.GetService<ISuiteChromeSlot>() is { } suiteChrome) {
            <div class="account-suite">
                <span class="account-suite-label">@(IsLoggedIn ? "Signed in as" : "Not signed in")</span>
                @suiteChrome.RenderAccount()
            </div>
        }
        <div class="account-main-row">
            @if (IsLoggedIn) {
                <SuiteEidPicker @bind-Open="_open" Class="account-select-wrap" MaxHeight="min(70vh, 30rem)"
                                TriggerTemplate="@(_ => RenderSummary())" RowTemplate="@RenderAccountRow"
                                Header="@RenderAccountHead()" Footer="@RenderAccountFoot()"/>
            } else {
                <div class="account-select-wrap">
                    <button type="button" class="account-select-btn" disabled>@RenderSummary()</button>
                </div>
            }

            @if (Fetch.IsIdle) {
                <button type="button" class="account-fetch-btn" disabled="@(Active.ActiveAccountId is null)" @onclick="StartFetch">
                    Fetch
                </button>
            } else {
                <button type="button" class="account-fetch-btn account-stop-btn" @onclick="StopFetch">
                    Stop
                </button>
            }
        </div>

        @if (Fetch.HasFetchContent) {
            <div class="fetch-log-section @(Fetch.LogExpanded ? "fetch-log-section-open" : "")">
                <button type="button" class="fetch-log-header"
                        aria-label="@(Fetch.LogExpanded ? "Hide fetch log" : "Show fetch log")"
                        aria-expanded="@(Fetch.LogExpanded ? "true" : "false")" @onclick="Fetch.ToggleLog">
                    <span class="fetch-log-meter progress">
                        <span class="fetch-log-meter-fill progress-fill" style="--progress: @(Fetch.Percent)%"></span>
                    </span>
                    <span>@(Fetch.Percent)%</span>
                    <span class="fetch-log-caret">@(Fetch.LogExpanded ? "▾" : "▸")</span>
                </button>
                @if (Fetch.LogExpanded) {
                    <div class="fetch-log-inline">
                        @if (!Fetch.IsIdle) {
                            <div class="fetch-log-workers">
                                <span class="section-heading fetch-log-workers-title">Parallel Download Workers</span>
                                <WorkerCountSlider WorkerCount="_workerCount" WorkerCountChanged="SetWorkerCountAsync" ShowWarningBox="false"/>
                            </div>
                        }
                        <FetchLogPanel/>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {

    private RenderFragment RenderSummary() => __builder => {
        <span class="account-summary">
            @if (_active is not null) {
                <span class="account-line">
                    <span class="account-nick account-nick-trunc" style="--acct-color: #@_active.AccountColor">@_active.Nickname</span>
                    <span class="account-eb account-small">@_active.EBString</span>
                    @{ var activeInfo = InfoFor(_active.Id); }
                    @if (activeInfo is { SeString: not "" }) {
                        <span class="account-small account-se">@activeInfo.SeString SE</span>
                        <span class="account-small account-pe">@activeInfo.PeCount PE</span>
                        @if (activeInfo.TeCount > 0) {
                            <span class="account-small account-te">@activeInfo.TeCount TE</span>
                        }
                    }
                </span>
                <span class="account-option-meta account-line account-small account-dim">
                    <EidText Value="@_active.Id" Interactive="false"/>
                    @RenderBackupStamp(activeInfo)
                </span>
                <span class="account-option-meta account-line account-small account-dim">
                    @{ var activeStats = StatsFor(_active.Id); }
                    @if (activeStats is not null) {
                        <span>@activeStats.MissionCount missions</span>
                    }
                    @RenderShipStamp(activeStats)
                </span>
            } else if (!IsLoggedIn) {
                <span class="account-placeholder">Login to add an account</span>
            } else {
                <span class="account-placeholder">No account - click to add</span>
            }
        </span>
        <span class="account-caret">&#9660;</span>
    };

    private RenderFragment RenderBackupStamp(AccountInfo? info) => __builder => {
        var backup = info is null ? "" : LedgerFormatting.FormatTimeSince(info.LastBackupTime, NowUnix);
        if (backup != "") {
            <span class="account-stamp">last backup <span class="@(IsStaleBackup(info) ? "account-stamp-stale" : "account-stamp-value")">@backup</span></span>
        }
    };

    private RenderFragment RenderShipStamp(DatabaseAccount? stats) => __builder => {
        var ship = stats is null ? "" : LedgerFormatting.FormatTimeSince(stats.LastMissionReturnDT, NowUnix);
        if (ship != "") {
            <span class="account-stamp">last ship <span class="account-stamp-value">@ship</span></span>
        }
    };

    private bool IsStaleBackup(AccountInfo? info) =>
        info is not null && info.LastBackupTime > 0 && NowUnix - info.LastBackupTime > StaleBackupSeconds;

    private const double StaleBackupSeconds = 60 * 60 * 24;

    private RenderFragment RenderAccountHead() => __builder => {
        <div class="account-pop-head">
            <span class="account-pop-title">Accounts</span>
            <CloseButton OnClick="ClosePopover" Variant="CloseButton.CloseButtonVariant.Inline"/>
        </div>
    };

    private RenderFragment<ProfileEid> RenderAccountRow => entry => __builder => {
        var acct = SuiteAccountStore.ToAccount(entry);
        <span class="account-pop-body">
            <span class="account-line">
                <span class="account-nick" style="--acct-color: #@acct.AccountColor">@acct.Nickname</span>
                <span class="account-eb">@acct.EBString</span>
                @if (acct.SeString != "") {
                    <span class="account-se">@acct.SeString SE</span>
                    <span class="account-pe">@acct.PeCount PE</span>
                    @if (acct.TeCount > 0) {
                        <span class="account-te">@acct.TeCount TE</span>
                    }
                }
            </span>
            <span class="account-line account-dim">
                <span class="account-stamp-value">
                    <EidText Value="@acct.Id" Interactive="false"/>
                </span>
                @RenderBackupStamp(acct)
            </span>
            <span class="account-line account-dim">
                @{ var stats = StatsFor(acct.Id); }
                @if (stats is not null) {
                    <span>@stats.MissionCount missions</span>
                }
                @RenderShipStamp(stats)
            </span>
        </span>
    };

    private RenderFragment RenderAccountFoot() => __builder => {
        <div class="account-pop-foot">
            <div class="account-pop-actions">
                <button type="button" class="account-pop-action account-pop-action-split" @onclick="OpenSettings">
                    Account Settings
                </button>
                <button type="button" class="account-pop-action account-pop-action-add" @onclick="OpenAddDialog">
                    Add Account
                </button>
            </div>
            @if (IsLoggedIn && !Platform.IsDesktop) {
                <form class="account-pop-form" method="post" action="/api/v1/auth/logout">
                    <button type="submit" class="account-pop-action account-pop-logout">
                        Log out
                    </button>
                </form>
            }
        </div>
    };

}

<AddAccountDialog @ref="_addDialog" Added="OnAccountAdded"/>

@code {

    [CascadingParameter(Name = "IsLoggedIn")]
    private bool IsLoggedIn { get; set; } = true;

    [Parameter] public EventCallback OnExpandRequest { get; set; }

    private bool _open;
    private KnownAccount? _active;
    private AddAccountDialog? _addDialog;
    private IReadOnlyList<DatabaseAccount> _existing = [];
    private int _workerCount = SettingsModel.MinWorkerCount;

    private double NowUnix => Time.GetUtcNow().ToUnixTimeSeconds();

    private IReadOnlyList<KnownAccount> Accounts =>
        AppStateSvc.KnownAccounts;

    private string ChipColor => _active?.AccountColor ?? "6b7280";

    private string ChipTitle => _active?.Nickname ?? "No account selected";

    private AccountInfo? InfoFor(string id) =>
        Loader.Accounts.FirstOrDefault(a => a.Id == id);

    private DatabaseAccount? StatsFor(string id) =>
        _existing.FirstOrDefault(a => a.Id == id);

    private static readonly string[] LinkResultQueryKeys = ["linked=", "linkConflict=", "linkRejected=", "linkError="];

    protected override async Task OnInitializedAsync() {
        Active.Changed += OnStateChanged;
        AppStateSvc.Changed += OnStateChanged;
        AppStateSvc.Changed += OnKnownAccountsChanged;
        Fetch.Changed += OnStateChanged;
        Shell.AccountPopoverRequested += OnPopoverRequested;
        RefreshActive();
        await RefreshExistingAsync();
        await LoadWorkerCountAsync();
        await ResumeIncompleteFetchAsync();
    }

    private async Task LoadWorkerCountAsync() {
        var all = await SettingsStore.GetAllSettingsAsync();
        if (all.TryGetValue(SettingsModel.KeyWorkerCount, out var raw) && int.TryParse(raw, out var n)) _workerCount = SettingsModel.ClampWorkerCount(n);
    }

    private async Task SetWorkerCountAsync(int n) {
        _workerCount = SettingsModel.ClampWorkerCount(n);
        await Writer.SetAsync(SettingsModel.KeyWorkerCount, SettingsModel.FormatInt(_workerCount));
    }

    protected override void OnAfterRender(bool firstRender) {
        if (firstRender && IsLoggedIn) ReopenSettingsAfterLinkReturn();
    }

    private void ReopenSettingsAfterLinkReturn() {
        var query = new Uri(Nav.Uri).Query;
        if (query.Length == 0 || !LinkResultQueryKeys.Any(query.Contains)) return;

        var cleanUri = new Uri(Nav.GetUriWithQueryParameters(new Dictionary<string, object?> {
            ["linked"] = null,
            ["linkConflict"] = null,
            ["linkRejected"] = null,
            ["linkError"] = null
        }));
        var settingsUri = Nav.ToAbsoluteUri("settings") + cleanUri.Query;
        Nav.NavigateTo(settingsUri, replace: true);
    }

    private async Task ResumeIncompleteFetchAsync() {
        if (!Fetch.IsIdle) return;

        var incomplete = await FetchOrchestrator.GetIncompleteAccountsAsync(SettingsStore);
        var knownIds = AppStateSvc.KnownAccounts.Select(a => a.Id).ToHashSet();
        if (incomplete.Find(knownIds.Contains) is { } resumeId) _ = StartFetchFor(resumeId);
    }

    private void OnStateChanged() {
        RefreshActive();
        InvokeAsync(StateHasChanged);
    }

    private void OnKnownAccountsChanged() {
        InvokeAsync(async () => {
            await RefreshExistingAsync();
            StateHasChanged();
        });
    }

    private void RefreshActive() =>
        _active = AppStateSvc.KnownAccounts.FirstOrDefault(a => a.Id == Active.ActiveAccountId);

    private async Task RefreshExistingAsync() =>
        _existing = await Queries.GetExistingDataAsync();

    private async Task StartFetch() {
        if (Active.ActiveAccountId is not { } id) return;

        await StartFetchFor(id);
    }

    private async Task StartFetchFor(string id) {
        await LoadWorkerCountAsync();
        await Fetch.StartFetchAsync(id);
        await RefreshExistingAsync();
        await Loader.RefreshAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void StopFetch() {
        Fetch.StopFetch();
    }

    private Task RequestExpand() {
        return OnExpandRequest.InvokeAsync();
    }

    private void ClosePopover() {
        _open = false;
    }

    private void OpenAddDialog() {
        ClosePopover();
        _addDialog?.Open();
    }

    private void OpenSettings() {
        ClosePopover();
        Shell.SettingsOpen = true;
    }

    private void OnPopoverRequested() {
        InvokeAsync(() => {
            _open = IsLoggedIn;
            StateHasChanged();
        });
    }

    private async Task OnAccountAdded(AccountInfo account) {
        await Loader.RefreshAsync();
        Active.SetActive(account.Id);
        await StartFetch();
    }

    public void Dispose() {
        Active.Changed -= OnStateChanged;
        AppStateSvc.Changed -= OnStateChanged;
        AppStateSvc.Changed -= OnKnownAccountsChanged;
        Fetch.Changed -= OnStateChanged;
        Shell.AccountPopoverRequested -= OnPopoverRequested;
    }

}
