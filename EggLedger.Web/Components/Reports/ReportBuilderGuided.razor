@* Guided report builder: a 4-step wizard (intent -> group-by -> quick filters -> name)
   that emits a partial ReportDefinition for the parent to prefill and switch to advanced. *@

<div class="guide">
    <div class="guide-head">
        <span class="guide-step">Step @DisplayStep of @TotalSteps</span>
        <div class="guide-dots">
            @for (var n = 1; n <= TotalSteps; n++) {
                <div class="guide-dot @(n <= DisplayStep ? "guide-dot-on" : "")"></div>
            }
        </div>
    </div>

    @if (_step == 1) {
        <div class="guide-pane">
            <p class="guide-prompt">What would you like to analyze?</p>
            <div class="guide-intents">
                @foreach (var opt in IntentOptions) {
                    <button type="button"
                            class="guide-choice guide-intent @(_intent == opt.Value ? "guide-choice-on" : "")"
                            @onclick="() => SelectIntent(opt.Value)">
                        <span class="guide-intent-label">@opt.Label</span>
                        <span class="guide-intent-hint">@opt.Hint</span>
                    </button>
                }
            </div>
        </div>
    } else if (_step == 2) {
        <div class="guide-pane">
            <p class="guide-prompt">Break it down by...</p>
            <div class="guide-list">
                @foreach (var opt in GroupByOptions) {
                    <button type="button"
                            class="guide-choice guide-option @(_groupBy == opt.Value ? "guide-choice-on" : "")"
                            @onclick="() => SelectGroupBy(opt.Value)">
                        <span>@opt.Label</span>
                    </button>
                }
            </div>
            <div class="guide-actions">
                <button type="button" class="guide-btn guide-btn-back" @onclick="GoBack">Back</button>
            </div>
        </div>
    } else if (_step == 3) {
        <div class="guide-pane">
            <p class="guide-prompt">Apply a quick filter? (optional)</p>
            <div class="guide-filters">
                @foreach (var qf in QuickFilterOptions) {
                    <label class="guide-filter">
                        <input type="checkbox" class="guide-filter-box" checked="@_quickFilters.Contains(qf.Key)"
                               @onchange="e => ToggleQuickFilter(qf.Key, e)"/>
                        @qf.Label
                    </label>
                }
            </div>
            <div class="guide-actions">
                <button type="button" class="guide-btn guide-btn-back" @onclick="GoBack">Back</button>
                <button type="button" class="guide-btn guide-btn-next" @onclick="() => _step = 4">Next</button>
            </div>
        </div>
    } else {
        <div class="guide-pane">
            <p class="guide-prompt">Give it a name</p>
            <input type="text" class="guide-name"
                   placeholder="Report name" @bind="_reportName" @bind:event="oninput" @onkeydown="OnNameKeyDown"/>
            <div class="guide-actions">
                <button type="button" class="guide-btn guide-btn-back" @onclick="GoBack">Back</button>
                <button type="button" class="guide-btn guide-btn-next"
                        disabled="@string.IsNullOrWhiteSpace(_reportName)" @onclick="Apply">
                    Create Report
                </button>
            </div>
        </div>
    }
</div>

@code {

    public sealed record GuidedResult(
        string Name,
        string Subject,
        string Mode,
        string GroupBy,
        string DisplayMode,
        IReadOnlyList<FilterCondition> And);

    [Parameter] public EventCallback<GuidedResult> OnApply { get; set; }

    private sealed record IntentOption(string Value, string Label, string Hint);

    private sealed record QuickFilterOption(string Key, string Label, FilterCondition Condition);

    private static readonly IReadOnlyList<IntentOption> IntentOptions = [
        new("missions", "Mission counts", "Count missions by ship, level, or duration"),
        new("artifacts", "Artifact drops", "Count drops by artifact, rarity, or type"),
        new("time", "Activity over time", "Track mission activity across weeks or months")
    ];

    private int _step = 1;
    private string _intent = "";
    private string _groupBy = "";
    private readonly HashSet<string> _quickFilters = new();
    private string _reportName = "";

    private IReadOnlyList<ReportDimension> GroupByOptions =>
        _intent == "artifacts" ? ReportDimensions.Artifact : ReportDimensions.Mission;

    private IReadOnlyList<QuickFilterOption> QuickFilterOptions {
        get {
            var opts = new List<QuickFilterOption> {
                new("dubcap", "Only dub-cap missions", new FilterCondition("dubcap", "true", "")),
                new("extended", "Only extended missions", new FilterCondition("duration", "=", "2"))
            };
            if (_intent == "artifacts") opts.Add(new QuickFilterOption("legendary", "Only legendary artifacts", new FilterCondition("artifact_rarity", "=", "3")));

            return opts;
        }
    }

    private int TotalSteps => _intent == "time" ? 3 : 4;

    private int DisplayStep {
        get {
            if (_intent != "time") return _step;
            if (_step == 1) return 1;
            return _step == 3 ? 2 : 3;
        }
    }

    private void SelectIntent(string value) {
        _intent = value;
        if (value == "time") {
            _groupBy = "time_bucket";
            AutoName();
            _step = 3;
        } else {
            _groupBy = "";
            _step = 2;
        }
    }

    private void SelectGroupBy(string value) {
        _groupBy = value;
        AutoName();
        _step = 3;
    }

    private void ToggleQuickFilter(string key, ChangeEventArgs e) {
        var on = e.Value is bool b && b;
        if (on) {
            _quickFilters.Add(key);
        } else {
            _quickFilters.Remove(key);
        }
    }

    private void GoBack() {
        if (_step == 4) {
            _step = 3;
            return;
        }

        if (_step == 3) {
            _step = _intent == "time" ? 1 : 2;
            return;
        }

        if (_step == 2) _step = 1;
    }

    private void AutoName() {
        var baseName = _intent switch {
            "missions" => "Mission counts",
            "artifacts" => "Artifact drops",
            "time" => "Activity over time",
            _ => ""
        };
        var by = !string.IsNullOrEmpty(_groupBy) && _groupBy != "time_bucket"
            ? " by " + ReportDimensions.DimensionLabel(_groupBy).ToLowerInvariant()
            : "";
        _reportName = baseName + by;
    }

    private async Task OnNameKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_reportName)) await Apply();
    }

    private async Task Apply() {
        if (string.IsNullOrWhiteSpace(_reportName)) return;

        var and = QuickFilterOptions
            .Where(q => _quickFilters.Contains(q.Key))
            .Select(q => q.Condition)
            .ToList();

        var isArtifact = _intent == "artifacts";
        var displayMode = _intent switch {
            "time" => "line",
            "artifacts" => "pie",
            _ => "bar"
        };
        var result = new GuidedResult(
            _reportName.Trim(),
            isArtifact ? "artifacts" : "missions",
            _intent == "time" ? "time_series" : "aggregate",
            _groupBy,
            displayMode,
            and);
        await OnApply.InvokeAsync(result);
    }

}
