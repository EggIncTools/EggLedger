<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>EggLedger Blazor Server host. Runs the EggLedger.Web RCL UI server-side over a SignalR circuit, so decode and crypto use native APIs (no /decode wire). Folds in the sync server in later migration phases.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggLedger.Web\EggLedger.Web.csproj" />
    <ProjectReference Include="..\EggLedger.Domain\EggLedger.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EggIdentity.Admin" />
    <PackageReference Include="EggIdentity.Auth" />
    <PackageReference Include="EggIdentity.Bot" />
    <PackageReference Include="EggIdentity.Brand" />
    <PackageReference Include="EggIdentity.Core" />
    <PackageReference Include="EggIdentity.Data" />
    <PackageReference Include="EggIdentity.Web" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggLedger.Web.Server.Tests" />
  </ItemGroup>

</Project>
