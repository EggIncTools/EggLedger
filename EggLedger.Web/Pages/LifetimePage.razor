@page "/lifetime"
@using System.Diagnostics
@implements IDisposable
@inject MissionQueryHandlers Queries
@inject MissionConfigProvider Config
@inject ActiveAccount Active
@inject AppStateService AppState
@inject IndexedDbSettings Settings
@inject MissionDataCache DataCache
@inject IUserTimeZoneProvider TzProvider
@inject MennoService Menno

<PageTitle>EggLedger - Lifetime Data</PageTitle>

<FilterSidebarLayout HasAccount="@(Active.ActiveAccountId is not null)"
                     NoAccountMessage="Select an account on the Ledger tab to view its lifetime data."
                     IsLoading="_loading"
                     LoadingContent="@LifetimeLoadingContent"
                     IsEmpty="@(_data is null || _data.MissionCount == 0)"
                     FieldCtx="Config.FieldCtx"
                     Applying="_applying"
                     LastResultText="@_resultText"
                     OptionsContent="@RenderOptions()"
                     OnApply="ApplyFilterAsync">
    <div class="flex items-center gap-2 pt-1">
        <span class="ledger-underline text-base text-gray-400">Data compiled from @_data!.MissionCount Missions</span>
    </div>
    <div class="flex-1 min-h-0 py-1 overflow-auto block text-xs font-mono text-gray-300 text-center">
        <DropDisplayContainer Artifacts="_data!.Artifacts"
                              Stones="_data.Stones"
                              Ingredients="_data.Ingredients"
                              StoneFragments="_data.StoneFragments"
                              MennoData="_mennoData"
                              LifetimeMissionCount="_data.MissionCount"
                              ShowPerShip="_showPerShip"
                              LifetimeExpected="@(_showExpectedTotals && _allowExpectedTotals)"/>
    </div>
</FilterSidebarLayout>

@code {

    private static readonly RenderFragment LifetimeLoadingContent = __builder => {
        <div class="mt-8 flex flex-col items-center justify-center gap-2">
            <span class="p-0_5rem text-lg">Lifetime data is being compiled, please wait...</span>
            <img src="@ContentPaths.Asset("images/loading.gif")" alt="Loading..." class="xl-ico"/>
        </div>
    };

}

@code {
    private const string KeySortMethod = "lifetime_sort_method";
    private const string KeyShowPerShip = "lifetime_show_drops_per_ship";
    private const string KeyShowExpectedTotals = "lifetime_show_expected_totals";
    private bool _loading = true;
    private LifetimeData? _data;
    private LifetimeSortMethod _sortMethod = LifetimeSortMethod.Default;
    private bool _applying;
    private string _resultText = "";
    private bool _showPerShip;
    private bool _showExpectedTotals;
    private bool _allowExpectedTotals;
    private MissionMennoData? _mennoData;
    private IReadOnlyList<DatabaseMission>? _matchedMissions;
    private MissionFilterMatcher? _matcher;
    private IReadOnlyList<DatabaseMission>? _allMissions;
    private Dictionary<string, List<MissionDrop>>? _allDropsCache;

    protected override async Task OnInitializedAsync() {
        Active.Changed += OnAccountChanged;
        AppState.Changed += OnAppStateChanged;
        var settings = await Settings.GetAllSettingsAsync();
        _sortMethod = LifetimeSorter.ParseMethod(
            settings.TryGetValue(KeySortMethod, out var s) ? s : null);
        _showPerShip = settings.TryGetValue(KeyShowPerShip, out var ps) && ps == "true";
        _showExpectedTotals = settings.TryGetValue(KeyShowExpectedTotals, out var et) && et == "true";
        await LoadAsync();
    }

    private void OnAccountChanged() {
        InvokeAsync(LoadAsync);
    }


    private void OnAppStateChanged() {
        if (AppState.PipelineState == Services.AppState.Success && Active.ActiveAccountId is not null) {
            DataCache.InvalidateAll();
            InvokeAsync(LoadAsync);
        }
    }

    private async Task LoadAsync() {
        var id = Active.ActiveAccountId;
        if (id is null) {
            _data = null;
            StateHasChanged();
            return;
        }

        var cached = DataCache.GetDrops(id, DateTime.UtcNow);
        Dictionary<string, List<MissionDrop>>? dropsByMission;
        if (cached is not null) {
            dropsByMission = cached;
        } else {
            _loading = true;
            StateHasChanged();
            dropsByMission = await Queries.GetAllPlayerDropsAsync(id);
            if (dropsByMission is not null) {
                DataCache.SetDrops(id, dropsByMission, DateTime.UtcNow);
            }
        }

        _loading = false;

        if (dropsByMission is null) {
            _data = null;
            StateHasChanged();
            return;
        }

        var cachedMissions = DataCache.GetMissions(id, DateTime.UtcNow);
        if (cachedMissions is not null) {
            _allMissions = cachedMissions;
        } else {
            var rows = await Queries.ViewMissionsOfEidAsync(id);
            var missions = rows?.Cast<DatabaseMission>().ToList() ?? new List<DatabaseMission>();
            DataCache.SetMissions(id, missions, DateTime.UtcNow);
            _allMissions = missions;
        }

        _allDropsCache = dropsByMission;
        _matcher = new MissionFilterMatcher(Config.DurationConfigs, id, DropsFetcher, TzProvider.TimeZone);

        var now = DateTime.UtcNow;
        var data = DataCache.GetLifetimeAggregate(id, now);
        if (data is null) {
            data = LifetimeAggregator.Aggregate(dropsByMission);
            DataCache.SetLifetimeAggregate(id, data, now);
        }

        LifetimeSorter.Sort(data, _sortMethod);
        _data = data;
        _matchedMissions = _allMissions;
        await RecomputeMennoAsync();
        StateHasChanged();
    }

    private async Task RecomputeMennoAsync() {
        _mennoData = null;
        var cfg = SingleConfig(_matchedMissions);
        _allowExpectedTotals = cfg is not null;
        if (cfg is null || !_showExpectedTotals) {
            return;
        }

        try {
            await Menno.EnsureLoadedAsync();
        }
        catch (Exception) {
            return;
        }

        var (ship, duration, level, target) = cfg.Value;
        var configs = Menno.GetData(ship, duration, level, target);
        var total = 0;
        foreach (var c in configs) {
            total += c.TotalDrops;
        }

        if (configs.Count > 0) {
            _mennoData = new MissionMennoData { Configs = configs, TotalDropsCount = total };
        }
    }

    private static (int Ship, int Duration, int Level, int Target)? SingleConfig(IReadOnlyList<DatabaseMission>? missions) {
        if (missions is null || missions.Count == 0) {
            return null;
        }

        (int, int, int, int)? cfg = null;
        foreach (var m in missions) {
            var p = MissionDetailBuilder.MennoParams(m);
            if (cfg is null) {
                cfg = p;
            } else if (cfg != p) {
                return null;
            }
        }

        return cfg;
    }

    private async Task<IReadOnlyList<MissionDrop>?> DropsFetcher(string accountId, string missionId) {
        return _allDropsCache is not null && _allDropsCache.TryGetValue(missionId, out var drops)
            ? drops
            : [];
    }

    private async Task ApplyFilterAsync(MissionFilterBar.LegacyFilter filter) {
        if (_allMissions is null || _matcher is null || _allDropsCache is null) {
            return;
        }

        _applying = true;
        StateHasChanged();

        var sw = Stopwatch.StartNew();
        var matchedIds = new HashSet<string>();
        foreach (var mission in _allMissions) {
            if (await _matcher.MissionMatchesFilterAsync(mission, filter.And, filter.Or)) {
                matchedIds.Add(mission.MissiondId);
            }
        }

        sw.Stop();

        var filteredDrops = new Dictionary<string, List<MissionDrop>>();
        foreach (var kvp in _allDropsCache) {
            if (matchedIds.Contains(kvp.Key)) {
                filteredDrops[kvp.Key] = kvp.Value;
            }
        }

        var data = LifetimeAggregator.Aggregate(filteredDrops);
        LifetimeSorter.Sort(data, _sortMethod);
        _data = data;
        _matchedMissions = _allMissions.Where(m => matchedIds.Contains(m.MissiondId)).ToList();
        await RecomputeMennoAsync();

        var shown = matchedIds.Count;
        var filteredOut = _allMissions.Count - shown;
        _resultText = $"Filtered in {sw.Elapsed.TotalSeconds:0.###}s ({shown} shown, {filteredOut} filtered out)";
        _applying = false;
        StateHasChanged();
    }

    private RenderFragment RenderOptions() => __builder => {
        <div class="flex flex-col gap-3">
            <div>
                <span class="font-bold text-gray-400">Sort Method</span>
                <div class="tile-group flex-wrap mt-1">
                    <button type="button" class="tile-group-item @(_sortMethod == LifetimeSortMethod.Default ? "active" : "")" @onclick="@(() => SetSortAsync(LifetimeSortMethod.Default))">Default</button>
                    <button type="button" class="tile-group-item @(_sortMethod == LifetimeSortMethod.Iv ? "active" : "")" @onclick="@(() => SetSortAsync(LifetimeSortMethod.Iv))">Inventory Visualizer</button>
                    <button type="button" class="tile-group-item @(_sortMethod == LifetimeSortMethod.Count ? "active" : "")" @onclick="@(() => SetSortAsync(LifetimeSortMethod.Count))">Total Count</button>
                    <button type="button" class="tile-group-item @(_sortMethod == LifetimeSortMethod.Random ? "active" : "")" @onclick="@(() => SetSortAsync(LifetimeSortMethod.Random))">Random</button>
                </div>
            </div>
            <div>
                <span class="font-bold text-gray-400">Display</span>
                <div class="flex flex-col gap-1 mt-1">
                    <label><input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_showPerShip" @onchange="ToggleShowPerShipAsync"/> Show 'Average Drops per Ship'</label>
                    @if (_allowExpectedTotals) {
                        <label><input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_showExpectedTotals" @onchange="ToggleExpectedTotalsAsync"/> Show 'Expected Total Drops'</label>
                    }
                </div>
            </div>
        </div>
    };

    private async Task ToggleShowPerShipAsync(ChangeEventArgs e) {
        _showPerShip = e.Value is true;
        await Settings.SetSettingAsync(KeyShowPerShip, _showPerShip ? "true" : "false");
        StateHasChanged();
    }

    private async Task ToggleExpectedTotalsAsync(ChangeEventArgs e) {
        _showExpectedTotals = e.Value is true;
        await Settings.SetSettingAsync(KeyShowExpectedTotals, _showExpectedTotals ? "true" : "false");
        await RecomputeMennoAsync();
        StateHasChanged();
    }

    private async Task SetSortAsync(LifetimeSortMethod method) {
        _sortMethod = method;
        await Settings.SetSettingAsync(KeySortMethod, LifetimeSorter.MethodString(method));
        if (_data is not null) {
            LifetimeSorter.Sort(_data, _sortMethod);
        }

        StateHasChanged();
    }

    public void Dispose() {
        Active.Changed -= OnAccountChanged;
        AppState.Changed -= OnAppStateChanged;
    }

}
