@implements IDisposable
@inject ShipsViewState State

@if (State.AccountId is not null) {
    <div class="sopt">
        <button type="button" class="btn-mini sopt-dialog-btn" aria-haspopup="dialog" aria-label="Edit mission card layout, fields and colors"
                @onclick="OpenCardConfigAsync">
            <Icon Name="pencil"/>
            <span>Design...</span>
        </button>
        @if (State.ViewMode == ShipsViewMode.List) {
            <div>
                <span class="sopt-heading">Display</span>
                <div class="sopt-checks">
                    <label><input type="checkbox" class="ext-opt-check sopt-check" checked="@State.Opts.ViewByDate" @onchange="@(e => State.SetOptAsync(MissionViewOptions.KeyViewByDate, b => State.Opts.ViewByDate = b, e))"/> Separate missions by day</label>
                    <label><input type="checkbox" class="ext-opt-check sopt-check" checked="@State.Opts.ViewMissionTimes" @onchange="@(e => State.SetOptAsync(MissionViewOptions.KeyViewTimes, b => State.Opts.ViewMissionTimes = b, e))"/> Show launch times</label>
                    <label><input type="checkbox" class="ext-opt-check sopt-check" checked="@State.Opts.RecolorDC" @onchange="@(e => State.SetOptAsync(MissionViewOptions.KeyRecolorDC, b => State.Opts.RecolorDC = b, e))"/> Re-color dubcaps</label>
                    <label><input type="checkbox" class="ext-opt-check sopt-check" checked="@State.Opts.RecolorBC" @onchange="@(e => State.SetOptAsync(MissionViewOptions.KeyRecolorBC, b => State.Opts.RecolorBC = b, e))"/> Re-color bugged caps</label>
                </div>
            </div>
        }
        @if (State.ViewMode == ShipsViewMode.Calendar) {
            <div>
                <span class="sopt-heading">Events</span>
                <div class="sopt-checks">
                    <label><input type="checkbox" class="ext-opt-check sopt-check" checked="@State.Opts.CalendarEvents" @onchange="@(e => State.SetOptAsync(MissionViewOptions.KeyCalendarEvents, b => State.Opts.CalendarEvents = b, e))"/> Show events</label>
                    @foreach (var type in GameEventDisplay.CalendarTypes) {
                        <label class="sopt-indent @(State.Opts.CalendarEvents ? "" : "sopt-label-disabled")">
                            <input type="checkbox" class="ext-opt-check sopt-check" checked="@(!State.Opts.CalendarHiddenEventTypes.Contains(type))" disabled="@(!State.Opts.CalendarEvents)" @onchange="@(e => State.SetCalendarEventTypeAsync(type, e))"/>
                            @GameEventDisplay.Title(type, null)
                        </label>
                    }
                </div>
                <label class="sopt-slider @(State.Opts.CalendarEvents ? "" : "sopt-label-disabled")">
                    <span class="sopt-slider-head">
                        <span>Predicted chance at least</span>
                        <span class="sopt-slider-value">@State.Opts.CalendarMinChance%</span>
                    </span>
                    <input type="range" min="0" max="100" step="5" value="@State.Opts.CalendarMinChance" disabled="@(!State.Opts.CalendarEvents)" aria-label="Minimum predicted event chance"
                           @oninput="State.PreviewCalendarMinChance" @onchange="State.SetCalendarMinChanceAsync"/>
                </label>
            </div>
        }
        <div>
            <span class="sopt-heading">Drops Sort Method</span>
            <div class="sopt-row">
                <Segmented T="MissionSortMethod" Options="SortTiles" Selected="State.Opts.SortMethod" SelectedChanged="State.SetSortMethodAsync" Wrap="true" AriaLabel="Drops sort method"/>
            </div>
        </div>
        @if (State.ViewMode == ShipsViewMode.List) {
            <div>
                <span class="sopt-heading">Mission Sort</span>
                <div class="sopt-checks">
                    <label class="@(State.DropCounts.Count == 0 ? "sopt-label-disabled" : "")">
                        <input type="checkbox" class="ext-opt-check sopt-check" checked="@State.Opts.SortByDropCount" disabled="@(State.DropCounts.Count == 0)" @onchange="State.ToggleSortByDropCountAsync"/>
                        Sort by drop count
                    </label>
                </div>
            </div>
        }
    </div>
}

@if (State.AccountId is not null) {
    <MissionCardConfigModal @ref="_cardConfigModal"
                            PresetSet="State.CardPresets"
                            PreviewMission="State.TabFiltered?.FirstOrDefault()"
                            OnSave="State.SaveCardPresetSetAsync"/>
}

@code {
    private static readonly IReadOnlyList<SegmentedOption<MissionSortMethod>> SortTiles = [
        new(MissionSortMethod.Default, "Default"),
        new(MissionSortMethod.Iv, "Inventory Visualizer")
    ];

    private MissionCardConfigModal? _cardConfigModal;

    protected override async Task OnInitializedAsync() {
        State.Changed += OnStateChanged;
        await State.EnsureInitializedAsync(InvokeAsync);
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    private Task OpenCardConfigAsync() {
        return _cardConfigModal?.OpenAsync() ?? Task.CompletedTask;
    }

    public void Dispose() {
        State.Changed -= OnStateChanged;
    }

}
