@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@inject SessionCookieOptions EggIdentitySession
@inject AppConfig Cfg
@inject IdentityApiClient Identity

@if (!string.IsNullOrEmpty(_sessionToken)) {
    <div class="px-2 py-2 text-sm text-gray-400 bg-darker rounded-md tabular-nums overflow-auto">
        <ProfilePanel SessionToken="@_sessionToken" ReturnUrl="@CleanReturnUrl">
            <AvatarTemplate Context="ctx">
                <div class="mt-0_5rem flex items-center gap-3">
                    @if (!string.IsNullOrEmpty(ctx.AvatarUrl)) {
                        <img class="w-14 h-14 rounded-full border border-gray-600" src="@ctx.AvatarUrl" alt="Profile picture"/>
                    } else {
                        <div class="w-14 h-14 rounded-full border border-gray-600 bg-darkest"></div>
                    }
                    <div class="flex flex-col gap-1">
                        <label class="ledger-btn apply-filter-button !mt-0 !mr-0 !ml-0 self-start cursor-pointer">
                            Upload picture
                            <InputFile class="hidden" OnChange="@ctx.OnFileSelected" accept="image/png,image/jpeg,image/webp"/>
                        </label>
                        <span class="text-gray-500 text-xs">PNG, JPEG, or WebP, up to 2 MB.</span>
                        @if (ctx.Error is not null) {
                            <span class="text-red-400 text-xs">@ctx.Error</span>
                        }
                    </div>
                </div>
            </AvatarTemplate>
            <ProvidersTemplate Context="ctx">
                <hr class="mt-0_5rem mb-0_5rem border-gray-700"/>
                @if (ctx.Banner is not null) {
                    <div class="mb-0_5rem text-xs text-gray-500">@ctx.Banner</div>
                }
                <table class="mt-0_5rem w-full text-sm border-collapse">
                    <tbody>
                    @foreach (var item in ctx.Items) {
                        <tr class="border-b border-gray-800 last:border-b-0">
                            <td class="py-1.5 pr-2 w-28">
                                <span class="flex items-center gap-1.5 font-medium text-gray-300">
                                    <img class="w-5 h-5 shrink-0 object-contain" style="filter: brightness(0) invert(1);" src="@Abs(Identity.IconUrl(item.Provider))" alt=""/>
                                    @Cap(item.Provider)
                                </span>
                            </td>
                            @if (item.Identity is { } id) {
                                <td class="py-1.5 px-2 min-w-0">
                                    <span class="flex items-center gap-2 min-w-0">
                                        @if (!string.IsNullOrEmpty(id.Avatar)) {
                                            <button type="button" class="w-5 h-5 rounded-full shrink-0 overflow-hidden border border-transparent hover:border-gray-500"
                                                    data-tt="Use this picture" aria-label="Use this picture" @onclick="item.OnSelectAvatar">
                                                <img class="w-full h-full object-cover" src="@id.Avatar" alt=""/>
                                            </button>
                                        }
                                        <span class="truncate text-gray-400">@(id.Username ?? id.Subject)</span>
                                        <span class="text-xs text-gray-600 shrink-0">@id.LinkedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                    </span>
                                </td>
                                <td class="py-1.5 pl-2 w-20 text-right">
                                    @if (item.CanUnlink) {
                                        <button type="button" class="text-xs px-2 py-1 rounded bg-darkerthandark text-red-300 hover:bg-red-950"
                                                @onclick="item.OnUnlink">
                                            Unlink
                                        </button>
                                    } else {
                                        <span class="text-xs text-gray-600 italic" data-tt="Cannot unlink the last login">Linked</span>
                                    }
                                </td>
                            } else {
                                <td class="py-1.5 px-2 text-gray-600 italic">Not linked</td>
                                <td class="py-1.5 pl-2 w-20 text-right">
                                    <a class="text-xs px-2 py-1 rounded bg-darkerthandark text-privacy_blue hover:bg-dark_tab_hover"
                                       href="@Abs(item.LinkUrl)">
                                        Link
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </ProvidersTemplate>
        </ProfilePanel>

        <hr class="mt-0_5rem mb-0_5rem border-gray-700"/>
        <span class="mr-0_5rem font-bold text-sm text-gray-400 ledger-underline">Preferences</span>
        <div class="mt-0_5rem flex items-end gap-2 flex-wrap">
            <label class="flex flex-col gap-1 text-xs text-gray-500">
                Timezone
                <input type="text" class="bg-darker border border-gray-700 rounded px-2 py-1.5 text-sm text-gray-200 focus:outline-none focus:border-blue-500 w-44"
                       placeholder="e.g. America/New_York" @bind="_timezone" @bind:event="oninput"/>
            </label>
            <label class="flex flex-col gap-1 text-xs text-gray-500">
                Language
                <input type="text" class="bg-darker border border-gray-700 rounded px-2 py-1.5 text-sm text-gray-200 focus:outline-none focus:border-blue-500 w-24"
                       placeholder="e.g. en" @bind="_language" @bind:event="oninput"/>
            </label>
            <button type="button" class="ledger-btn apply-filter-button !w-auto !mt-0 !mr-0 !ml-0" disabled="@_prefsSaving" @onclick="SavePreferencesAsync">
                @(_prefsSaving ? "Saving..." : "Save")
            </button>
            @if (_prefsSaved) {
                <span class="text-xs text-green-400">Saved.</span>
            }
            @if (_prefsError is not null) {
                <span class="text-xs text-red-400">@_prefsError</span>
            }
        </div>
    </div>
}

@code {
    private string _sessionToken = "";
    private string _timezone = "";
    private string _language = "";
    private bool _prefsSaving;
    private bool _prefsSaved;
    private string? _prefsError;

    protected override async Task OnInitializedAsync() {
        _sessionToken = HttpContextAccessor.HttpContext?.Request.Cookies[EggIdentitySession.CookieName] ?? "";
        if (!string.IsNullOrEmpty(_sessionToken)) {
            var profile = await Identity.GetProfileAsync(_sessionToken, CancellationToken.None);
            _timezone = profile?.Timezone ?? "";
            _language = profile?.Language ?? "";
        }
    }

    private async Task SavePreferencesAsync() {
        _prefsSaving = true;
        _prefsSaved = false;
        _prefsError = null;
        try {
            var tz = string.IsNullOrWhiteSpace(_timezone) ? null : _timezone.Trim();
            var lang = string.IsNullOrWhiteSpace(_language) ? null : _language.Trim();
            var ok = await Identity.SetPreferencesAsync(_sessionToken, tz, lang, null, CancellationToken.None);
            _prefsSaved = ok;
            if (!ok) {
                _prefsError = "Could not save preferences.";
            }
        }
        catch (Exception ex) {
            _prefsError = ex.Message;
        }
        finally {
            _prefsSaving = false;
        }
    }

    private static string Cap(string s) {
        return string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];
    }

    private string Abs(string url) {
        return url.StartsWith("http", StringComparison.Ordinal)
            ? url
            : $"{Cfg.IdentityWidgetUrl.TrimEnd('/')}/{url.TrimStart('/')}";
    }

    private string CleanReturnUrl => Nav.GetUriWithQueryParameters(new Dictionary<string, object?> {
        ["linked"] = null,
        ["linkConflict"] = null,
        ["linkRejected"] = null,
        ["linkError"] = null
    });

}
