@using System.Text.RegularExpressions
@inject IndexedDbSettings Settings
@inject FilterState Filters

<div class="fbar @(FillHeight ? "fbar-fill" : "")">
    <FilterBuilder Fields="_fields"
                   Draft="_draft"
                   OpsFor="OpsFor"
                   OptionsFor="OptionsFor"
                   OptionsVersion="_optionsVersion"
                   ValueEditor="PickerEditor"
                   ValueEditorFor="LedgerFilterFields.UsesPicker">
        @if (ShowApply) {
            <hr class="fbar-rule"/>

            <button type="button" class="fbar-apply" disabled="@Applying" @onclick="ApplyAsync">Apply Filter</button>
            @if (Applying) {
                <span class="filter-applying">
                    <img class="filter-applying-spinner" src="@ContentPaths.Asset("images/loading.gif")" alt=""/>
                    Applying filter...
                </span>
            } else if (LastResultText is { Length: > 0 }) {
                <div class="fbar-result">
                    @RenderResultText(LastResultText)
                </div>
            }
        }
    </FilterBuilder>
</div>

@code {
    [Parameter] public FilterViewContext Context { get; set; } = FilterViewContext.Empty;
    [Parameter] public bool Applying { get; set; }
    [Parameter] public string LastResultText { get; set; } = "";
    [Parameter] public EventCallback<FilterSet> OnApply { get; set; }

    [Parameter] public bool ShowApply { get; set; } = true;

    [Parameter] public bool FillHeight { get; set; }

    [Parameter] public FilterSet? Initial { get; set; }

    [Parameter] public bool ReportOps { get; set; }

    private readonly Dictionary<string, List<PickerOption>> _pickerCache = [];
    private FilterDraft _draft = new();
    private FilterViewContext? _bound;
    private IReadOnlyList<FilterFieldDef> _fields = [];
    private PersistedSetting<bool>? _advancedDropsSetting;
    private int _optionsVersion;

    private bool AdvancedDrops => _advancedDropsSetting?.Value ?? false;

    protected override void OnInitialized() {
        BindContext();
    }

    protected override async Task OnInitializedAsync() {
        _advancedDropsSetting = PersistedSetting.Bool(Settings, SettingsModel.KeyAdvancedDropFilter);
        await _advancedDropsSetting.LoadAsync();
    }

    protected override void OnParametersSet() {
        BindContext();
    }

    private void BindContext() {
        if (_bound is { } bound && bound.BindsLike(Context)) {
            _bound = Context;
            return;
        }

        _bound = Context;
        _pickerCache.Clear();
        _fields = Context.IncludeArtifactFields ? LedgerFilterFields.ReportFilterFields : LedgerFilterFields.ReportMissionFields;
        _draft = Filters.Resolve(Context, Initial);
    }

    private IReadOnlyList<FilterOpDef> OpsFor(FilterFieldDef def) =>
        ReportOps ? LedgerFilterFields.ReportOpsFor(def) : LedgerFilterFields.MissionBarOpsFor(def);

    private List<PickerOption> Pickers(FilterFieldDef def) {
        if (_pickerCache.TryGetValue(def.Key, out var cached)) return cached;
        var opts = LedgerFilterFields.PickerOptionsFor(def, Context.Fields, AdvancedDrops);
        _pickerCache[def.Key] = opts;
        return opts;
    }

    private IReadOnlyList<FilterOption> OptionsFor(FilterFieldDef def) => [.. Pickers(def).Select(o => o.ToFilterOption())];

    private RenderFragment<FilterValueEditorContext> PickerEditor => ctx => __builder => {
        var isDrop = ctx.Field.Key == "drops";
        <SearchablePicker Options="Pickers(ctx.Field)"
                          SelectedValue="@(string.IsNullOrEmpty(ctx.Value) ? null : ctx.Value)"
                          Placeholder="Click to select"
                          ImageBasePath="images/"
                          RarityRing="isDrop"
                          OverlayKind="@(isDrop ? "drop" : "target")"
                          Incomplete="ctx.Incomplete"
                          OnSelect="opt => ctx.SetValue(opt.Value)"
                          Footer="@(isDrop ? DropAdvancedFooter : null)"/>
    };

    private static readonly Regex ResultTextPattern = new(
        @"^Filtered in (?<time>[\d.]+)s \((?<shown>\d+) shown, (?<filtered>\d+) filtered out\)$");

    private static RenderFragment RenderResultText(string text) => __builder => {
        var match = ResultTextPattern.Match(text);
        if (!match.Success) {
            <span class="filter-result-badge filter-result-badge-error">@text</span>
            return;
        }

        <span class="filter-result-badge">
            <span class="filter-result-counts">
                <span class="filter-result-shown">@match.Groups["shown"].Value shown</span>
                <span class="filter-result-sep">/</span>
                <span>@match.Groups["filtered"].Value filtered out</span>
            </span>
            <span class="filter-result-time">@match.Groups["time"].Value@("s")</span>
        </span>
    };

    private RenderFragment DropAdvancedFooter => @<label class="fbar-advanced">
                                                     <input type="checkbox" class="ext-opt-check" checked="@AdvancedDrops" @onchange="OnAdvancedDropsToggled"/>
                                                     Advanced (family groupings)
                                                 </label>;

    private async Task OnAdvancedDropsToggled(ChangeEventArgs e) {
        _pickerCache.Remove("drops");
        _optionsVersion++;
        if (_advancedDropsSetting is { } setting) await setting.SetAsync(e.Value is true);
    }

    public FilterSet BuildFilter() => _draft.Complete(_fields, OpsFor);

    private async Task ApplyAsync() {
        await OnApply.InvokeAsync(BuildFilter());
    }

}
