@using System.Globalization
@using EggIdentity.UI
@using Microsoft.AspNetCore.Components.Forms
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager Nav
@inject SessionCookieOptions EggIdentitySession
@inject AppConfig Cfg
@inject IdentityApiClient Identity
@inject ILogger<ProfilePanelHost> Logger

@if (!string.IsNullOrEmpty(_sessionToken)) {
    <div class="prof">
        <ProfilePanel SessionToken="@_sessionToken" ReturnUrl="@CleanReturnUrl">
            <AvatarTemplate Context="ctx">
                <div class="prof-avatar-row">
                    @if (!string.IsNullOrEmpty(ctx.AvatarUrl)) {
                        <img class="prof-avatar" src="@Abs(ctx.AvatarUrl!)" alt="Profile picture"/>
                    } else {
                        <div class="prof-avatar"></div>
                    }
                    <div class="prof-avatar-side">
                        <label class="btn-secondary prof-upload">
                            Upload picture
                            <InputFile class="prof-file" OnChange="@ctx.OnFileSelected" accept="image/png,image/jpeg,image/webp"/>
                        </label>
                        <span class="prof-small">PNG, JPEG, or WebP, up to 2 MB.</span>
                        @if (ctx.Error is not null) {
                            <span class="prof-small prof-err">@ctx.Error</span>
                        }
                    </div>
                </div>
            </AvatarTemplate>
            <ProvidersTemplate Context="ctx">
                <hr class="prof-rule"/>
                @if (ctx.Banner is not null) {
                    <div class="prof-small prof-banner">@ctx.Banner</div>
                }
                <table class="prof-table">
                    <tbody>
                    @foreach (var item in ctx.Items) {
                        <tr class="prof-tr">
                            <td class="prof-td prof-td-provider">
                                <span class="prof-provider">
                                    <img class="prof-provider-icon" src="@Abs(Identity.IconUrl(item.Provider))" alt=""/>
                                    @Cap(item.Provider)
                                </span>
                            </td>
                            @if (item.Identity is { } id) {
                                <td class="prof-td prof-td-id">
                                    <span class="prof-identity">
                                        @if (!string.IsNullOrEmpty(id.Avatar)) {
                                            <button type="button" class="prof-pick"
                                                    data-tt="Use this picture" aria-label="Use this picture" @onclick="item.OnSelectAvatar">
                                                <img class="prof-pick-img" src="@Abs(id.Avatar!)" alt=""/>
                                            </button>
                                        }
                                        <span class="prof-username">@(id.Username ?? id.Subject)</span>
                                        <span class="prof-small prof-dim prof-date">@id.LinkedAt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)</span>
                                    </span>
                                </td>
                                <td class="prof-td prof-td-action">
                                    @if (item.CanUnlink) {
                                        <button type="button" class="prof-chip prof-chip-unlink" @onclick="item.OnUnlink">
                                            Unlink
                                        </button>
                                    } else {
                                        <span class="prof-small prof-dim prof-italic" data-tt="Cannot unlink the last login">Linked</span>
                                    }
                                </td>
                            } else {
                                <td class="prof-td prof-td-id prof-dim prof-italic">Not linked</td>
                                <td class="prof-td prof-td-action">
                                    <a class="prof-chip prof-chip-link" href="@Abs(item.LinkUrl)">
                                        Link
                                    </a>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </ProvidersTemplate>
        </ProfilePanel>

        <hr class="prof-rule"/>
        <span class="prof-heading ledger-underline">Preferences</span>
        <div class="prof-prefs">
            <label class="prof-field">
                Timezone
                <TimeZonePicker @bind-Value="_timezone" Placeholder="Search timezone..."/>
            </label>
            <label class="prof-field">
                Language
                <LanguagePicker @bind-Value="_language" Placeholder="Search language..."/>
            </label>
            <button type="button" class="btn-secondary" disabled="@_prefsSaving" @onclick="SavePreferencesAsync">
                @(_prefsSaving ? "Saving..." : "Save")
            </button>
            @if (_prefsSaved) {
                <span class="prof-small prof-ok">Saved.</span>
            }
            @if (_prefsError is not null) {
                <span class="prof-small prof-err">@_prefsError</span>
            }
        </div>
        <span class="prof-small">Will also take effect in other EggIdentity apps (e.g., EggIncognito).</span>
    </div>
}

@code {
    private string _sessionToken = "";
    private string _timezone = "";
    private string _language = "";
    private bool _prefsSaving;
    private bool _prefsSaved;
    private string? _prefsError;

    protected override async Task OnInitializedAsync() {
        _sessionToken = HttpContextAccessor.HttpContext?.Request.Cookies[EggIdentitySession.CookieName] ?? "";
        if (!string.IsNullOrEmpty(_sessionToken)) {
            var profile = await Identity.GetProfileAsync(_sessionToken, CancellationToken.None);
            _timezone = profile?.Timezone ?? "";
            _language = profile?.Language ?? "";
        }
    }

    private async Task SavePreferencesAsync() {
        _prefsSaving = true;
        _prefsSaved = false;
        _prefsError = null;
        try {
            var tz = string.IsNullOrWhiteSpace(_timezone) ? null : _timezone.Trim();
            var lang = string.IsNullOrWhiteSpace(_language) ? null : _language.Trim();
            var ok = await Identity.SetPreferencesAsync(_sessionToken, tz, lang, null, CancellationToken.None);
            _prefsSaved = ok;
            if (!ok) {
                _prefsError = "Could not save preferences.";
            }
        } catch (Exception ex) {
            Logger.LogDebug(ex, "profile: failed to save preferences");
            _prefsError = ex.Message;
        } finally {
            _prefsSaving = false;
        }
    }

    private static string Cap(string s) {
        return string.IsNullOrEmpty(s) ? s : char.ToUpperInvariant(s[0]) + s[1..];
    }

    private string Abs(string url) {
        return url.StartsWith("http", StringComparison.Ordinal)
            ? url
            : $"{Cfg.IdentityWidgetUrl.TrimEnd('/')}/{url.TrimStart('/')}";
    }

    private string CleanReturnUrl => Nav.GetUriWithQueryParameters(new Dictionary<string, object?> {
        ["linked"] = null,
        ["linkConflict"] = null,
        ["linkRejected"] = null,
        ["linkError"] = null
    });

}
