@using System.Globalization
@* Data-driven stat widgets for the Drops tab: collated from the account's own mission/drop
   history already loaded for the view. Purely presentational; all math lives in DropsWidgetStats. *@

@if (Stats is { MissionCount: > 0 } s) {
    <div class="stat-widget-grid">
        <div class="stat-card">
            <span class="stat-card-label">Overview</span>
            <div class="stat-mini-row">
                <span class="stat-mini-value">@s.MissionCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                <span class="stat-mini-label">missions@(TrackingSince is { Length: > 0 } since ? $" ({since})" : "")</span>
            </div>
            <div class="stat-mini-row">
                <span class="stat-mini-value">@FormatAirtime(s.TotalAirtimeHours)</span>
                <span class="stat-mini-label">total airtime</span>
            </div>
            <div class="stat-mini-row">
                <span class="stat-mini-value">@Pct(s.DubCapCount, s.MissionCount)</span>
                <span class="stat-mini-label">dub-capped</span>
                <span class="stat-mini-value stat-luck-bugged">@Pct(s.BuggedCapCount, s.MissionCount)</span>
                <span class="stat-mini-label">bugged</span>
            </div>
        </div>

        <div class="stat-card stat-card-wide">
            <span class="stat-card-label">Fleet Mix</span>
            @if (TopShip is { } top) {
                <div class="stat-ship-headline">
                    @if (top.ShipEnumString.Length > 0) {
                        <img class="stat-ship-icon" src="@ContentPaths.Asset($"images/ships/{top.ShipEnumString}.png")" alt="@top.ShipName"/>
                    }
                    <div class="stat-ship-headline-text">
                        <span class="stat-card-value-sm">@top.ShipName</span>
                        <span class="stat-card-sub">@top.Count.ToString("N0", CultureInfo.InvariantCulture) launches (@Pct(top.Count, s.MissionCount))</span>
                    </div>
                </div>
            }
            <div class="stat-bar-list">
                @foreach (var ship in s.Ships) {
                    <div class="stat-bar-row">
                        <span class="stat-bar-label" title="@ship.ShipName">@ship.ShipName</span>
                        <span class="stat-bar-track">
                            <span class="stat-bar-fill" style="width: @(Pct(ship.Count, s.MissionCount))"></span>
                        </span>
                        <span class="stat-bar-count">@ship.Count.ToString("N0", CultureInfo.InvariantCulture)</span>
                    </div>
                }
            </div>
        </div>

        <div class="stat-card stat-card-wide">
            <span class="stat-card-label">Mission Mix</span>
            <div class="stat-bar-list">
                @foreach (var d in s.Durations) {
                    <div class="stat-bar-row">
                        <span class="stat-bar-label" title="@d.DurationName">@d.DurationName</span>
                        <span class="stat-bar-track">
                            <span class="stat-bar-fill" style="width: @(Pct(d.Count, s.MissionCount))"></span>
                        </span>
                        <span class="stat-bar-count">@d.Count.ToString("N0", CultureInfo.InvariantCulture)</span>
                    </div>
                }
            </div>
            <span class="stat-split-bar">
                <span class="stat-split-home" style="width: @(Pct(s.HomeCount, s.MissionCount))"></span>
                <span class="stat-split-virtue" style="width: @(Pct(s.VirtueCount, s.MissionCount))"></span>
            </span>
            <div class="stat-split-legend">
                <span><span class="stat-legend-dot stat-legend-home"></span>Home @s.HomeCount.ToString("N0", CultureInfo.InvariantCulture)</span>
                <span><span class="stat-legend-dot stat-legend-virtue"></span>Virtue @s.VirtueCount.ToString("N0", CultureInfo.InvariantCulture)</span>
            </div>
        </div>

        @if (s.ArtifactRarities.Count > 0) {
            <div class="stat-card stat-card-wide">
                <span class="stat-card-label">Artifact Rarity Mix</span>
                <div class="stat-bar-list">
                    @foreach (var r in s.ArtifactRarities) {
                        <div class="stat-bar-row">
                            <span class="stat-bar-label text-rarity-@r.Rarity">@FilterOptions.RarityWord(r.Rarity)</span>
                            <span class="stat-bar-track">
                                <span class="stat-bar-fill stat-bar-fill-rarity-@r.Rarity" style="width: @(Pct(r.Count, TotalArtifactDrops))"></span>
                            </span>
                            <span class="stat-bar-count">@r.Count.ToString("N0", CultureInfo.InvariantCulture)</span>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public DropsWidgetStats? Stats { get; set; }

    private static double NowUnix => DateTimeOffset.UtcNow.ToUnixTimeSeconds();

    private ShipCount? TopShip =>
        Stats?.Ships.Count > 0 && Stats.Ships[0].ShipEnumString.Length > 0 ? Stats.Ships[0] : null;

    private string TrackingSince =>
        Stats is null ? "" : LedgerFormatting.FormatTimeSince(Stats.OldestLaunchDT, NowUnix);

    private int TotalArtifactDrops =>
        Stats?.ArtifactRarities.Sum(r => r.Count) ?? 0;

    private static string Pct(int part, int total) {
        if (total <= 0) {
            return "0%";
        }

        return ((double)part / total).ToString("0%", CultureInfo.InvariantCulture);
    }

    private static string FormatAirtime(double hours) {
        if (hours < 24) {
            return hours.ToString("0.#", CultureInfo.InvariantCulture) + "h";
        }

        var days = (int)(hours / 24);
        var remHours = (int)(hours % 24);
        return remHours > 0 ? $"{days}d {remHours}h" : $"{days}d";
    }

}
