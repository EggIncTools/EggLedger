@inject IExportManagement Exports

@* Lists export file groups per account, prunes to a keep-count, and deletes selected pairs.
   Sizes and counts mirror the Go ExportManagementPanel. *@

<div>
<div class="exm-section exm-section-first">
    <span class="section-heading">Export Pruning</span><br/>
    <div class="exm-body exm-row">
        <label class="exm-text" for="keepCountInput">Keep</label>
        <input id="keepCountInput" type="number" class="number-input exm-keep"
               @bind:get="SettingsModel.FormatInt(_keepCount)" @bind:set="OnKeepCountChangeAsync" min="0" max="50" placeholder="0"/>
        <span class="exm-text">most recent exports per player (0 = unlimited)</span>
    </div>
    @if (PruneFileCount > 0) {
        <div class="exm-body exm-stack">
            <button type="button" class="btn-secondary ledger-btn-warn" disabled="@_pruning" @onclick="PruneNowAsync">
                @(_pruning ? "Pruning..." : "Prune Now")
            </button>
            <span class="exm-note">Removes @PruneFileCount file(s), freeing @FormatSize(PruneBytes)</span>
        </div>
    }
    @if (_pruneError.Length > 0) {
        <div class="exm-err">@_pruneError</div>
    }
</div>

<div class="exm-section">
    <span class="section-heading">Export Files</span><br/>
    @if (_groups.Count == 0) {
        <div class="exm-body exm-note">No export files found.</div>
    } else {
        <div class="exm-files">
            @foreach (var group in _groups) {
                var collapsed = _collapsed.Contains(group.Eid);
                <div class="exm-group">
                    <button type="button" class="exm-group-btn" @onclick="() => ToggleCollapse(group.Eid)">
                        <span class="exm-caret">@(collapsed ? "▶" : "▼")</span>
                        @if (!string.IsNullOrEmpty(group.Nickname)) {
                            <span class="exm-nick @(string.IsNullOrEmpty(group.AccountColor) ? "" : "exm-nick-colored")"
                                  style="@(string.IsNullOrEmpty(group.AccountColor) ? "" : $"--acct-color: #{group.AccountColor}")">
                                @group.Nickname
                            </span>
                        }
                        <EidText Value="@group.Eid" Class="exm-eid"/>
                        <span class="exm-group-meta">@group.Pairs.Count export(s), @FormatSize(GroupSize(group))</span>
                    </button>
                    @if (!collapsed) {
                        <div class="exm-table-wrap">
                            <table class="exm-table">
                                <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>CSV</th>
                                    <th>XLSX</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach (var pair in group.Pairs) {
                                    <tr>
                                        <td>@pair.DisplayDate</td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(pair.CsvPath)) {
                                                <label class="exm-pick">
                                                    <input type="checkbox" class="ext-opt-check"
                                                           checked="@_selected.Contains(pair.CsvPath)"
                                                           @onchange="() => TogglePath(pair.CsvPath)"/>
                                                    <span>@FormatSize(pair.CsvSize)</span>
                                                </label>
                                            } else {
                                                <span class="exm-none">-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(pair.XlsxPath)) {
                                                <label class="exm-pick">
                                                    <input type="checkbox" class="ext-opt-check"
                                                           checked="@_selected.Contains(pair.XlsxPath)"
                                                           @onchange="() => TogglePath(pair.XlsxPath)"/>
                                                    <span>@FormatSize(pair.XlsxSize)</span>
                                                </label>
                                            } else {
                                                <span class="exm-none">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }

            <div class="exm-body exm-row">
                <span class="exm-note-plain">@_selected.Count file(s) selected, @FormatSize(SelectedBytes)</span>
                <button type="button" class="btn-danger" disabled="@(_selected.Count == 0 || _deleting)" @onclick="DeleteSelectedAsync">
                    @(_deleting ? "Deleting..." : "Delete selected")
                </button>
            </div>
            @if (_deleteError.Length > 0) {
                <div class="exm-err">@_deleteError</div>
            }
        </div>
    }
</div>
</div>

@code {
    [Parameter] [EditorRequired] public SettingsModel Model { get; set; } = default!;

    [Parameter] [EditorRequired] public EventCallback<(string Key, string Value)> OnSetting { get; set; }

    private List<ExportGroup> _groups = [];
    private int _keepCount;
    private readonly HashSet<string> _selected = new(StringComparer.Ordinal);
    private readonly HashSet<string> _collapsed = new(StringComparer.Ordinal);
    private bool _pruning;
    private bool _deleting;
    private string _pruneError = "";
    private string _deleteError = "";

    private List<FilePair> ToPrune {
        get {
            if (_keepCount <= 0) return [];

            return [.. _groups.SelectMany(g => g.Pairs.Skip(_keepCount))];
        }
    }

    private int PruneFileCount =>
        ToPrune.Sum(p => (string.IsNullOrEmpty(p.CsvPath) ? 0 : 1) + (string.IsNullOrEmpty(p.XlsxPath) ? 0 : 1));

    private long PruneBytes => ToPrune.Sum(p => p.CsvSize + p.XlsxSize);

    private long SelectedBytes {
        get {
            long total = 0;
            foreach (var g in _groups) {
                foreach (var p in g.Pairs) {
                    if (!string.IsNullOrEmpty(p.CsvPath) && _selected.Contains(p.CsvPath)) total += p.CsvSize;
                    if (!string.IsNullOrEmpty(p.XlsxPath) && _selected.Contains(p.XlsxPath)) total += p.XlsxSize;
                }
            }

            return total;
        }
    }


    private const int MaxKeepCount = 50;

    private static int ClampKeep(int n) {
        return n < 0 ? 0 : n > MaxKeepCount ? MaxKeepCount : n;
    }

    protected override async Task OnInitializedAsync() {
        _keepCount = ClampKeep(Model.ExportKeepCount);
        await LoadFilesAsync();
    }

    private async Task LoadFilesAsync() {
        _groups = await Exports.ListAsync();
        _collapsed.Clear();
        foreach (var g in _groups) _collapsed.Add(g.Eid);
    }

    private static long GroupSize(ExportGroup g) {
        return g.Pairs.Sum(p => p.CsvSize + p.XlsxSize);
    }

    private void ToggleCollapse(string eid) {
        if (!_collapsed.Remove(eid)) _collapsed.Add(eid);
    }

    private void TogglePath(string path) {
        if (!_selected.Remove(path)) _selected.Add(path);
    }

    private async Task OnKeepCountChangeAsync(string? value) {
        int.TryParse(value, out var v);
        _keepCount = ClampKeep(v);
        Model.ExportKeepCount = _keepCount;
        await OnSetting.InvokeAsync((SettingsModel.KeyExportKeepCount, SettingsModel.FormatInt(_keepCount)));
    }

    private async Task PruneNowAsync() {
        _pruning = true;
        _pruneError = "";
        try {
            await Exports.PruneAsync(_keepCount);
            _selected.Clear();
            await LoadFilesAsync();
        } catch (Exception ex) {
            _pruneError = ex.Message;
        } finally {
            _pruning = false;
        }
    }

    private async Task DeleteSelectedAsync() {
        _deleting = true;
        _deleteError = "";
        try {
            await Exports.DeleteAsync(_selected.ToList());
            _selected.Clear();
            await LoadFilesAsync();
        } catch (Exception ex) {
            _deleteError = ex.Message;
        } finally {
            _deleting = false;
        }
    }

    private static string FormatSize(long bytes) {
        return LedgerFormatting.FormatBytes(bytes);
    }

}
