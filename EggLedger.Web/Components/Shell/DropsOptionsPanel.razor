@implements IDisposable
@inject DropsViewState State

@if (State.AccountId is not null) {
    <div class="dopt">
        <div>
            <span class="dopt-heading">Sort Method</span>
            <div class="dopt-row">
                <TileGroup TValue="LifetimeSortMethod" Options="SortTiles" Selected="State.SortMethod" OnSelect="State.SetSortAsync" Wrap="true"/>
            </div>
        </div>
        <div>
            <span class="dopt-heading">Display</span>
            <div class="dopt-checks">
                <label><input type="checkbox" class="ext-opt-check dopt-check" checked="@State.ShowPerShip" @onchange="State.ToggleShowPerShipAsync"/> Show 'Average Drops per Ship'</label>
                @if (State.AllowExpectedTotals) {
                    <label><input type="checkbox" class="ext-opt-check dopt-check" checked="@State.ShowExpectedTotals" @onchange="State.ToggleExpectedTotalsAsync"/> Show 'Expected Total Drops'</label>
                }
            </div>
        </div>
    </div>
}

@code {

    private static readonly IReadOnlyList<TileGroup<LifetimeSortMethod>.Tile> SortTiles = [
        new(LifetimeSortMethod.Default, b => b.AddContent(0, "Default")),
        new(LifetimeSortMethod.Iv, b => b.AddContent(0, "Inventory Visualizer")),
        new(LifetimeSortMethod.Count, b => b.AddContent(0, "Total Count")),
        new(LifetimeSortMethod.Random, b => b.AddContent(0, "Random"))
    ];

    protected override async Task OnInitializedAsync() {
        State.Changed += OnStateChanged;
        await State.EnsureInitializedAsync(InvokeAsync);
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        State.Changed -= OnStateChanged;
    }

}
