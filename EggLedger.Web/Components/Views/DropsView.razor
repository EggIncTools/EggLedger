@implements IDisposable
@inject DropsViewState State

@if (State.AccountId is null) {
    <p class="drops-note">Select an account in the sidebar to view its lifetime data.</p>
} else if (State.Loading && State.Data is null) {
    <div class="drops-skeleton" aria-busy="true" aria-label="Loading lifetime drops">
        @for (var s = 0; s < 3; s++) {
            <span class="skel skel-heading"></span>
            <div class="drops-skeleton-grid">
                @for (var i = 0; i < 12; i++) {
                    <span class="skel skel-tile"></span>
                }
            </div>
        }
    </div>
} else if (State.Data is null || State.Data.MissionCount == 0) {
    <NoDataFallback/>
} else {
    <div class="drops">
        <DropDisplayContainer Artifacts="State.Data.Artifacts"
                              Stones="State.Data.Stones"
                              Ingredients="State.Data.Ingredients"
                              StoneFragments="State.Data.StoneFragments"
                              MennoData="State.MennoData"
                              LifetimeMissionCount="State.Data.MissionCount"
                              ShowPerShip="State.ShowPerShip"
                              LifetimeExpected="@(State.ShowExpectedTotals && State.AllowExpectedTotals)"/>

        <Disclosure Label="Reports" @bind-Open="_widgetsOpen" Class="ledger-section ledger-section-inset">
            @if (State.AccountId is { } accountId) {
                <PinnedReportsStrip AccountId="@accountId" View="@PinnedReportViews.Lifetime"/>
            }
        </Disclosure>
    </div>
}

@code {

    private bool _widgetsOpen = true;

    protected override void OnInitialized() {
        State.Changed += OnStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender) return;
        await Task.Yield();
        await State.EnsureInitializedAsync(InvokeAsync);
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() {
        State.Changed -= OnStateChanged;
    }

}
