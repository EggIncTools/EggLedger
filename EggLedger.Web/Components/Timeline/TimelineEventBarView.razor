@using System.Globalization
@inject IUserTimeZoneProvider TzProvider

<div class="timeline-event-bar timeline-event-@TypeSlug tooltip-host @(Bar.ContinuesLeft ? "timeline-event-cut-l" : "") @(Bar.ContinuesRight ? "timeline-event-cut-r" : "")" style="@BarStyle" data-tt-mode="cursor-x">
    <img class="timeline-event-icon" src="@IconUrl" alt="" loading="lazy" onerror="this.style.display='none'"/>
    <span class="timeline-event-label">@(Bar.Message ?? Bar.Type)</span>
    <div class="tooltip-floating tooltip-fixed text-sm">
        <span class="font-bold">@(Bar.Message ?? Bar.Type)</span>
        @if (Bar.Multiplier > 0) {
            <br/>
            <span class="text-gray-400">Multiplier:</span>
            @MultiplierLabel
        }
        <br/>
        <span class="text-gray-400">Starts:</span> @FormatTime(Bar.StartUnix)<br/>
        <span class="text-gray-400">Ends:</span> @FormatTime(Bar.EndUnix)
        @if (Bar.Ultra) {
            <br/>
            <span class="text-yellow-400">Ultra</span>
        }
    </div>
</div>

@code {

    private static readonly Dictionary<string, string> ColorByType = new(StringComparer.OrdinalIgnoreCase) {
        ["mission-fuel"] = "#8b5cf6",
        ["mission-capacity"] = "#d946ef",
        ["mission-duration"] = "#ec4899"
    };

    [Parameter] public required TimelineEventBar Bar { get; set; }

    private string TypeSlug => Bar.Type.Replace('_', '-').ToLowerInvariant();

    private string MultiplierLabel => Bar.Multiplier.ToString("0.##", CultureInfo.InvariantCulture) + "x";

    private string EventColor => ColorByType.GetValueOrDefault(Bar.Type, "#9ca3af");

    private string IconUrl =>
        FormattableString.Invariant($"/api/v1/event-icon?name={Uri.EscapeDataString(TypeSlug)}{(Bar.Ultra ? "&cc=1" : "")}");

    private string BarStyle =>
        FormattableString.Invariant($"--evt-start:{Bar.LeftPercent};--evt-size:{Bar.WidthPercent};--evt-bg:{EventColor};");

    private string FormatTime(long unixSeconds) {
        return TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds), TzProvider.TimeZone)
            .ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture);
    }

}
