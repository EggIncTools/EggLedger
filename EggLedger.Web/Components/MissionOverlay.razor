@using System.Diagnostics
@using System.Globalization
@using EggIdentity.UI
@inject MissionQueryHandlers Queries
@inject LedgerDataHub Hub
@inject MennoService Menno
@inject IUserTimeZoneProvider TzProvider
@inject ILogger<MissionOverlay> Logger

@* Mission overlay: single mode (prev/next nav) or multi mode (a grid of ship cards).
   Blazor-controlled overlay (full-screen fixed backdrop + centered panel). NOT a native
   <dialog>.showModal(): top-layer promotion desyncs the Blazor Server render tree
   (insertBefore/parentNode-null crashes). Backdrop click closes. *@

<div class="mov-size @SizeClass">
<ModalHost Open="_open" OnClose="Close" Title="Mission Details" OnKeyDown="OnKeyDown" PreventKeyDefault="true"
           Width="ModalWidth.Custom">
    @if (_multi is null) {
        <button class="mov-nav mov-nav-prev" type="button" aria-label="Previous mission"
                disabled="@(_data?.PrevMission is null)"
                @onclick="@(() => NavigateAsync(_data?.PrevMission, PaneDirection.Back))">
            <svg class="mov-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
        <button class="mov-nav mov-nav-next" type="button" aria-label="Next mission"
                disabled="@(_data?.NextMission is null)"
                @onclick="@(() => NavigateAsync(_data?.NextMission, PaneDirection.Forward))">
            <svg class="mov-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </button>
    }

    @if (_multi is null) {
        <div class="mov-body mov-body-scroll">
            <div class="mov-panel">
                @if (_data is not null) {
                    <PaneSwap Key="_data.MissionInfo.MissiondId" Direction="_paneDirection">
                        <ShipDisplay Data="_data" ShowExpectedDrops="ShowExpectedDrops"/>
                    </PaneSwap>
                } else if (_isLoading) {
                    <div class="mov-loading">
                        <img src="@ContentPaths.Asset("images/loading.gif")" alt="Loading..." class="xl-ico"/>
                        <div class="mov-loading-text">Loading mission...</div>
                    </div>
                }
            </div>
        </div>
    } else if (_isLoading) {
        <div class="mov-multi-loading">
            <div class="mov-multi-title">Multi-Mission View Loading</div>
            <hr class="mov-rule"/>
            <img src="@ContentPaths.Asset("images/loading.gif")" alt="Loading..." class="xl-ico"/>
            <div class="mov-loading-text">
                @if (_loadedCount == 0) {
                    <span>Loading drops...</span>
                } else if (_loadedCount >= _totalToLoad) {
                    <span>Combining drops...</span>
                } else {
                    <span>Loading mission</span>
                    <span class="mov-strong">@_loadedCount</span>
                    <span>of</span>
                    <span class="mov-strong">@_totalToLoad</span>
                }
            </div>
            <div class="progress mov-progress">
                <div class="progress-fill" style="--progress: @(LoadingPercent)%;"></div>
            </div>
        </div>
    } else {
        <div class="mov-body">
            <div class="mov-mode-wrap">
                <div class="segmented" role="group" aria-label="Display mode">
                    <button type="button"
                            disabled="@(_multi.Count > MaxSeparate)"
                            title="@(_multi.Count > MaxSeparate ? $"Separate view is limited to {MaxSeparate} missions" : null)"
                            class="segmented-opt @(_displayMode == "separate" ? "active" : "")"
                            @onclick="@(() => _displayMode = "separate")">
                        Separate
                    </button>
                    <button type="button"
                            class="segmented-opt @(_displayMode == "combined" ? "active" : "")"
                            @onclick="@(() => _displayMode = "combined")">
                        Combined
                    </button>
                </div>
            </div>

            <PaneSwap Key="_displayMode" Direction="@(_displayMode == "separate" ? PaneDirection.Back : PaneDirection.Forward)" Class="mov-swap">
            @if (_displayMode == "separate" && _multi.Count <= MaxSeparate) {
                <div class="mov-grid">
                    @foreach (var d in _multi) {
                        <div class="mov-panel">
                            <ShipDisplay Data="d" IsMulti="true" ShowExpectedDrops="ShowExpectedDrops"/>
                        </div>
                    }
                </div>
            } else {
                <div class="mov-combined">
                    <div class="mov-ships">
                        @foreach (var d in _shipHeaderExpanded ? _multi : _multi.Take(20)) {
                            <div class="panel-muted mov-ship">
                                @if (!string.IsNullOrEmpty(d.MissionInfo.ShipEnumString)) {
                                    <img loading="lazy" decoding="async"
                                         src="@ContentPaths.Asset($"images/ships/{d.MissionInfo.ShipEnumString}.png")"
                                         alt="@d.MissionInfo.ShipString" class="mov-ship-img"/>
                                }
                                <div class="mov-ship-name @DurationClass(d.MissionInfo)">@d.MissionInfo.ShipString</div>
                                @if (d.MissionInfo.Level > 0) {
                                    <span class="text-goldenstar mov-small">(@d.MissionInfo.Level★)</span>
                                }
                                <div class="mov-small mov-muted mov-gap">@ShortDate(d.LaunchDT)</div>
                                <div class="mov-small mov-muted">@ShortDate(d.ReturnDT)</div>
                                @if (HasTarget(d.MissionInfo)) {
                                    <div class="mov-small mov-muted mov-gap">@ProperCase(d.MissionInfo.Target.Replace("_", " ", StringComparison.Ordinal))</div>
                                }
                                <div class="mov-small mov-muted mov-cap">
                                    <span>@d.MissionInfo.Capacity</span>
                                    @if (d.MissionInfo.IsBuggedCap) {
                                        <span class="text-buggedcap">0.6x</span>
                                    } else if (d.MissionInfo.IsDubCap) {
                                        <span class="text-dubcap">@d.CapacityModifier.ToString("0.##", CultureInfo.InvariantCulture)x</span>
                                    }
                                </div>
                            </div>
                        }
                        @if (!_shipHeaderExpanded && _multi.Count > 20) {
                            <button type="button" class="panel-muted mov-ship mov-more" @onclick="@(() => _shipHeaderExpanded = true)">
                                + @(_multi.Count - 20) more
                            </button>
                        }
                    </div>
                    <DropDisplayContainer Artifacts="_combinedArtifacts"
                                          Stones="_combinedStones"
                                          Ingredients="_combinedIngredients"
                                          StoneFragments="_combinedStoneFragments"
                                          ShowExpectedDrops="false"/>
                </div>
            }
            </PaneSwap>

            <div class="mov-tip">
                Hover mouse over an item to show details.<br/>
                Click to open the relevant
                <a class="ledger-underline" target="_blank" rel="noopener" href="https://wasmegg-carpet.netlify.app/artifact-explorer/">artifact explorer</a>
                page.
            </div>
        </div>
    }
</ModalHost>
</div>

@code {
    [Parameter] public string? AccountId { get; set; }

    [Parameter] public IReadOnlyList<DatabaseMission> FilteredMissions { get; set; } = Array.Empty<DatabaseMission>();

    [Parameter] public MissionSortMethod SortMethod { get; set; } = MissionSortMethod.Default;
    [Parameter] public bool ShowExpectedDrops { get; set; }
    private const int MaxSeparate = 20;
    private bool _open;
    private ViewMissionData? _data;
    private List<ViewMissionData>? _multi;
    private bool _isLoading;
    private int _loadedCount;
    private int _totalToLoad;
    private string _displayMode = "separate";
    private bool _shipHeaderExpanded;
    private PaneDirection _paneDirection = PaneDirection.None;
    private List<DropLike> _combinedArtifacts = [];
    private List<DropLike> _combinedStones = [];
    private List<DropLike> _combinedIngredients = [];
    private List<DropLike> _combinedStoneFragments = [];

    private int LoadingPercent =>
        _totalToLoad > 0 ? Math.Min(100, (int)(_loadedCount / (double)_totalToLoad * 100)) : 0;

    private static readonly TimeSpan ProgressInterval = TimeSpan.FromMilliseconds(100);

    private string SizeClass =>
        _multi is null ? "mov-size-single" : _isLoading ? "mov-size-loading" : "mov-size-multi";

    public async Task OpenAsync(string missionId) {
        _multi = null;
        _isLoading = false;
        _paneDirection = PaneDirection.None;
        _data = await BuildAsync(missionId);
        if (_data is null) return;

        _open = true;
        StateHasChanged();
        await PopulateMennoForAsync(missionId);
    }

    private async Task OnKeyDown(KeyboardEventArgs e) {
        switch (e.Key) {
            case "ArrowLeft" when _multi is null:
                await NavigateAsync(_data?.PrevMission, PaneDirection.Back);
                break;
            case "ArrowRight" when _multi is null:
                await NavigateAsync(_data?.NextMission, PaneDirection.Forward);
                break;
        }
    }

    public async Task OpenMultiAsync(IReadOnlyList<string> missionIds) {
        List<ViewMissionData> multi = [];
        _open = true;
        _data = null;
        _multi = multi;
        _isLoading = true;
        _loadedCount = 0;
        _totalToLoad = missionIds.Count;
        _shipHeaderExpanded = false;
        _displayMode = _totalToLoad > MaxSeparate ? "combined" : "separate";
        StateHasChanged();
        await Task.Yield();

        var byId = new Dictionary<string, DatabaseMission>(FilteredMissions.Count, StringComparer.Ordinal);
        foreach (var m in FilteredMissions) byId.TryAdd(m.MissiondId, m);
        var bulk = AccountId is null ? null : await Hub.GetDropsAsync(AccountId);
        long lastRender = Stopwatch.GetTimestamp();

        foreach (var id in missionIds) {
            if (_multi != multi) return;
            if (byId.TryGetValue(id, out var mission)) {
                var drops = bulk is not null && bulk.TryGetValue(id, out var cached) && cached.Count > 0
                    ? cached
                    : AccountId is null ? null : await Queries.GetShipDropsAsync(AccountId, id);
                var data = MissionDetailBuilder.BuildBase(mission, drops ?? [], FilteredMissions, false, TzProvider.TimeZone);
                MissionDetailBuilder.ApplySortMethod(data, SortMethod);
                multi.Add(data);
            }

            _loadedCount++;
            if (Stopwatch.GetElapsedTime(lastRender) >= ProgressInterval) {
                StateHasChanged();
                await Task.Yield();
                lastRender = Stopwatch.GetTimestamp();
            }
        }

        if (_multi != multi) return;
        StateHasChanged();
        await Task.Yield();

        RebuildCombined();
        _isLoading = false;
        StateHasChanged();

        if (multi.Count > MaxSeparate) return;
        foreach (var data in multi) await PopulateMennoAsync(data.MissionInfo, data);
        StateHasChanged();
    }


    private void RebuildCombined() {
        RebuildCombined(SortMethod);
    }

    private void RebuildCombined(MissionSortMethod method) {
        if (_multi is null) return;

        Func<IEnumerable<DropLike>, List<DropLike>> sortFn = method == MissionSortMethod.Iv
            ? DropSorter.InventoryVisualizerSort
            : DropSorter.SortGroupAlreadyCombed;
        _combinedArtifacts = sortFn(LifetimeAggregator.MergeDropArrays(_multi.Select(m => (IReadOnlyList<DropLike>)m.Artifacts)));
        _combinedStones = sortFn(LifetimeAggregator.MergeDropArrays(_multi.Select(m => (IReadOnlyList<DropLike>)m.Stones)));
        _combinedIngredients = sortFn(LifetimeAggregator.MergeDropArrays(_multi.Select(m => (IReadOnlyList<DropLike>)m.Ingredients)));
        _combinedStoneFragments = sortFn(LifetimeAggregator.MergeDropArrays(_multi.Select(m => (IReadOnlyList<DropLike>)m.StoneFragments)));
    }

    public async Task ReSortAsync(MissionSortMethod method) {
        if (!_open) return;
        if (_data is not null) MissionDetailBuilder.ApplySortMethod(_data, method);

        if (_multi is not null) {
            foreach (var d in _multi) MissionDetailBuilder.ApplySortMethod(d, method);

            RebuildCombined(method);
        }

        StateHasChanged();
        await Task.CompletedTask;
    }

    private async Task LoadAsync(string missionId) {
        _data = await BuildAsync(missionId);
        _isLoading = false;
        StateHasChanged();
        await PopulateMennoForAsync(missionId);
    }

    private async Task PopulateMennoForAsync(string missionId) {
        if (_data is null) return;

        var mission = FindMission(missionId);
        if (mission is not null) {
            await PopulateMennoAsync(mission, _data);
            StateHasChanged();
        }
    }

    private async Task<ViewMissionData?> BuildAsync(string missionId) {
        var mission = FindMission(missionId);
        if (mission is null) return null;

        var drops = AccountId is null
            ? null
            : await Queries.GetShipDropsAsync(AccountId, missionId);

        var data = MissionDetailBuilder.BuildBase(
            mission,
            drops ?? new List<MissionDrop>(),
            FilteredMissions,
            true,
            TzProvider.TimeZone);
        MissionDetailBuilder.ApplySortMethod(data, SortMethod);
        return data;
    }

    private async Task PopulateMennoAsync(DatabaseMission mission, ViewMissionData data) {
        if (!ShowExpectedDrops) return;

        try {
            await Menno.EnsureLoadedAsync();
        } catch (Exception ex) {
            Logger.LogDebug(ex, "menno data load for expected drops failed");
            return;
        }

        var (ship, duration, level, target) = MissionDetailBuilder.MennoParams(mission);
        var configs = Menno.GetData(ship, duration, level, target);
        var total = 0;
        foreach (var c in configs) total += c.TotalDrops;

        data.MennoData = new MissionMennoData { Configs = configs, TotalDropsCount = total };
    }

    private DatabaseMission? FindMission(string missionId) {
        foreach (var m in FilteredMissions) {
            if (m.MissiondId == missionId) return m;
        }

        return null;
    }

    private async Task NavigateAsync(string? missionId, PaneDirection direction) {
        if (missionId is not null) {
            _paneDirection = direction;
            await LoadAsync(missionId);
        }
    }

    private void Close() {
        _open = false;
        _data = null;
        _multi = null;
        _isLoading = false;
        _shipHeaderExpanded = false;
        _combinedArtifacts = [];
        _combinedStones = [];
        _combinedIngredients = [];
        _combinedStoneFragments = [];
    }

    private static string ShortDate(DateTime dt) {
        return dt.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    private static bool HasTarget(DatabaseMission m) {
        return m.Target.Length > 0 && !string.Equals(m.Target, "UNKNOWN", StringComparison.OrdinalIgnoreCase);
    }

    private static string DurationClass(DatabaseMission m) {
        return m.DurationType is { } d
            ? "text-duration-" + Convert.ToInt32(d, CultureInfo.InvariantCulture)
            : "text-duration-3";
    }

    private static string ProperCase(string value) {
        return NameFormatting.ProperCase(value);
    }

}
