@typeparam TValue

<div class="tiles @(Wrap ? "tiles-wrap" : "")">
    @foreach (var option in Options) {
        var active = EqualityComparer<TValue>.Default.Equals(option.Value, Selected);
        <button type="button" class="tiles-item @(active ? "tiles-item-active" : "") @(option.Disabled ? "tiles-item-disabled" : "")"
                title="@option.Title"
                @onclick="() => Select(option)">
            @option.Label
        </button>
    }
</div>

@code {
    public sealed record Tile(TValue Value, RenderFragment Label, bool Disabled = false, string? Title = null);

    [Parameter, EditorRequired] public IReadOnlyList<Tile> Options { get; set; } = [];
    [Parameter] public TValue? Selected { get; set; }
    [Parameter] public EventCallback<TValue> OnSelect { get; set; }
    [Parameter] public bool Wrap { get; set; }

    private Task Select(Tile option) {
        return option.Disabled ? Task.CompletedTask : OnSelect.InvokeAsync(option.Value);
    }
}
