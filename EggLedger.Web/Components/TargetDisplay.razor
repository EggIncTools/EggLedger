@* Target artifact icon for a mission, or nothing when empty / UNKNOWN. *@

@if (_path is not null) {
    <img loading="lazy" decoding="async" src="@_path" alt="@_alt" class="target-ico"/>
}

@code {
    [Parameter] public string? Target { get; set; }
    private string? _path;
    private string _alt = "";

    protected override void OnParametersSet() {
        (_path, _alt) = TargetImagePaths.Resolve(Target);
    }

}
