@inject IUserTimeZoneProvider TzProvider
@inject TimeProvider Time

<AdminPanel Title="@PanelTitle">
    <HeadTools>
        @if (Users is { Count: > 0 }) {
            <span class="usradm-summary">@Users.Sum(u => u.MissionCount) missions - @LedgerFormatting.FormatBytes(Users.Sum(u => u.StorageBytes)) total</span>
        }
    </HeadTools>
    <ChildContent>
        <div>
            @if (Users is null) {
                <p class="usradm-note">Loading...</p>
            } else {
                <div class="usradm-scroll">
                    <table class="data-table usradm-table">
                        <thead>
                        <tr>
                            <th>@SortHeader("User", "username")</th>
                            <th>@SortHeader("Linked Discord", "discord")</th>
                            <th class="usradm-num">@SortHeader("Missions", "missions")</th>
                            <th class="usradm-num">@SortHeader("Reports", "reports")</th>
                            <th class="usradm-num">@SortHeader("Backups", "backups")</th>
                            <th class="usradm-num">@SortHeader("Storage", "storage")</th>
                            <th class="usradm-num"><Tooltip Lines="LastPairingHeadLines">@SortHeader("Last Pairing", "lastLogin")</Tooltip></th>
                            <th></th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var u in SortedUsers()) {
                            <tr>
                                <td class="usradm-name">@u.Username @(u.IsAdmin ? "(admin)" : "")</td>
                                <td class="usradm-id">@(u.DiscordId ?? "none")</td>
                                <td class="usradm-num">@u.MissionCount</td>
                                <td class="usradm-num">@u.ReportCount</td>
                                <td class="usradm-num">@u.BackupCount</td>
                                <td class="usradm-num">@LedgerFormatting.FormatBytes(u.StorageBytes)</td>
                                <td class="usradm-num usradm-dim"><Tooltip Lines="LastLoginLines(u.LastSession)" Focusable="true">@LastLoginLabel(u.LastSession)</Tooltip></td>
                                <td class="usradm-num">
                                    @if (!u.IsAdmin) {
                                        <button type="button" class="usradm-delete" @onclick="() => OnDelete.InvokeAsync(u.UserId)">
                                            Delete
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            @if (!string.IsNullOrEmpty(Error)) {
                <p class="usradm-error">@Error</p>
            }
        </div>
    </ChildContent>
</AdminPanel>

@code {
    [Parameter] public IReadOnlyList<AdminUser>? Users { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public string? Error { get; set; }

    private string PanelTitle => $"Users ({(Users is null ? "..." : Users.Count.ToString())})";

    private string _sortKey = "username";
    private bool _sortAsc = true;

    private void SetSort(string key) {
        if (_sortKey == key) {
            _sortAsc = !_sortAsc;
        } else {
            _sortKey = key;
            _sortAsc = true;
        }
    }

    private RenderFragment SortHeader(string label, string key) => __builder => {
        <button type="button" class="usradm-sort" @onclick="() => SetSort(key)">
            @label
            @if (_sortKey == key) {
                @(_sortAsc ? " ^" : " v")
            }
        </button>
    };

    private List<AdminUser> SortedUsers() {
        if (Users is null) return [];
        var ordered = _sortKey switch {
            "discord" => Order(u => u.DiscordId ?? ""),
            "missions" => Order(u => u.MissionCount),
            "reports" => Order(u => u.ReportCount),
            "backups" => Order(u => u.BackupCount),
            "storage" => Order(u => u.StorageBytes),
            "lastLogin" => Order(u => u.LastSession ?? 0),
            _ => Order(u => u.Username)
        };
        return ordered.ToList();
    }

    private IOrderedEnumerable<AdminUser> Order<TKey>(Func<AdminUser, TKey> selector) =>
        _sortAsc ? Users!.OrderBy(selector) : Users!.OrderByDescending(selector);

    private string LastLoginLabel(long? lastSession) =>
        lastSession is { } s ? LedgerFormatting.FormatTimeSince(s, Time.GetUtcNow().ToUnixTimeSeconds()) : "no pairing";

    private static readonly IReadOnlyList<TooltipLine> LastPairingHeadLines = [
        new("Last pairing", Head: true),
        new("Last time the desktop app paired via Discord"),
        new("Not tracked for web-only logins")
    ];

    private IReadOnlyList<TooltipLine> LastLoginLines(long? lastSession) =>
        lastSession is { } s
            ? [new("Last pairing", Head: true), new(TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(s), TzProvider.TimeZone).ToString("yyyy-MM-dd HH:mm"))]
            : [new("Never paired", Head: true), new("The desktop app has not paired via Discord for this user.")];

}
