<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Description>EggLedger Blazor Server host. Runs the EggLedger.Web RCL UI server-side over a SignalR circuit, so decode and crypto use native APIs (no /decode wire). Folds in the sync server in later migration phases.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggLedger.Web\EggLedger.Web.csproj" />
    <ProjectReference Include="..\EggLedger.Domain\EggLedger.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EggIdentity.Auth" />
    <PackageReference Include="EggIdentity.Bot" />
    <PackageReference Include="EggIdentity.Bot.AdminUi" />
    <PackageReference Include="EggIdentity.Contract" />
    <PackageReference Include="EggIdentity.Db" />
    <PackageReference Include="EggIdentity.Fallback" />
    <PackageReference Include="EggIdentity.AdminUi" />
    <PackageReference Include="EggIdentity.Client" />
    <PackageReference Include="EggIdentity.Metrics" />
    <PackageReference Include="EggIdentity.Metrics.AdminUi" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggLedger.Web.Server.Tests" />
  </ItemGroup>

</Project>
