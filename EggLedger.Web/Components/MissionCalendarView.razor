@inject IUserTimeZoneProvider TzProvider
@inject GameEventsService GameEvents
@inject TimeProvider Time
@using System.Globalization
@using EggIdentity.UI

<div class="mcal mcal-cards">
    <div class="mcal-bar">
        @LeadingControls
        <div class="mcal-center">
            <CalendarRangePicker TZoom="TimelineZoom"
                                 AvailableZooms="Zooms"
                                 Zoom="_zoom"
                                 ZoomLabel="TimelineZoomExtensions.Label"
                                 RangeLabel="@RangeLabel"
                                 DateValue="@LocalCenterDate"
                                 PrevDisabled="@(!_canPanPrev)"
                                 NextDisabled="@(!_canPanNext)"
                                 ZoomChanged="SetZoom"
                                 OnPan="Pan"
                                 OnToday="JumpToNow"
                                 DateChanged="JumpToDate"/>
            <Tooltip Lines="@AirtimeTooltip" Class="airtime-stat" PopClass="airtime-tt" Focusable="true">
                <span class="airtime-label">Airtime</span>
                @if (_flightSlices is not { Count: > 0 } slices) {
                    <RatioChip/>
                } else if (slices.Count == 1) {
                    <RatioChip Ratio="slices[0].Ratio" Digits="1"/>
                } else {
                    @foreach (var slice in slices) {
                        <RatioChip Ratio="slice.Ratio" Digits="1" Label="@(slice.IsVirtue ? "Virtue" : "Home")"/>
                    }
                }
                @if (FilteredOutRatio is { } filteredOut) {
                    <RatioChip Ratio="filteredOut" Digits="1" Label="Filtered out" Muted="true"/>
                }
            </Tooltip>
        </div>
    </div>

    <div class="timeline-shell timeline-view-@ZoomClass">
        <div class="timeline-scale">
            @if (_zoom == TimelineZoom.Day) {
                @foreach (var tick in CurrentHourTicks) {
                    if (tick.Label.Length > 0) {
                        <span class="timeline-scale-label" style="@TickStyle(tick.LeftPercent)">@tick.Label</span>
                    }
                }
            } else {
                @for (var i = 0; i < WeekHeaderLabels.Length; i++) {
                    <span class="timeline-scale-label" style="@TickStyle(WeekHeaderPositions[i])">@WeekHeaderLabels[i]</span>
                }
            }
        </div>
        <CalendarGrid TItem="object"
                      @ref="_grid"
                      Periods="_periods"
                      LaneGroups="_laneGroups"
                      ShowHourTicks="@(_zoom == TimelineZoom.Day)"
                      OnCommitScrollPan="OnCommitScrollPan"/>
    </div>
    <div class="mcal-agenda">
        <MissionAgendaView Missions="_merged"
                           Events="_overlayEvents"
                           WindowStart="_visibleStart"
                           WindowEnd="_visibleEnd"
                           RecolorDC="RecolorDC"
                           RecolorBC="RecolorBC"
                           Template="Templates.For(CardSlot.Agenda)"
                           DataFor="DataFor"
                           OnSelect="OnSelectMission"/>
    </div>
</div>

@if (_showStillFlying) {
    <dialog open class="mcal-flying">
        <div class="mcal-flying-body">
            <span class="mcal-flying-title">Still flying</span>
            <span class="mcal-flying-text">This mission has not returned yet. Drops show up after it lands and you fetch again.</span>
            <button type="button" class="toggle-link mcal-flying-close" @onclick="CloseStillFlying">Close</button>
        </div>
    </dialog>
}

@code {
    private static readonly string[] WeekHeaderLabels = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
    private static readonly double[] WeekHeaderPositions = [100.0 * 6 / 168, 100.0 * 24 / 168, 100.0 * 48 / 168, 100.0 * 72 / 168, 100.0 * 96 / 168, 100.0 * 120 / 168, 100.0 * 144 / 168, 100.0 * 162 / 168];
    private static readonly TimelineZoom[] Zooms = [TimelineZoom.Day, TimelineZoom.Week, TimelineZoom.Month];

    [Parameter] public IReadOnlyList<DatabaseMission> Missions { get; set; } = Array.Empty<DatabaseMission>();
    [Parameter] public IReadOnlyList<DatabaseMission> InFlightMissions { get; set; } = Array.Empty<DatabaseMission>();
    [Parameter] public IReadOnlyList<DatabaseMission> AllMissions { get; set; } = Array.Empty<DatabaseMission>();
    [Parameter] public bool HasActiveFilter { get; set; }
    [Parameter] public bool RecolorDC { get; set; }
    [Parameter] public bool RecolorBC { get; set; }
    [Parameter] public bool ShowEvents { get; set; } = true;
    [Parameter] public IReadOnlySet<string> HiddenEventTypes { get; set; } = new HashSet<string>();
    [Parameter] public int MinEventChance { get; set; }
    [Parameter] public CardTemplateSet Templates { get; set; } = CardTemplateSet.Default;
    [Parameter] public Func<DatabaseMission, MissionCardData>? DataFor { get; set; }
    [Parameter] public EventCallback<string> OnViewMission { get; set; }
    [Parameter] public RenderFragment? LeadingControls { get; set; }

    private TimelineZoom _zoom = TimelineZoom.Month;
    private DateTimeOffset _center;
    private DateTimeOffset _visibleStart;
    private DateTimeOffset _visibleEnd;
    private List<PeriodSlot<object>> _periods = [];
    private LaneGroupDef<object>[] _laneGroups = [];
    private IReadOnlyList<TimelineTick> _centerHourTicks = [];
    private List<DatabaseMission> _merged = [];
    private HashSet<string> _noDataIds = [];
    private IReadOnlyList<GameEvent> _overlayEvents = [];
    private IReadOnlyList<FlightRatioSlice>? _flightSlices;
    private IReadOnlyList<FlightRatioSlice>? _flightSlicesAll;
    private IReadOnlyList<double>? _occupancyHours;
    private bool _canPanPrev = true;
    private bool _canPanNext = true;
    private bool _showStillFlying;
    private string? _hoveredMissionId;

    private CalendarGrid<object>? _grid;
    private bool _resetScrollPending;

    private RenderFragment<object> EventItemTemplate => item => @<TimelineEventBarView Bar="((TimelineEventBar)item)"/>;

    private RenderFragment<object> MissionItemTemplate => item =>
        @<TimelineBarView Bar="((TimelineBar)item)"
                          Template="BarTemplate"
                          Data="@(DataFor?.Invoke(((TimelineBar)item).Mission))"
                          RecolorDC="RecolorDC"
                          RecolorBC="RecolorBC"
                          OnSelect="OnSelectMission"
                          IsLinkedHover="@(((TimelineBar)item).MissionId == _hoveredMissionId)"
                          OnHoverMissionId="SetHoveredMissionId"/>;

    private string ZoomClass => _zoom.ToString().ToLowerInvariant();

    private CardTemplate BarTemplate => Templates.For(_zoom switch {
        TimelineZoom.Day => CardSlot.CalendarDay,
        TimelineZoom.Week => CardSlot.CalendarWeek,
        _ => CardSlot.CalendarMonth
    });

    private int VisibleSlots => _zoom == TimelineZoom.Month ? 5 : 1;

    private int StripSlots => VisibleSlots + 2;

    private int CenterSlot => _zoom == TimelineZoom.Month ? StripSlots - 2 : StripSlots / 2;

    private IReadOnlyList<TimelineTick> CurrentHourTicks => _centerHourTicks;

    protected override void OnInitialized() {
        _center = Time.GetUtcNow();
        _laneGroups = [
            new LaneGroupDef<object>(EventItemTemplate, LaneMinRem: 2.3, LaneGapRem: 0.15, HeaderRem: 0),
            new LaneGroupDef<object>(MissionItemTemplate, LaneMinRem: 1.65, LaneGapRem: 0.15, HeaderRem: 0),
        ];

        if (GameEvents.IsConfigured) _ = LoadEventsAsync();
    }

    private async Task LoadEventsAsync() {
        await GameEvents.EnsureLoadedAsync();
        await InvokeAsync(() => {
            Recompute();
            StateHasChanged();
        });
    }

    protected override void OnParametersSet() {
        Recompute();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (!firstRender && _resetScrollPending && _grid is not null) {
            _resetScrollPending = false;
            await _grid.ResetScrollAsync();
        }
    }

    private async Task OnCommitScrollPan(int direction) {
        if (CanPan(direction)) {
            _center += (_visibleEnd - _visibleStart) * direction;
            Recompute();
            return;
        }

        if (_grid is not null) await _grid.ResetScrollAsync();
    }

    private void Recompute() {
        var tz = TzProvider.TimeZone;
        (_visibleStart, _visibleEnd) = TimelineWindow.Compute(_center, _zoom, tz);
        _center = _visibleStart + (_visibleEnd - _visibleStart) / 2;

        var dbIds = new HashSet<string>(Missions.Select(m => m.MissiondId), StringComparer.Ordinal);
        var inFlight = HasActiveFilter
            ? []
            : InFlightMissions.Where(m => !dbIds.Contains(m.MissiondId)).ToList();
        _noDataIds = inFlight.Select(m => m.MissiondId).ToHashSet(StringComparer.Ordinal);
        _merged = Missions.Concat(inFlight).ToList();
        _overlayEvents = ShowEvents ? OverlayEvents() : [];

        var now = Time.GetUtcNow();
        var statsStart = _zoom == TimelineZoom.Month ? _visibleStart.AddDays(-7 * (VisibleSlots - 1)) : _visibleStart;
        _flightSlices = TimelineFlightRatio.ComputeByFarm(_merged, statsStart, _visibleEnd, now);
        _occupancyHours = TimelineFlightRatio.OccupancyHours(_merged, statsStart, _visibleEnd, now);

        if (HasActiveFilter) {
            var allDbIds = new HashSet<string>(AllMissions.Select(m => m.MissiondId), StringComparer.Ordinal);
            var allInFlight = InFlightMissions.Where(m => !allDbIds.Contains(m.MissiondId)).ToList();
            var mergedAll = AllMissions.Concat(allInFlight).ToList();
            _flightSlicesAll = TimelineFlightRatio.ComputeByFarm(mergedAll, statsStart, _visibleEnd, now);
        } else {
            _flightSlicesAll = null;
        }

        UpdatePanBounds(tz);

        var windows = new List<(DateTimeOffset Start, DateTimeOffset End)> { (_visibleStart, _visibleEnd) };
        for (var i = 0; i < CenterSlot; i++) windows.Insert(0, TimelineWindow.Compute(windows[0].Start.AddHours(-1), _zoom, tz));
        for (var i = 0; i < StripSlots - 1 - CenterSlot; i++) windows.Add(TimelineWindow.Compute(windows[^1].End.AddHours(1), _zoom, tz));

        var center = CenterSlot;
        _centerHourTicks = [];
        _periods = windows
            .Select((w, index) => BuildPeriod(w.Start, w.End, index == center, tz, now))
            .ToList();
    }

    private IReadOnlyList<GameEvent> OverlayEvents() {
        bool Shown(GameEvent e) =>
            GameEventDisplay.CalendarTypes.Contains(e.Type, StringComparer.OrdinalIgnoreCase) && !HiddenEventTypes.Contains(e.Type);

        var observed = GameEvents.Snapshot().Where(Shown).ToList();
        var observedUntil = observed.Count == 0 ? 0 : observed.Max(e => e.EndTimestamp);
        double minChance = MinEventChance / 100.0;
        var predicted = GameEvents.Predictions()
            .Where(p => Shown(p) && p.StartTimestamp >= observedUntil && (p.Confidence ?? 1) >= minChance);
        return [.. observed, .. predicted];
    }

    private PeriodSlot<object> BuildPeriod(DateTimeOffset start, DateTimeOffset end, bool isCenter, TimeZoneInfo tz, DateTimeOffset now) {
        int? primaryMonth = _zoom == TimelineZoom.Month ? TimeZoneInfo.ConvertTime(_center, tz).Month : null;
        var timelineRows = TimelineRows.Build(_zoom, start, end);
        if (isCenter && _zoom == TimelineZoom.Day && timelineRows.Count > 0) _centerHourTicks = TimelineTicks.HourTicks(timelineRows[0].Start, timelineRows[0].End, tz);

        var rows = timelineRows.Select(row => BuildRow(row, tz, now, primaryMonth)).ToList();
        return new PeriodSlot<object>(rows, start.UtcTicks);
    }

    private CalendarRow<object> BuildRow(TimelineRow row, TimeZoneInfo tz, DateTimeOffset now, int? primaryMonth) {
        var bars = TimelineLayoutEngine.Layout(_merged, row.Start, row.End, now, MinWidthPercent, _noDataIds);
        var cells = _zoom == TimelineZoom.Day
            ? Array.Empty<TimelineDayCell>()
            : TimelineTicks.DayCells(row.Start, row.End, primaryMonth);
        var hourTicks = _zoom == TimelineZoom.Day
            ? TimelineTicks.HourTicks(row.Start, row.End, tz)
            : Array.Empty<TimelineTick>();
        double? nowPercent = now > row.Start && now < row.End
            ? (now - row.Start).TotalSeconds / (row.End - row.Start).TotalSeconds * 100
            : null;
        var eventBars = TimelineLayoutEngine.LayoutEvents(_overlayEvents, row.Start, row.End);

        var cellLabels = cells.Select(c => new CalendarCellLabel(c.LeftPercent, CellLabel(c), c.Muted)).ToList();
        var gridLines = _zoom == TimelineZoom.Day
            ? Array.Empty<double>()
            : cells.Where(c => c.LeftPercent > 0).Select(c => c.LeftPercent).ToArray();
        var hourTickPositions = hourTicks.Select(t => t.LeftPercent).ToList();

        var eventLanes = ToObjectLanes(GroupLanes(eventBars, b => b.Lane));
        var missionLanes = ToObjectLanes(GroupLanes(bars, b => b.Lane));
        if (missionLanes.Count == 0) missionLanes = [Array.Empty<object>()];

        return new CalendarRow<object>(
            cellLabels,
            gridLines,
            hourTickPositions,
            nowPercent,
            [
                new CalendarLaneGroupRow<object>(eventLanes),
                new CalendarLaneGroupRow<object>(missionLanes),
            ]);
    }

    private double MinWidthPercent => _zoom == TimelineZoom.Day ? 1.2 : 2.5;

    private static List<List<T>> GroupLanes<T>(IReadOnlyList<T> items, Func<T, int> laneOf) {
        var byLane = new Dictionary<int, List<T>>();
        foreach (var item in items) {
            var lane = laneOf(item);
            if (!byLane.TryGetValue(lane, out var list)) {
                list = [];
                byLane[lane] = list;
            }

            list.Add(item);
        }

        return byLane.OrderBy(kv => kv.Key).Select(kv => kv.Value).ToList();
    }

    private static List<IReadOnlyList<object>> ToObjectLanes<T>(List<List<T>> lanes) where T : notnull {
        return lanes.Select(lane => (IReadOnlyList<object>)lane.Cast<object>().ToList()).ToList();
    }

    private string CellLabel(TimelineDayCell cell) {
        return _zoom == TimelineZoom.Month
            ? cell.LocalDate.Day.ToString(CultureInfo.InvariantCulture)
            : cell.LocalDate.ToString("M/d", CultureInfo.InvariantCulture);
    }

    private string LocalCenterDate =>
        TimeZoneInfo.ConvertTime(_center, TzProvider.TimeZone).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string RangeLabel {
        get {
            var tz = TzProvider.TimeZone;
            var start = TimeZoneInfo.ConvertTime(_visibleStart, tz);
            var end = TimeZoneInfo.ConvertTime(_visibleEnd, tz).AddSeconds(-1);
            return _zoom switch {
                TimelineZoom.Month => TimeZoneInfo.ConvertTime(_center, tz).ToString("MMMM yyyy", CultureInfo.InvariantCulture),
                TimelineZoom.Week => $"{start.ToString("MMM d", CultureInfo.InvariantCulture)} - {end.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}",
                _ => start.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)
            };
        }
    }

    private static string TickStyle(double leftPercent) {
        return FormattableString.Invariant($"--tick-pos:{leftPercent};");
    }

    private IReadOnlyList<TooltipLine>? AirtimeTooltip {
        get {
            if (_occupancyHours is not { Count: > 0 } hours) return null;

            var total = hours.Sum();
            var top = Math.Max(hours.Count - 1, 1);
            List<TooltipLine> lines = [new("Ships in flight", Head: true, Value: "Hours")];
            for (var ships = hours.Count - 1; ships >= 0; ships--) {
                var share = total > 0 ? hours[ships] / total : 0;
                lines.Add(new(FormattableString.Invariant($"{ships} in flight ({share:P0})"),
                    Value: FormattableString.Invariant($"{hours[ships]:0.#}h"),
                    Ratio: (double)ships / top));
            }
            if (FilteredOutRatio is { } filteredOut) {
                lines.Add(new("Excluded by filter", Value: filteredOut.ToString("P1", CultureInfo.InvariantCulture)));
            }
            return lines;
        }
    }

    private void SetZoom(TimelineZoom zoom) {
        _zoom = zoom;
        Recompute();
        _resetScrollPending = true;
    }

    private void Pan(int direction) {
        if (!CanPan(direction)) return;

        _center += (_visibleEnd - _visibleStart) * direction;
        Recompute();
        _resetScrollPending = true;
    }

    private bool CanPan(int direction) {
        return direction switch {
            > 0 => _canPanNext,
            < 0 => _canPanPrev,
            _ => true
        };
    }

    private void UpdatePanBounds(TimeZoneInfo tz) {
        var nextMonth = TimelineWindow.Compute(Time.GetUtcNow().AddMonths(1), TimelineZoom.Month, tz);
        _canPanNext = _visibleEnd < nextMonth.End;

        if (EarliestLaunchUnixSeconds() is { } earliest) {
            var earliestWindow = TimelineWindow.Compute(DateTimeOffset.FromUnixTimeSeconds(earliest), _zoom, tz);
            _canPanPrev = _visibleStart > earliestWindow.Start;
        } else {
            _canPanPrev = true;
        }
    }

    private long? EarliestLaunchUnixSeconds() {
        long? min = null;
        foreach (var m in AllMissions) {
            if (min is null || m.LaunchDT < min) min = m.LaunchDT;
        }

        foreach (var m in InFlightMissions) {
            if (min is null || m.LaunchDT < min) min = m.LaunchDT;
        }

        return min;
    }

    private double? FilteredOutRatio {
        get {
            if (_flightSlicesAll is not { Count: > 0 } allSlices) return null;

            var allTotal = allSlices.Sum(s => s.Ratio);
            var filteredTotal = _flightSlices?.Sum(s => s.Ratio) ?? 0;
            var delta = allTotal - filteredTotal;
            return delta > 0.0005 ? delta : null;
        }
    }

    private void JumpToNow() {
        _center = Time.GetUtcNow();
        Recompute();
        _resetScrollPending = true;
    }

    private void JumpToDate(ChangeEventArgs e) {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)) {
            var localNoon = parsed.ToDateTime(new TimeOnly(12, 0));
            _center = TimelineWindow.ToOffset(localNoon, TzProvider.TimeZone);
            Recompute();
            _resetScrollPending = true;
        }
    }

    private async Task OnSelectMission(string missionId) {
        if (_noDataIds.Contains(missionId)) {
            _showStillFlying = true;
            return;
        }

        await OnViewMission.InvokeAsync(missionId);
    }

    private void SetHoveredMissionId(string? missionId) {
        if (_hoveredMissionId == missionId) return;

        _hoveredMissionId = missionId;
    }

    private void CloseStillFlying() {
        _showStillFlying = false;
    }

}
