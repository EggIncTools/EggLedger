@if (IsOpen) {
    <div class="fixed inset-0 z-40 flex items-center justify-center bg-black/60 modal-backdrop-anim" @onclick="OnBackdropClick">
        <div @ref="_containerRef" class="modal-panel-anim @ContainerClass" tabindex="@(CaptureKeys ? "-1" : null)"
             @onclick:stopPropagation="true"
             @onkeydown="HandleKeyDown" @onkeydown:preventDefault="PreventKeyDefault">
            @ChildContent
        </div>
    </div>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Dismissable { get; set; } = true;
    [Parameter] public string ContainerClass { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool CaptureKeys { get; set; }
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    [Parameter] public bool PreventKeyDefault { get; set; }
    private bool _focusPending;
    private ElementReference _containerRef;

    public bool IsOpen { get; private set; }

    public void Open() {
        IsOpen = true;
        _focusPending = CaptureKeys;
        StateHasChanged();
    }

    public void Close() {
        IsOpen = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (_focusPending && IsOpen) {
            _focusPending = false;
            await _containerRef.FocusAsync();
        }
    }

    private Task OnBackdropClick() {
        return Dismissable ? OnClose.InvokeAsync() : Task.CompletedTask;
    }

    private Task HandleKeyDown(KeyboardEventArgs e) {
        return OnKeyDown.InvokeAsync(e);
    }

}
