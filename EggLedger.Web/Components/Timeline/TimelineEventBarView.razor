@using System.Collections.Frozen
@using System.Globalization
@inject IUserTimeZoneProvider TzProvider

<div class="timeline-event-bar timeline-event-@TypeSlug tooltip-host @(Bar.ContinuesLeft ? "timeline-event-cut-l" : "") @(Bar.ContinuesRight ? "timeline-event-cut-r" : "")" style="@BarStyle" @onmousemove="OnMouseMove">
    <span class="tooltip-point" style="@PointStyle"></span>
    <img class="timeline-event-icon" src="@IconUrl" alt="" loading="lazy" onerror="this.style.display='none'"/>
    <span class="timeline-event-label">@(Bar.Message ?? Bar.Type)</span>
    <div class="tooltip-floating tooltip-fixed tooltip-toggle timeline-event-tt">
        <span class="timeline-event-tt-name">@(Bar.Message ?? Bar.Type)</span>
        @if (Bar.Multiplier > 0) {
            <br/>
            <span class="timeline-event-tt-key">Multiplier: </span>@MultiplierLabel
        }
        <br/>
        <span class="timeline-event-tt-key">Starts:</span> @FormatTime(Bar.StartUnix)<br/>
        <span class="timeline-event-tt-key">Ends:</span> @FormatTime(Bar.EndUnix)
        @if (Bar.Ultra) {
            <br/>
            <span class="timeline-event-tt-ultra">Ultra</span>
        }
    </div>
</div>

@code {

    private static readonly FrozenDictionary<string, string> ColorByType = new Dictionary<string, string> {
        ["mission-fuel"] = "#8b5cf6",
        ["mission-capacity"] = "#a21caf",
        ["mission-duration"] = "#be185d"
    }.ToFrozenDictionary(StringComparer.OrdinalIgnoreCase);

    [Parameter] public required TimelineEventBar Bar { get; set; }

    private string TypeSlug => Bar.Type.Replace('_', '-').ToLowerInvariant();

    private string MultiplierLabel => Bar.Multiplier.ToString("0.##", CultureInfo.InvariantCulture) + "x";

    private string EventColor => ColorByType.GetValueOrDefault(Bar.Type, "#9ca3af");

    private string IconUrl =>
        FormattableString.Invariant($"/api/v1/event-icon?name={Uri.EscapeDataString(TypeSlug)}{(Bar.Ultra ? "&cc=1" : "")}");

    private string BarStyle =>
        FormattableString.Invariant($"--evt-start:{Bar.LeftPercent};--evt-size:{Bar.WidthPercent};--evt-bg:{EventColor};--tt-anchor:--{_anchorId};");

    private string PointStyle =>
        FormattableString.Invariant($"left:{_hoverX}px;top:0;--tt-anchor:--{_anchorId};");

    private readonly string _anchorId = "tt-" + Guid.NewGuid().ToString("N");
    private double _hoverX;

    private void OnMouseMove(MouseEventArgs e) =>
        _hoverX = Math.Round(e.OffsetX);

    private string FormatTime(long unixSeconds) =>
        TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds), TzProvider.TimeZone)
            .ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture);

}
