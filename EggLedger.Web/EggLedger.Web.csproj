<Project Sdk="Microsoft.NET.Sdk.Razor" InitialTargets="BuildStyles">

  <PropertyGroup>
    <Description>EggLedger shared Blazor UI (Razor class library): all 6 tabs, components, services, and the platform capability seam. Referenced by the Blazor Server host (EggLedger.Web.Server) and the Photino desktop host (EggLedger.Desktop). Host-agnostic over HttpClient / JSInterop.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.0" />
    <PackageReference Include="EggIdentity.Styles" Version="2.1.4" />
    <PackageReference Include="EggIdentity.UI" Version="2.1.4" />
    <PackageReference Include="Markdig" Version="0.41.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggLedger.Domain\EggLedger.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggLedger.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <_StylesInput Include="Styles\app.v4.css" />
    <_StylesInput Include="**\*.razor" Exclude="bin\**;obj\**;Tests\**" />
    <_StylesInput Include="..\EggLedger.Web.Server\**\*.razor" Exclude="..\EggLedger.Web.Server\bin\**;..\EggLedger.Web.Server\obj\**" Condition="Exists('..\EggLedger.Web.Server')" />
    <_StylesInput Include="..\EggLedger.Desktop\wwwroot\desktop.html" Condition="Exists('..\EggLedger.Desktop\wwwroot\desktop.html')" />
    <_StylesInput Include="..\EggLedger.CssBuild\**\*.cs" Exclude="..\EggLedger.CssBuild\bin\**;..\EggLedger.CssBuild\obj\**" />
  </ItemGroup>

  <Target Name="BuildStyles"
          Condition="'$(BuildStylesCss)' != 'false' And Exists('$(MSBuildProjectDirectory)/../EggLedger.CssBuild/Program.cs')"
          Inputs="@(_StylesInput)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\styles.css"
          Returns="">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../EggLedger.CssBuild&quot; --configuration Release -- &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

</Project>
