@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable
@implements IReportsViewActions
@inject ReportsViewState State
@inject MennoService Menno

@if (State.AccountId is null) {
    <div class="rv-empty">
        <p class="rv-empty-text">Select an account in the sidebar to view its reports.</p>
    </div>
} else {
    <div class="rv-toolbar">
        <div class="rv-groups">
            <button type="button"
                    class="rv-pill @(State.SelectedGroup is null ? "rv-pill-on" : "")"
                    @onclick="() => State.SelectGroup(null)">
                All
            </button>
            @foreach (var g in State.Groups) {
                <div class="rv-group">
                    @if (State.EditMode && State.RenamingGroupId == g.Id) {
                        <input class="rv-input"
                               @bind="State.RenameGroupName" @bind:event="oninput"
                               @onkeydown="e => RenameKeyDown(e, g.Id)" @onblur="() => State.CommitRenameAsync(g.Id)" @onclick:stopPropagation autofocus/>
                    } else {
                        <button type="button"
                                class="rv-pill @(State.SelectedGroup == g.Id ? "rv-pill-on" : "")"
                                @onclick="() => State.SelectGroup(g.Id)">
                            @g.Name
                        </button>
                    }
                    @if (State.EditMode) {
                        <button type="button" class="rv-icon-btn" aria-label="Rename group"
                                @onclick:stopPropagation @onclick="() => State.StartRename(g)">
                            &#9998;
                        </button>
                        <button type="button" class="rv-icon-btn rv-icon-btn-danger" aria-label="Delete group"
                                @onclick:stopPropagation @onclick="() => DeleteGroupAsync(g.Id)">
                            &#215;
                        </button>
                    }
                </div>
            }
            @if (State.ShowNewGroup) {
                <input class="rv-input"
                       placeholder="Group name" @bind="State.NewGroupName" @bind:event="oninput"
                       @onkeydown="GroupKeyDown" autofocus/>
                <button type="button" class="rv-small-btn" @onclick="State.CreateGroupAsync">Add</button>
                <button type="button" class="rv-small-btn" @onclick="State.CancelNewGroup">Cancel</button>
            } else {
                <button type="button" class="rv-pill rv-pill-compact" @onclick="State.BeginNewGroup">+ Group</button>
            }
            <button type="button" class="rv-pill rv-pill-compact @(State.EditMode ? "rv-pill-editing" : "")"
                    @onclick="State.ToggleEditMode">
                @(State.EditMode ? "Done Editing" : "Edit Groups")
            </button>
        </div>
        <div class="rv-actions">
            @if (Menno.IsLoading) {
                <span class="rv-menno" title="Downloading Menno's community ship data">
                    <img class="rv-menno-spinner" src="@ContentPaths.Asset("images/loading.gif")" alt=""/>
                    Syncing community data...
                </span>
            }
            <button type="button" class="btn-secondary" @onclick="State.RequestNewReportAsync">+ New Report</button>
            <button type="button" class="btn-secondary" @onclick="State.RequestExportAllAsync">Export All</button>
            <label class="btn-secondary rv-import">
                Import
                <InputFile class="rv-import-input" accept=".json,application/json" OnChange="OnImportFileAsync"/>
            </label>
        </div>
    </div>

    <ReportGrid @ref="_grid" AccountId="@State.AccountId" GroupFilter="@State.SelectedGroup"
                EditMode="State.EditMode" Groups="State.Groups" OnEdit="OpenEdit"/>
}

<ReportBuilderPanel @ref="_builder" AccountId="@(State.AccountId ?? "")"
                    GroupId="@State.SelectedGroup" Saved="OnSavedAsync"/>

@code {
    private ReportGrid? _grid;
    private ReportBuilderPanel? _builder;

    protected override async Task OnInitializedAsync() {
        State.Changed += OnStateChanged;
        Menno.Changed += OnStateChanged;
        State.Actions = this;
        await State.EnsureInitializedAsync(InvokeAsync);
    }

    protected override Task OnParametersSetAsync() {
        return State.EnsureAccountLoadedAsync();
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    public async Task NewReportAsync() {
        if (_builder is not null) await _builder.OpenForCreateAsync();
    }

    private async Task OpenEdit(ReportDefinition def) {
        if (_builder is not null) await _builder.OpenForEditAsync(def);
    }

    private async Task OnSavedAsync() {
        if (_grid is not null) await _grid.ReloadAsync();
    }

    private async Task GroupKeyDown(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            await State.CreateGroupAsync();
        } else if (e.Key == "Escape") {
            State.CancelNewGroup();
        }
    }

    private async Task RenameKeyDown(KeyboardEventArgs e, string groupId) {
        if (e.Key == "Enter") {
            await State.CommitRenameAsync(groupId);
        } else if (e.Key == "Escape") {
            State.CancelRename();
        }
    }

    private async Task DeleteGroupAsync(string id) {
        await State.DeleteGroupAsync(id);
        if (_grid is not null) await _grid.ReloadAsync();
    }

    public Task ExportAllAsync() {
        return _grid?.ExportAllAsync() ?? Task.CompletedTask;
    }

    public Task ImportAsync(string json) {
        return _grid?.ImportAsync(json) ?? Task.CompletedTask;
    }

    private async Task OnImportFileAsync(InputFileChangeEventArgs e) {
        using var reader = new StreamReader(e.File.OpenReadStream(ImportMaxBytes));
        await State.RequestImportAsync(await reader.ReadToEndAsync());
    }

    private const long ImportMaxBytes = 16 * 1024 * 1024;

    public void Dispose() {
        State.Changed -= OnStateChanged;
        Menno.Changed -= OnStateChanged;
        if (ReferenceEquals(State.Actions, this)) State.Actions = null;
    }

}
