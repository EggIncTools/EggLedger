@using EggIdentity.UI
@inject AddAccountService AddAccount

@* Add-account modal. Blazor-controlled overlay (full-screen fixed backdrop + centered
   card). NOT a native <dialog>.showModal(): top-layer promotion desyncs the Blazor Server
   render tree (insertBefore/parentNode-null crashes). Backdrop click closes. *@

<ModalHost Open="_open" OnClose="Close" Title="Add Account" Width="ModalWidth.Small">
    <div class="addacct">
        <form @onsubmit="Submit" @onsubmit:preventDefault>
            <input
                class="addacct-input"
                type="text"
                placeholder="Enter player ID (e.g. EI1234567890123456)"
                @bind="_eid"
                @bind:event="oninput"
                disabled="@_loading"/>
            @if (_problem != "" && _eid.Trim() != "") {
                <StatusNote Kind="StatusNoteKind.Warn" Text="@_problem" Class="addacct-msg"/>
            }
            @if (_error != "") {
                <StatusNote Kind="StatusNoteKind.Error" Text="@_error" Class="addacct-msg"/>
            }
            @if (_loading) {
                <StatusNote Kind="StatusNoteKind.Busy" Text="Fetching account data..." Class="addacct-msg"/>
            }
            <div class="addacct-actions">
                <button type="button" class="btn-secondary" disabled="@_loading" @onclick="Close">Cancel</button>
                <button type="submit" class="btn-primary" disabled="@(_loading || !IsValid)">Add</button>
            </div>
        </form>
    </div>
</ModalHost>

@code {
    private bool _open;
    private string _eid = "";
    private bool _loading;
    private string _error = "";

    [Parameter] public EventCallback<AccountInfo> Added { get; set; }

    private string Normalized => LedgerFormatting.NormalizeEid(_eid);
    private string _problem => LedgerFormatting.EidProblem(Normalized);
    private bool IsValid => LedgerFormatting.IsEidValid(Normalized);

    public void Open() {
        _eid = "";
        _error = "";
        _loading = false;
        _open = true;
        StateHasChanged();
    }

    private void Close() {
        _open = false;
    }

    private async Task Submit() {
        if (!IsValid) return;

        _loading = true;
        _error = "";
        try {
            var account = await AddAccount.AddAccountAsync(Normalized);

            _loading = false;
            Close();
            await Added.InvokeAsync(account);
        } catch (Exception e) {
            _error = e.Message;
        } finally {
            _loading = false;
        }
    }

}
