@* Root document for the Blazor Server host. Identity flows into the circuit via cookie
   auth + the framework AuthenticationStateProvider. *@
@using EggIdentity.UI

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>EggLedger</title>
    <base href="/"/>

    <meta name="description" content="Exports your Egg, Inc. spaceship mission history, every loot drop included, to .xlsx and .csv."/>
    <meta name="theme-color" content="#1f2937"/>
    <link rel="icon" type="image/png" href="_content/EggLedger.Web/images/icon-512.png"/>

    <meta property="og:type" content="website"/>
    <meta property="og:site_name" content="EggLedger"/>
    <meta property="og:title" content="EggLedger"/>
    <meta property="og:description" content="Exports your Egg, Inc. spaceship mission history, every loot drop included, to .xlsx and .csv."/>
    <meta property="og:url" content="https://eggledger.egginc.tools/"/>
    <meta property="og:image" content="https://eggledger.egginc.tools/_content/EggLedger.Web/images/icon-512.png"/>

    <meta name="twitter:card" content="summary"/>
    <meta name="twitter:title" content="EggLedger"/>
    <meta name="twitter:description" content="Exports your Egg, Inc. spaceship mission history, every loot drop included, to .xlsx and .csv."/>
    <meta name="twitter:image" content="https://eggledger.egginc.tools/_content/EggLedger.Web/images/icon-512.png"/>

    <link rel="stylesheet" href="_content/EggIdentity.UI/shared.css?v=@AppVersionInfo.Current"/>
    <link rel="stylesheet" href="_content/EggIdentity.UI/reduced-motion.css?v=@AppVersionInfo.Current"/>
    <link rel="stylesheet" href="_content/EggLedger.Web/app.css?v=@AppVersionInfo.Current"/>
    <link rel="stylesheet" href="EggLedger.Web.Server.styles.css?v=@AppVersionInfo.Current"/>
    <style>
        /* Hidden until Blazor sets display:block on a circuit error (template default). */
        #blazor-error-ui { display: none; position: fixed; bottom: 0; left: 0; right: 0;
            background: #b91c1c; color: #fff; padding: 0.6rem 1rem; z-index: 1000; }
        #blazor-error-ui .reload, #blazor-error-ui .dismiss { color: #fff; margin-left: 0.75rem; cursor: pointer; }
    </style>
    <HeadOutlet @rendermode="@RenderMode"/>
</head>
<body>
<div id="app">
    <Routes @rendermode="@RenderMode"/>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">&times;</span>
</div>

<ReconnectModal/>
<script src="_content/EggIdentity.UI/calendarScroll.js"></script>
<script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {


    private static readonly InteractiveServerRenderMode RenderMode = new();
}
