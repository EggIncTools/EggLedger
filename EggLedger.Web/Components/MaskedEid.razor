@inject ScreenshotSafetyState ScreenshotSafety
@implements IDisposable

@if (ScreenshotSafety.Enabled && IsEid(Value)) {
    <span class="masked-eid @(_revealed ? "masked-eid-revealed" : "")"
          @onclick="Toggle" @onclick:stopPropagation="true"
          data-tt="@(_revealed ? "Click to hide" : "Hover or click to reveal")">
        @Value
    </span>
} else {
    @Value
}

@code {
    [Parameter] public string Value { get; set; } = "";

    private bool _revealed;

    protected override void OnInitialized() {
        ScreenshotSafety.Changed += OnChanged;
    }

    public void Dispose() {
        ScreenshotSafety.Changed -= OnChanged;
    }

    private void OnChanged() {
        InvokeAsync(StateHasChanged);
    }

    private void Toggle() {
        _revealed = !_revealed;
    }

    private static bool IsEid(string s) {
        return s.Length == 18 && s.StartsWith("EI", StringComparison.Ordinal) && s.AsSpan(2).IndexOfAnyExceptInRange('0', '9') < 0;
    }

}
