@inject LedgerShellState Shell

<section class="ledger-support">
    <div class="ledger-support-head">
        <span class="ledger-support-badge">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="20" height="20" aria-hidden="true">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
            </svg>
        </span>
        <div class="ledger-support-head-text">
            <span class="ledger-support-title">Support</span>
            <span class="ledger-support-sub">Free, open source, no ads</span>
        </div>
    </div>
    <ul class="ledger-support-projects">
        @foreach (var project in Projects) {
            <li class="ledger-support-project">@project</li>
        }
    </ul>
    <p class="ledger-support-lede">Supporting covers servers and code-signing, and keeps EggLedger free for everyone.</p>
    <button type="button" class="ledger-support-btn" @onclick="OpenSupport">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16" aria-hidden="true">
            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
        </svg>
        <span>Support</span>
    </button>
</section>

@code {
    private static readonly string[] Projects = ["EggIncognito", "EggIdentity", "EggLedger"];

    private void OpenSupport() {
        Shell.SupportOpen = true;
    }

}
