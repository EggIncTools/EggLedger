@page "/missions"
@using System.Diagnostics
@using System.Text.Json
@implements IDisposable
@inject MissionQueryHandlers Queries
@inject MissionConfigProvider Config
@inject ActiveAccount Active
@inject AppStateService AppState
@inject IndexedDbSettings Settings
@inject MissionDataCache DataCache
@inject IUserTimeZoneProvider TzProvider
@inject InFlightMissionCache InFlight

<PageTitle>EggLedger - Mission Data</PageTitle>

<FilterSidebarLayout HasAccount="@(Active.ActiveAccountId is not null)"
                     NoAccountMessage="Select an account on the Ledger tab to view its missions."
                     IsLoading="_loading"
                     IsEmpty="@(_allMissions is null || _allMissions.Count == 0)"
                     FieldCtx="Config.FieldCtx"
                     Applying="_applying"
                     LastResultText="@_resultText"
                     OptionsContent="@RenderOptions()"
                     OnApply="ApplyFilterAsync">
    <div class="flex items-center gap-2 flex-wrap mt-0_75rem mb-0_5rem">
        <div class="tile-group">
            <button type="button" class="tile-group-item @(_viewMode == ViewMode.List ? "active" : "")" @onclick="@(() => SetViewMode(ViewMode.List))">List</button>
            <button type="button" class="tile-group-item @(_viewMode == ViewMode.Calendar ? "active" : "")" @onclick="@(() => SetViewMode(ViewMode.Calendar))">Calendar</button>
        </div>
        @if (_hasBothTypes) {
            @RenderTileSelector()
        }
    </div>
    @if (_viewMode == ViewMode.Calendar) {
        <MissionCalendarView Missions="_tabFiltered ?? Array.Empty<DatabaseMission>()"
                             InFlightMissions="@TabFilteredInFlight"
                             ShowFlightRatio="@_opts.CalendarFlightRatio"
                             OnViewMission="ViewMissionAsync"/>
    } else {
        <MissionResultsTable Grouping="_grouping"
                             ViewByDate="_opts.ViewByDate"
                             ViewMissionTimes="_opts.ViewMissionTimes"
                             MultiViewMode="_opts.MultiViewMode"
                             RecolorDC="_opts.RecolorDC"
                             RecolorBC="_opts.RecolorBC"
                             Config="_cardPresets.ActivePreset()"
                             SelectedIds="_multiSelectedIds"
                             TabFiltered="_tabFiltered ?? Array.Empty<DatabaseMission>()"
                             MissionBeingViewed="_missionBeingViewed"
                             FlatMissions="_flatSorted"
                             DropCounts="_dropCounts"
                             OnViewMission="ViewMissionAsync"
                             OnViewRow="ViewRowAsync"
                             OnSelectionChanged="StateHasChanged"
                             OnGroupingChanged="StateHasChanged"/>
    }
</FilterSidebarLayout>

@if (Active.ActiveAccountId is not null && !_loading && _allMissions is { Count: > 0 }) {
    <MissionOverlay @ref="_overlay"
                    AccountId="@Active.ActiveAccountId"
                    FilteredMissions="_flatSorted ?? _tabFiltered ?? Array.Empty<DatabaseMission>()"
                    SortMethod="_opts.SortMethod"
                    ShowExpectedDrops="_cardPresets.ActivePreset().ShowExpectedDropsPerShip"/>

    <MissionCardConfigModal @ref="_cardConfigModal"
                            PresetSet="_cardPresets"
                            PreviewMission="_tabFiltered?.FirstOrDefault()"
                            OnSave="SaveCardPresetSetAsync"/>
}

@code {

    private enum ViewMode {
        List,
        Calendar
    }

    private ViewMode _viewMode = ViewMode.List;
    private bool _loading = true;
    private bool _applying;
    private string _resultText = "";
    private string? _missionBeingViewed;
    private IReadOnlyList<DatabaseMission>? _allMissions;
    private IReadOnlyList<DatabaseMission>? _filtered;
    private IReadOnlyList<DatabaseMission>? _tabFiltered;
    private MissionGrouping? _grouping;
    private bool _hasBothTypes;
    private readonly MissionViewOptions _opts = new();
    private readonly HashSet<string> _multiSelectedIds = new();
    private MissionFilterMatcher? _matcher;
    private MissionOverlay? _overlay;
    private CardPresetSet _cardPresets = CardPresetSet.Default;
    private MissionCardConfigModal? _cardConfigModal;
    private static readonly JsonSerializerOptions CardJsonOptions = new(JsonSerializerDefaults.Web);


    private Dictionary<string, List<MissionDrop>>? _allDrops;
    private Dictionary<string, int> _dropCounts = new();
    private IReadOnlyList<DatabaseMission>? _flatSorted;

    protected override async Task OnInitializedAsync() {
        Active.Changed += OnAccountChanged;
        AppState.Changed += OnAppStateChanged;
        var settings = await Settings.GetAllSettingsAsync();
        _opts.LoadFrom(settings);
        _cardPresets = settings.TryGetValue(MissionViewOptions.KeyCardPresets, out var json) && !string.IsNullOrEmpty(json)
            ? JsonSerializer.Deserialize<CardPresetSet>(json, CardJsonOptions) ?? CardPresetSet.Default
            : CardPresetSet.Default;
        await LoadAsync();
    }

    private void OnAccountChanged() {
        InvokeAsync(LoadAsync);
    }


    private void OnAppStateChanged() {
        if (AppState.PipelineState == Services.AppState.Success && Active.ActiveAccountId is not null) {
            DataCache.InvalidateAll();
            InvokeAsync(LoadAsync);
        }
    }

    private async Task LoadAsync() {
        _missionBeingViewed = null;
        var id = Active.ActiveAccountId;
        if (id is null) {
            _allMissions = null;
            _filtered = null;
            _grouping = null;
            StateHasChanged();
            return;
        }

        _resultText = "";
        _allDrops = null;
        _dropCounts = new Dictionary<string, int>();
        _flatSorted = null;

        var cached = DataCache.GetMissions(id, DateTime.UtcNow);
        List<DatabaseMission> missions;
        if (cached is not null) {
            missions = [.. cached];
        } else {
            _loading = true;
            StateHasChanged();
            var rows = await Queries.ViewMissionsOfEidAsync(id);
            missions = rows?.Cast<DatabaseMission>().ToList() ?? new List<DatabaseMission>();
            DataCache.SetMissions(id, missions, DateTime.UtcNow);
        }

        _allMissions = missions;
        _filtered = missions;
        _hasBothTypes = MissionViewOptions.HasBothMissionTypes(missions);
        if (!_hasBothTypes) {
            _opts.MissionTypeTab = null;
        }

        _matcher = new MissionFilterMatcher(
            Config.DurationConfigs,
            id,
            DropsFetcher,
            TzProvider.TimeZone);
        Regroup();
        _loading = false;
        StateHasChanged();
    }


    private async Task<IReadOnlyList<MissionDrop>?> DropsFetcher(string accountId, string missionId) {
        _allDrops ??= await Queries.GetAllPlayerDropsAsync(accountId) ?? [];
        return _allDrops.TryGetValue(missionId, out var drops) ? drops : [];
    }

    private void Regroup() {
        _tabFiltered = MissionViewOptions.TabFilteredMissions(_filtered, _opts.MissionTypeTab);
        _grouping = MissionGrouper.Group(_tabFiltered, ts => MissionFilterMatcher.LedgerDate(ts, TzProvider.TimeZone), true);

        if (_opts.SortByDropCount && _dropCounts.Count > 0 && _tabFiltered is { Count: > 0 }) {
            var sorted = new List<DatabaseMission>(_tabFiltered);
            sorted.Sort((a, b) => {
                _dropCounts.TryGetValue(a.MissiondId, out var ca);
                _dropCounts.TryGetValue(b.MissiondId, out var cb);
                var cmp = cb.CompareTo(ca);
                if (cmp != 0) return cmp;
                return b.LaunchDT.CompareTo(a.LaunchDT);
            });
            _flatSorted = sorted;
        } else {
            _flatSorted = null;
        }
    }

    private async Task SaveCardPresetSetAsync(CardPresetSet updated) {
        _cardPresets = updated;
        var json = JsonSerializer.Serialize(_cardPresets, CardJsonOptions);
        await Settings.SetSettingAsync(MissionViewOptions.KeyCardPresets, json);
        StateHasChanged();
    }

    private async Task ApplyFilterAsync(MissionFilterBar.LegacyFilter filter) {
        if (_allMissions is null || _matcher is null) {
            return;
        }

        _applying = true;
        _dropCounts = new Dictionary<string, int>();
        _flatSorted = null;
        StateHasChanged();

        DropMatch? countableDrop = null;
        foreach (var fc in filter.And) {
            var typed = FilterCodec.FromLegacyCondition(fc);
            if (typed is { Field: FilterField.Drops, Operator: FilterOperator.Contains, Value: FilterValue.Drop d }) {
                countableDrop = d.Match;
                break;
            }
        }

        var sw = Stopwatch.StartNew();
        var result = new List<DatabaseMission>();
        foreach (var mission in _allMissions) {
            if (await _matcher.MissionMatchesFilterAsync(mission, filter.And, filter.Or)) {
                result.Add(mission);
                if (countableDrop is not null) {
                    var count = await _matcher.CountMatchingDropsAsync(mission, countableDrop);
                    if (count > 0) {
                        _dropCounts[mission.MissiondId] = count;
                    }
                }
            }
        }

        sw.Stop();

        _filtered = result;
        PruneSelection();
        var shown = result.Count;
        var filteredOut = _allMissions.Count - shown;
        _resultText = $"Filtered in {sw.Elapsed.TotalSeconds:0.###}s ({shown} shown, {filteredOut} filtered out)";
        Regroup();
        _applying = false;
        StateHasChanged();
    }

    private void PruneSelection() {
        if (_filtered is null) {
            _multiSelectedIds.Clear();
            return;
        }

        var valid = new HashSet<string>();
        foreach (var m in _filtered) {
            valid.Add(m.MissiondId);
        }

        _multiSelectedIds.RemoveWhere(id => !valid.Contains(id));
    }

    private void SetViewMode(ViewMode mode) {
        _viewMode = mode;
        StateHasChanged();
    }

    private void SelectTab(int? tab) {
        _opts.MissionTypeTab = tab;
        Regroup();
        StateHasChanged();
    }

    private RenderFragment RenderTileSelector() => __builder => {
        <div class="tile-group">
            <button type="button" class="tile-group-item @(_opts.MissionTypeTab is null ? "active" : "")" @onclick="@(() => SelectTab(null))">All <span class="text-gray-500 ml-1">(@(_filtered?.Count ?? 0))</span></button>
            <button type="button" class="tile-group-item @(_opts.MissionTypeTab == 0 ? "active" : "")" @onclick="@(() => SelectTab(0))">Home <span class="text-gray-500 ml-1">(@CountOfType(0))</span></button>
            <button type="button" class="tile-group-item @(_opts.MissionTypeTab == 1 ? "active" : "")" @onclick="@(() => SelectTab(1))">Virtue <span class="text-gray-500 ml-1">(@CountOfType(1))</span></button>
        </div>
    };

    private IReadOnlyList<DatabaseMission> TabFilteredInFlight =>
        MissionViewOptions.TabFilteredMissions(InFlight.GetForAccount(Active.ActiveAccountId), _opts.MissionTypeTab)
        ?? Array.Empty<DatabaseMission>();

    private RenderFragment RenderOptions() => __builder => {
        <div class="flex flex-col gap-3">
            @if (_viewMode == ViewMode.List) {
                <button type="button" class="text-base toggle-link whitespace-nowrap w-max" @onclick="@(() => _cardConfigModal!.OpenAsync())">
                    Card Design
                </button>
                <div>
                    <span class="font-bold text-gray-400">Display</span>
                    <div class="flex flex-col gap-1 mt-1">
                        <label><input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_opts.ViewByDate" @onchange="@(e => SetOpt(MissionViewOptions.KeyViewByDate, b => _opts.ViewByDate = b, e))"/> Separate missions by day</label>
                        <label><input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_opts.ViewMissionTimes" @onchange="@(e => SetOpt(MissionViewOptions.KeyViewTimes, b => _opts.ViewMissionTimes = b, e))"/> Show launch times</label>
                        <label><input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_opts.RecolorDC" @onchange="@(e => SetOpt(MissionViewOptions.KeyRecolorDC, b => _opts.RecolorDC = b, e))"/> Re-color dubcaps</label>
                        <label><input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_opts.RecolorBC" @onchange="@(e => SetOpt(MissionViewOptions.KeyRecolorBC, b => _opts.RecolorBC = b, e))"/> Re-color bugged caps</label>
                    </div>
                </div>
                <div>
                    <span class="font-bold text-gray-400">Multi-View Method</span>
                    <div class="tile-group flex-wrap mt-1">
                        <button type="button" class="tile-group-item @(_opts.MultiViewMode == MultiViewMode.Off ? "active" : "")" @onclick="@(() => SetMultiView(MultiViewMode.Off))">Off</button>
                        <button type="button" class="tile-group-item @(_opts.MultiViewMode == MultiViewMode.Row ? "active" : "") @(_opts.SortByDropCount ? "opacity-40 cursor-not-allowed" : "")" disabled="@_opts.SortByDropCount" @onclick="@(() => SetMultiView(MultiViewMode.Row))">Row/Date Select</button>
                        <button type="button" class="tile-group-item @(_opts.MultiViewMode == MultiViewMode.Free ? "active" : "")" @onclick="@(() => SetMultiView(MultiViewMode.Free))">Free Select</button>
                    </div>
                </div>
            }
            <div>
                <span class="font-bold text-gray-400">Drops Sort Method</span>
                <div class="tile-group flex-wrap mt-1">
                    <button type="button" class="tile-group-item @(_opts.SortMethod == MissionSortMethod.Default ? "active" : "")" @onclick="@(() => SetSortMethod(MissionSortMethod.Default))">Default</button>
                    <button type="button" class="tile-group-item @(_opts.SortMethod == MissionSortMethod.Iv ? "active" : "")" @onclick="@(() => SetSortMethod(MissionSortMethod.Iv))">Inventory Visualizer</button>
                </div>
            </div>
            @if (_viewMode == ViewMode.Calendar) {
                <div>
                    <span class="font-bold text-gray-400">Calendar</span>
                    <div class="flex flex-col gap-1 mt-1">
                        <label><input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_opts.CalendarFlightRatio" @onchange="@(e => SetOpt(MissionViewOptions.KeyCalendarFlightRatio, b => _opts.CalendarFlightRatio = b, e))"/> Show flight time ratio</label>
                    </div>
                </div>
            }
            @if (_viewMode == ViewMode.List) {
                <div>
                    <span class="font-bold text-gray-400">Mission Sort</span>
                    <div class="flex flex-col gap-1 mt-1">
                        <label class="@(_dropCounts.Count == 0 ? "opacity-40 cursor-not-allowed" : "")">
                            <input type="checkbox" class="ext-opt-check mr-0_5rem" checked="@_opts.SortByDropCount" disabled="@(_dropCounts.Count == 0)" @onchange="ToggleSortByDropCount"/>
                            Sort by drop count
                        </label>
                    </div>
                </div>
            }
        </div>
    };

    private int CountOfType(int type) {
        if (_filtered is null) {
            return 0;
        }

        var n = 0;
        foreach (var m in _filtered) {
            if (m.MissionType == type) {
                n++;
            }
        }

        return n;
    }

    private async Task SetOpt(string key, Action<bool> apply, ChangeEventArgs e) {
        var value = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        apply(value);
        await Settings.SetSettingAsync(key, value ? "true" : "false");
        StateHasChanged();
    }

    private async Task SetMultiView(MultiViewMode mode) {
        _opts.MultiViewMode = mode;
        _multiSelectedIds.Clear();
        await Settings.SetSettingAsync(MissionViewOptions.KeyMultiViewMode, MissionViewOptions.MultiViewModeToString(mode));
        StateHasChanged();
    }

    private async Task ToggleSortByDropCount(ChangeEventArgs e) {
        await SetOpt(MissionViewOptions.KeySortByDropCount, b => _opts.SortByDropCount = b, e);
        if (_opts.SortByDropCount && _opts.MultiViewMode == MultiViewMode.Row) {
            await SetMultiView(MultiViewMode.Off);
        }

        Regroup();
        StateHasChanged();
    }

    private async Task SetSortMethod(MissionSortMethod method) {
        _opts.SortMethod = method;
        await Settings.SetSettingAsync(MissionViewOptions.KeySortMethod, MissionViewOptions.SortMethodToString(method));
        if (_overlay is not null) {
            await _overlay.ReSortAsync(method);
        }

        StateHasChanged();
    }

    private async Task ViewMissionAsync(string missionId) {
        _missionBeingViewed = missionId;
        StateHasChanged();
        if (_overlay is not null) {
            await _overlay.OpenAsync(missionId);
        }
    }


    private async Task ViewRowAsync(IReadOnlyList<string> missionIds) {
        if (missionIds.Count == 0 || _overlay is null) {
            return;
        }

        if (missionIds.Count == 1) {
            await ViewMissionAsync(missionIds[0]);
            return;
        }

        _missionBeingViewed = null;
        StateHasChanged();
        await _overlay.OpenMultiAsync(missionIds);
    }

    public void Dispose() {
        Active.Changed -= OnAccountChanged;
        AppState.Changed -= OnAppStateChanged;
    }

}
