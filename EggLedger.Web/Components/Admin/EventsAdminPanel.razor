@using System.Globalization
@inject GameEventsService GameEvents
@inject IUserTimeZoneProvider TzProvider

<AdminPanel Title="@($"EGI Events ({GameEvents.Count})")">
    <HeadTools>
        <button type="button" class="evadm-refresh" @onclick="RefreshAsync" disabled="@_refreshing">
            @(_refreshing ? "Refreshing..." : "Refresh")
        </button>
    </HeadTools>
    <ChildContent>
        <div class="evadm">
            @if (!GameEvents.IsConfigured) {
                <p class="evadm-note">EGI_BASE_URL not set - events disabled.</p>
            } else {
                <div class="evadm-next">
                    Next refresh eligible: @FormatLocal(GameEvents.NextAllowedRefresh)
                </div>
                @if (GameEvents.Count == 0) {
                    <p class="evadm-note">No events loaded.</p>
                } else {
                    <div class="evadm-scroll">
                        <table class="data-table evadm-table">
                            <thead>
                            <tr>
                                <th>Id</th>
                                <th>Type</th>
                                <th class="evadm-num">Multiplier</th>
                                <th>Starts</th>
                                <th>Ends</th>
                                <th>Source</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var e in Snapshot) {
                                <tr>
                                    <td class="evadm-id">@e.Id</td>
                                    <td>@e.Type @(e.Ultra ? "(ultra)" : "")</td>
                                    <td class="evadm-num">@e.Multiplier.ToString("0.##", CultureInfo.InvariantCulture)x</td>
                                    <td class="evadm-muted">@FormatLocal(e.StartsAt)</td>
                                    <td class="evadm-muted">@FormatLocal(e.EndsAt)</td>
                                    <td class="evadm-dim">@(e.Source ?? "none")</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </ChildContent>
</AdminPanel>

@code {
    private bool _refreshing;

    private IReadOnlyList<GameEvent> Snapshot => GameEvents.Snapshot();

    private string FormatLocal(DateTimeOffset t) =>
        TimeZoneInfo.ConvertTime(t, TzProvider.TimeZone).ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);

    protected override void OnInitialized() {
        GameEvents.EnsureLoadedAsync().ContinueWith(_ => InvokeAsync(StateHasChanged), TaskScheduler.Default);
    }

    private async Task RefreshAsync() {
        _refreshing = true;
        await GameEvents.RefreshAsync();
        _refreshing = false;
    }

}
