@using EggIdentity.UI
@using Microsoft.AspNetCore.Components.Authorization
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(FaultNotFound)">
        <Found Context="routeData">
            <AuthorizeView>
                <Authorized>
                    <BackfillTrigger/>
                </Authorized>
            </AuthorizeView>
            <CircuitGuard Name="Root" Scope="FaultScope.Page">
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
            </CircuitGuard>
        </Found>
    </Router>
</CascadingAuthenticationState>
