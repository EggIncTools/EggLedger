@using EggIdentity.UI
<ModalHost Open="true" OnClose="Close" Title="@Title" Width="ModalWidth.Large">
    <div class="legal-modal">
        <div class="prose-legal">
            @if (Kind == LegalDocument.Terms) {
                <TermsContent OnCrossLink="OnKindChange"/>
            } else {
                <PrivacyContent OnCrossLink="OnKindChange"/>
            }
        </div>
    </div>
</ModalHost>

@code {
    [Parameter] [EditorRequired] public LegalDocument Kind { get; set; }

    [Parameter] public EventCallback<LegalDocument> OnKindChange { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    private string Title => Kind == LegalDocument.Terms ? "Terms of Service" : "Privacy & Cookies";

    private Task Close() {
        return OnClose.InvokeAsync();
    }

}
