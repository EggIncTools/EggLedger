@using System.Globalization

<div class="rml">
    <div class="rml-plot">
        @if (SeriesCount >= 1 && BucketCount >= 2) {
            var max = GlobalMax();
            var ticks = BuildTicks(max);
            var seriesPoints = AllSeriesPoints();
            var colors = SeriesColors();
            <svg viewBox="0 0 @Fmt(W) @Fmt(H)" preserveAspectRatio="none" class="rml-svg">
                @if (max > 0) {
                    @foreach (var tick in ticks) {
                        <line class="rml-grid" x1="@Fmt(ChartGeometry.PadLeft)" y1="@Fmt(tick.Y)"
                              x2="@Fmt(W - ChartGeometry.PadRight)" y2="@Fmt(tick.Y)"
                              stroke-dasharray="3 3" stroke-width="0.5" vector-effect="non-scaling-stroke"/>
                    }
                }

                @for (var s = 0; s < seriesPoints.Count; s++) {
                    <polyline points="@PolyPoints(seriesPoints[s])" fill="none"
                              stroke="@colors[s]" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"
                              vector-effect="non-scaling-stroke"/>
                }
            </svg>

            @if (max > 0) {
                @foreach (var tick in ticks) {
                    <span class="rml-ytick" style="@RightPos(ChartGeometry.PadLeft - 4, tick.Y)">@tick.Label</span>
                }
            }

            @foreach (var p in LabeledPoints(seriesPoints)) {
                <span class="rml-xlabel" style="@RightPos(p.X, H - ChartGeometry.PadBottom + 4)">@ChartGeometry.FormatXLabel(p.Label)</span>
            }

            @for (var s = 0; s < seriesPoints.Count; s++) {
                var series = s;
                for (var i = 0; i < seriesPoints[s].Count; i++) {
                    var idx = i;
                    var p = seriesPoints[s][i];
                    <span class="rml-hit" style="@LeftPos(p.X, p.Y);--rml-color: @colors[s];"
                          @onmouseenter="() => _hover = (series, idx)" @onmouseleave="() => _hover = null">
                        <span class="rml-dot"></span>
                    </span>
                }
            }

            @if (_hover is { } h && h.Series < seriesPoints.Count && h.Index < seriesPoints[h.Series].Count) {
                var hp = seriesPoints[h.Series][h.Index];
                <PointTooltip Visible="true" X="@Pct(hp.X, W)" Y="@Pct(hp.Y, H)"
                              Lines="@PointLines(SeriesName(h.Series), hp)" PopClass="report-tooltip"/>
            }
        } else if (BucketCount < 2) {
            <div class="rml-msg">
                <span class="rml-empty">Not enough data for a line chart</span>
            </div>
        } else {
            <div class="rml-msg">
                <span class="rml-empty">No series data</span>
            </div>
        }
    </div>

    <div class="rml-legend">
        @{
            var legendColors = SeriesColors();
        }
        @foreach (var (label, color) in Result.ColLabels.Zip(legendColors)) {
            <Tooltip Text="@label" Class="rml-legend-item">
                <div class="rml-swatch" style="--rml-color: @color;"></div>
                <span class="rml-legend-label">@label</span>
            </Tooltip>
        }
    </div>
</div>

@code {
    private const double W = 300;
    private const double H = 150;
    private (int Series, int Index)? _hover;
    [Parameter] [EditorRequired] public ReportResult Result { get; set; } = new();
    [Parameter] [EditorRequired] public string Color { get; set; } = "#6366f1";
    [Parameter] public string? LabelColors { get; set; }
    [Parameter] public string? NormalizeBy { get; set; }
    private int BucketCount => Result.RowLabels.Count;
    private int SeriesCount => Result.ColLabels.Count;
    private bool IsPct => NormalizeBy is "row_pct" or "col_pct" or "global_pct";

    private double GlobalMax() {
        return Result.MatrixValues.DefaultIfEmpty(0).Max();
    }

    private List<string> SeriesColors() {
        return ChartGeometry.SeriesColors(Result.ColLabels, Color, SliceColors.ParseLabelColors(LabelColors));
    }

    private string SeriesName(int s) {
        return s < Result.ColLabels.Count ? Result.ColLabels[s] : "";
    }

    private List<List<ChartPoint>> AllSeriesPoints() {
        var nR = BucketCount;
        var result = new List<List<ChartPoint>>();
        if (nR < 2) return result;

        var max = Math.Max(GlobalMax(), 1);
        var xStep = (W - ChartGeometry.PadLeft - ChartGeometry.PadRight) / (nR - 1);
        var yRange = H - ChartGeometry.PadTop - ChartGeometry.PadBottom;
        for (var s = 0; s < SeriesCount; s++) {
            var vals = ChartGeometry.SeriesValues(Result.MatrixValues, nR, SeriesCount, s);
            result.Add([.. vals.Select((v, i) => new ChartPoint(
                ChartGeometry.PadLeft + i * xStep,
                ChartGeometry.PadTop + yRange * (1 - v / max),
                i < Result.RowLabels.Count ? Result.RowLabels[i] : "",
                v))]);
        }

        return result;
    }

    private List<ChartPoint> LabeledPoints(List<List<ChartPoint>> seriesPoints) {
        var first = seriesPoints.Count > 0 ? seriesPoints[0] : new List<ChartPoint>();
        return ChartGeometry.ThinLabels(first);
    }

    private List<YTick> BuildTicks(double max) {
        if (max == 0) return [];

        var yRange = H - ChartGeometry.PadTop - ChartGeometry.PadBottom;
        var ci = CultureInfo.InvariantCulture;
        return [.. new[] { 0.33, 0.67, 1.0 }.Select(frac => new YTick(
            ChartGeometry.PadTop + yRange * (1 - frac),
            IsPct ? (max * frac).ToString("0", ci) + "%"
                : max % 1 == 0 ? Math.Round(max * frac).ToString(ci)
                : (max * frac).ToString("0.0", ci)))];
    }

    private IReadOnlyList<TooltipLine> PointLines(string series, ChartPoint p) {
        var val = IsPct
            ? p.Value.ToString("0.0", CultureInfo.InvariantCulture) + "%"
            : Result.IsFloat
                ? p.Value.ToString("0.00", CultureInfo.InvariantCulture)
                : Math.Round(p.Value).ToString(CultureInfo.InvariantCulture);
        return [new TooltipLine(series, Head: true), new TooltipLine($"{p.Label}: {val}")];
    }

    private static double Pct(double v, double total) {
        return v / total * 100;
    }

    private static string LeftPos(double x, double y) {
        return string.Create(CultureInfo.InvariantCulture, $"left:{Pct(x, W):0.###}%;top:{Pct(y, H):0.###}%");
    }

    private static string RightPos(double x, double y) {
        return string.Create(CultureInfo.InvariantCulture, $"right:{100 - Pct(x, W):0.###}%;top:{Pct(y, H):0.###}%");
    }

    private static string PolyPoints(List<ChartPoint> pts) {
        return string.Join(" ", pts.Select(p => Fmt(p.X) + "," + Fmt(p.Y)));
    }

    private static string Fmt(double v) {
        return v.ToString("0.###", CultureInfo.InvariantCulture);
    }

}
