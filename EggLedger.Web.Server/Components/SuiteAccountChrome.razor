@using EggIdentity.UI.Suite

<SuiteAccount Placement="SuitePlacement.Bar" OnOpenProfile="OpenProfile"/>
<LedgerProfileModal Open="_profileOpen" OnClose="CloseProfile"/>

@code {
    private bool _profileOpen;

    private void OpenProfile() {
        _profileOpen = true;
    }

    private void CloseProfile() {
        _profileOpen = false;
    }

}
