@using System.Globalization
@inject IUserTimeZoneProvider TzProvider

<div class="timeline-bar timeline-dur-@Bar.DurationIndex @CapModifierClass tooltip-host @(Bar.ContinuesLeft ? "timeline-bar-cut-l" : "") @(Bar.ContinuesRight ? "timeline-bar-cut-r" : "") @(IsLinkedHover ? "timeline-bar-linked-hover" : "")" style="@BarStyle" @onclick="@(() => OnSelect.InvokeAsync(Bar.MissionId))" @onmouseenter="@(() => OnHoverMissionId.InvokeAsync(Bar.MissionId))" @onmouseleave="@(() => OnHoverMissionId.InvokeAsync(null))" @onmousemove="OnMouseMove">
    <span class="tooltip-point" style="@PointStyle"></span>
    <div class="timeline-bar-track">
        <div class="timeline-bar-fill"></div>
    </div>
    @if (!Bar.ContinuesLeft) {
        <div class="timeline-bar-edge timeline-bar-edge-start">
            <span class="timeline-bar-edge-label">@FormatEdgeTime(Bar.Mission.LaunchDT)</span>
        </div>
    }
    @if (!Bar.ContinuesRight) {
        <div class="timeline-bar-edge timeline-bar-edge-end">
            <span class="timeline-bar-edge-label">@FormatEdgeTime(Bar.Mission.ReturnDT)</span>
        </div>
    }
    @if (Template is { } t && Data is { } d) {
        <div class="timeline-bar-body">
            <MissionCard Template="t" Data="d" Embedded="true" RecolorDC="RecolorDC" RecolorBC="RecolorBC"/>
        </div>
    } else if (Bar.ShowBubble) {
        <span class="timeline-bar-bubble">
            <img class="timeline-bar-ship" src="@Bar.ShipIconPath" alt="@Bar.ShipName"/>
            @if (Bar.TargetIconPath is not null) {
                <img class="timeline-bar-target" src="@Bar.TargetIconPath" alt=""/>
            }
        </span>
    }
    <div class="tooltip-floating tooltip-fixed tooltip-toggle timeline-bar-tt">
        <span class="timeline-bar-tt-name">@Bar.ShipName</span>
        <span class="timeline-dur-text-@Bar.DurationIndex">@Bar.Mission.DurationString</span><br/>
        <span class="timeline-bar-tt-key">Launched:</span> @FormatTime(Bar.Mission.LaunchDT)<br/>
        <span class="timeline-bar-tt-key">@(Bar.IsActive ? "Returns:" : "Returned:")</span> @FormatTime(Bar.Mission.ReturnDT)<br/>
        <span class="timeline-bar-tt-key">Capacity:</span> @Bar.Mission.Capacity
        @if (!string.IsNullOrEmpty(Bar.Mission.Target) && Bar.Mission.Target != "UNKNOWN") {
            <br/>
            <span class="timeline-bar-tt-key">Target: </span>
            @NameFormatting.TargetDisplayName(Bar.Mission.Target)
        }
        @if (!Bar.HasData) {
            <br/>
            <span class="timeline-bar-tt-note">Still flying, no drop data yet</span>
        }
    </div>
</div>

@code {
    [Parameter] public required TimelineBar Bar { get; set; }
    [Parameter] public CardTemplate? Template { get; set; }
    [Parameter] public MissionCardData? Data { get; set; }
    [Parameter] public bool RecolorDC { get; set; }
    [Parameter] public bool RecolorBC { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }
    [Parameter] public bool IsLinkedHover { get; set; }
    [Parameter] public EventCallback<string?> OnHoverMissionId { get; set; }

    private TimelineBar? _renderedBar;
    private CardTemplate? _renderedTemplate;
    private MissionCardData? _renderedData;
    private bool _renderedRecolorDC;
    private bool _renderedRecolorBC;
    private bool _renderedLinkedHover;
    private double _renderedHoverX;
    private double _hoverX;
    private bool _hasRendered;

    protected override bool ShouldRender() {
        if (_hasRendered
            && ReferenceEquals(_renderedBar, Bar)
            && ReferenceEquals(_renderedTemplate, Template)
            && Equals(_renderedData, Data)
            && _renderedRecolorDC == RecolorDC
            && _renderedRecolorBC == RecolorBC
            && _renderedLinkedHover == IsLinkedHover
            && _renderedHoverX == _hoverX) {
            return false;
        }

        _hasRendered = true;
        _renderedBar = Bar;
        _renderedTemplate = Template;
        _renderedData = Data;
        _renderedRecolorDC = RecolorDC;
        _renderedRecolorBC = RecolorBC;
        _renderedLinkedHover = IsLinkedHover;
        _renderedHoverX = _hoverX;
        return true;
    }

    private void OnMouseMove(MouseEventArgs e) =>
        _hoverX = Math.Round(e.OffsetX);

    private string BarStyle =>
        FormattableString.Invariant($"--bar-start:{Bar.LeftPercent};--bar-size:{Bar.WidthPercent};--bar-fill:{Bar.FillPercent};--bar-z:{Bar.StackOrder};--tt-anchor:--{_anchorId};");

    private string PointStyle =>
        FormattableString.Invariant($"left:{_hoverX}px;top:0;--tt-anchor:--{_anchorId};");

    private readonly string _anchorId = "tt-" + Guid.NewGuid().ToString("N");
    private string CapModifierClass {
        get {
            if (RecolorBC && Bar.Mission.IsBuggedCap) return "timeline-bar-buggedcap";
            if (RecolorDC && Bar.Mission.IsDubCap) return "timeline-bar-dubcap";
            return "";
        }
    }

    private string FormatTime(long unixSeconds) {
        return TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds), TzProvider.TimeZone)
            .ToString("MMM d, h:mm tt", CultureInfo.InvariantCulture);
    }

    private string FormatEdgeTime(long unixSeconds) {
        return TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unixSeconds), TzProvider.TimeZone)
            .ToString("M/d h:mm tt", CultureInfo.InvariantCulture);
    }

}
