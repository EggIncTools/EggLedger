    <PackageVersion Include="EggIdentity.Fallback" Version="$(EggIdentityVersion)" />
    <PackageVersion Include="EggIdentity.Filtering" Version="$(EggIdentityVersion)" />
    <PackageVersion Include="EggIdentity.Metrics" Version="$(EggIdentityVersion)" />
    <PackageVersion Include="EggIdentity.Resilience" Version="$(EggIdentityVersion)" />
    <PackageVersion Include="EggIdentity.Settings" Version="$(EggIdentityVersion)" />
    <PackageVersion Include="EggIdentity.Settings.Store" Version="$(EggIdentityVersion)" />
    <PackageVersion Include="EggIdentity.Settings.AdminUi" Version="$(EggIdentityVersion)" />
