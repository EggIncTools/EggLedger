<Project Sdk="Microsoft.NET.Sdk.Razor" InitialTargets="BuildStyles">

  <PropertyGroup>
    <Description>EggLedger shared Blazor UI (Razor class library): all 6 tabs, components, services, and the platform capability seam. Referenced by the Blazor Server host (EggLedger.Web.Server) and the Photino desktop host (EggLedger.Desktop). Host-agnostic over HttpClient / JSInterop.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="EggIdentity.Filtering" />
    <PackageReference Include="EggIdentity.Styles" />
    <PackageReference Include="EggIdentity.UI" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EggLedger.Domain\EggLedger.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EggLedger.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <_StylesInput Include="Styles\app.v4.css" />
    <_StylesInput Include="**\*.razor" Exclude="bin\**;obj\**;Tests\**" />
    <_StylesInput Include="..\EggLedger.Desktop\wwwroot\desktop.html" Condition="Exists('..\EggLedger.Desktop\wwwroot\desktop.html')" />
    <_StylesInput Include="..\EggLedger.CssBuild\**\*.cs" Exclude="..\EggLedger.CssBuild\bin\**;..\EggLedger.CssBuild\obj\**" />
  </ItemGroup>

  <UsingTask TaskName="EggLedgerNewestFileStamp" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Directory ParameterType="System.String" Required="true" />
      <SearchPattern ParameterType="System.String" Required="true" />
      <Stamp ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
Stamp = "0";
if (System.IO.Directory.Exists(Directory)) {
    var max = 0L;
    foreach (var file in System.IO.Directory.EnumerateFiles(Directory, SearchPattern, System.IO.SearchOption.AllDirectories)) {
        var ticks = System.IO.File.GetLastWriteTimeUtc(file).Ticks;
        if (ticks > max) max = ticks;
    }
    Stamp = max.ToString();
}
]]></Code>
    </Task>
  </UsingTask>

  <Target Name="ComputeWebServerRazorStamp">
    <EggLedgerNewestFileStamp Directory="..\EggLedger.Web.Server" SearchPattern="*.razor">
      <Output TaskParameter="Stamp" PropertyName="_WebServerRazorStamp" />
    </EggLedgerNewestFileStamp>
  </Target>

  <Target Name="BuildStyles"
          Condition="'$(BuildStylesCss)' != 'false' And Exists('$(MSBuildProjectDirectory)/../EggLedger.CssBuild/Program.cs')"
          DependsOnTargets="ComputeWebServerRazorStamp"
          Inputs="@(_StylesInput);$(_WebServerRazorStamp)"
          Outputs="$(MSBuildProjectDirectory)\wwwroot\styles.css"
          Returns="">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)/../EggLedger.CssBuild&quot; --configuration Release -- &quot;$(MSBuildProjectDirectory)&quot;" />
  </Target>

</Project>
