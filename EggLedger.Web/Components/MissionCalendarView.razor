@using System.Globalization
@using EggLedger.Web.Missions.Timeline
@using EggLedger.Web.Components.Timeline
@inject IUserTimeZoneProvider TzProvider

<div class="flex flex-col gap-2 min-h-0 flex-1">
    <div class="flex items-center gap-2 flex-wrap">
        <TimelineRangePicker RangeLabel="@RangeLabel"
                             Zoom="_zoom"
                             DateValue="@LocalCenterDate"
                             ZoomChanged="SetZoomAsync"
                             OnPan="PanAsync"
                             OnToday="JumpToNowAsync"
                             DateChanged="JumpToDateAsync"/>
    </div>

    <div class="flex-1 min-h-0 shadow-sm bg-darkest rounded-md p-2 timeline-shell">
        <div class="timeline-scale">
            @if (_zoom == TimelineZoom.Day) {
                @foreach (var tick in _rows.Count > 0 ? _rows[0].HourTicks : Array.Empty<TimelineTick>()) {
                    if (tick.Label.Length > 0) {
                        <span class="timeline-scale-label" style="@TickStyle(tick.LeftPercent)">@tick.Label</span>
                    }
                }
            } else {
                @for (var i = 0; i < WeekdayNames.Length; i++) {
                    <span class="timeline-scale-label" style="@TickStyle((i + 0.5) / 7 * 100)">@WeekdayNames[i]</span>
                }
            }
        </div>
        <div class="timeline-canvas">
            @foreach (var row in _rows) {
                <div class="timeline-row @(row.Row.IsPrimary ? "" : "timeline-row-context")">
                    @foreach (var cell in row.Cells) {
                        if (cell.LeftPercent > 0) {
                            <div class="timeline-grid" style="@TickStyle(cell.LeftPercent)"></div>
                        }

                        <span class="timeline-cell-label @(cell.Muted ? "timeline-cell-muted" : "")" style="@TickStyle(cell.LeftPercent)">@CellLabel(cell)</span>
                    }
                    @foreach (var tick in row.HourTicks) {
                        <div class="timeline-grid" style="@TickStyle(tick.LeftPercent)"></div>
                    }
                    @if (row.NowPercent is { } nowPct) {
                        <div class="timeline-now" style="@TickStyle(nowPct)"></div>
                    }
                    <div class="timeline-row-lanes">
                        @foreach (var lane in row.Lanes) {
                            <div class="timeline-lane">
                                @foreach (var bar in lane) {
                                    <TimelineBarView Bar="bar" OnSelect="OnSelectMission"/>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private static readonly string[] WeekdayNames = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

    [Parameter] public IReadOnlyList<DatabaseMission> Missions { get; set; } = Array.Empty<DatabaseMission>();
    [Parameter] public EventCallback<string> OnViewMission { get; set; }

    private TimelineZoom _zoom = TimelineZoom.Month;
    private DateTimeOffset _center = DateTimeOffset.UtcNow;
    private DateTimeOffset _visibleStart;
    private DateTimeOffset _visibleEnd;
    private List<RowVm> _rows = [];

    private sealed record RowVm(
        TimelineRow Row,
        IReadOnlyList<TimelineDayCell> Cells,
        IReadOnlyList<TimelineTick> HourTicks,
        List<List<TimelineBar>> Lanes,
        double? NowPercent);

    protected override void OnParametersSet() {
        Recompute();
    }

    private void Recompute() {
        var tz = TzProvider.TimeZone;
        (_visibleStart, _visibleEnd) = TimelineWindow.Compute(_center, _zoom, tz);
        _center = _visibleStart + (_visibleEnd - _visibleStart) / 2;
        int? primaryMonth = _zoom == TimelineZoom.Month ? TimeZoneInfo.ConvertTime(_visibleStart, tz).Month : null;
        var now = DateTimeOffset.UtcNow;
        _rows = TimelineRows.Build(_zoom, _visibleStart, _visibleEnd, tz)
            .Select(row => BuildRow(row, tz, now, primaryMonth))
            .ToList();
    }

    private RowVm BuildRow(TimelineRow row, TimeZoneInfo tz, DateTimeOffset now, int? primaryMonth) {
        var lanes = GroupLanes(TimelineLayoutEngine.Layout(Missions, row.Start, row.End, now));
        var cells = _zoom == TimelineZoom.Day
            ? Array.Empty<TimelineDayCell>()
            : TimelineTicks.DayCells(row.Start, row.End, tz, primaryMonth);
        var hourTicks = _zoom == TimelineZoom.Day
            ? TimelineTicks.HourTicks(row.Start, row.End, tz)
            : Array.Empty<TimelineTick>();
        double? nowPercent = now > row.Start && now < row.End
            ? (now - row.Start).TotalSeconds / (row.End - row.Start).TotalSeconds * 100
            : null;
        return new RowVm(row, cells, hourTicks, lanes, nowPercent);
    }

    private static List<List<TimelineBar>> GroupLanes(IReadOnlyList<TimelineBar> bars) {
        var byLane = new Dictionary<int, List<TimelineBar>>();
        foreach (var bar in bars) {
            if (!byLane.TryGetValue(bar.Lane, out var list)) {
                list = [];
                byLane[bar.Lane] = list;
            }

            list.Add(bar);
        }

        return byLane.OrderBy(kv => kv.Key).Select(kv => kv.Value).ToList();
    }

    private string CellLabel(TimelineDayCell cell) =>
        _zoom == TimelineZoom.Month
            ? cell.LocalDate.Day.ToString(CultureInfo.InvariantCulture)
            : cell.LocalDate.ToString("M/d", CultureInfo.InvariantCulture);

    private string LocalCenterDate =>
        TimeZoneInfo.ConvertTime(_center, TzProvider.TimeZone).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);

    private string RangeLabel {
        get {
            var tz = TzProvider.TimeZone;
            var start = TimeZoneInfo.ConvertTime(_visibleStart, tz);
            var end = TimeZoneInfo.ConvertTime(_visibleEnd, tz).AddSeconds(-1);
            return _zoom switch {
                TimelineZoom.Month => start.ToString("MMMM yyyy", CultureInfo.InvariantCulture),
                TimelineZoom.Week => $"{start.ToString("MMM d", CultureInfo.InvariantCulture)} - {end.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)}",
                _ => start.ToString("MMM d, yyyy", CultureInfo.InvariantCulture),
            };
        }
    }

    private static string TickStyle(double leftPercent) =>
        FormattableString.Invariant($"--tick-pos:{leftPercent};");

    private Task SetZoomAsync(TimelineZoom zoom) {
        _zoom = zoom;
        Recompute();
        return Task.CompletedTask;
    }

    private Task PanAsync(int direction) {
        _center += (_visibleEnd - _visibleStart) * direction;
        Recompute();
        return Task.CompletedTask;
    }

    private Task JumpToNowAsync() {
        _center = DateTimeOffset.UtcNow;
        Recompute();
        return Task.CompletedTask;
    }

    private Task JumpToDateAsync(ChangeEventArgs e) {
        if (DateOnly.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed)) {
            var localNoon = parsed.ToDateTime(new TimeOnly(12, 0));
            _center = TimelineWindow.ToOffset(localNoon, TzProvider.TimeZone);
            Recompute();
        }

        return Task.CompletedTask;
    }

    private async Task OnSelectMission(string missionId) {
        await OnViewMission.InvokeAsync(missionId);
    }

}
