@using EggIdentity.Reports
@inject IndexedDbPinnedReportStore PinStore
@inject IndexedDbReportStore ReportStore
@inject ILogger<PinnedReportsStrip> Logger

<div>
    <div class="pins-head">
        <SearchablePicker Options="_pickerOptions" OverlayKind="drop" Placeholder="Add a report" OnSelect="OnPickAsync">
            <TriggerContent>+</TriggerContent>
        </SearchablePicker>
    </div>
    @if (_reports.Count == 0) {
        <p class="pins-empty">No pinned reports yet. Add one with the + button.</p>
    } else {
        <EggIdentity.UI.Reports.ReportGrid Placements="_placements" Editable="false">
            <Item Context="placement">
                <ReportCard Report="_reportsById[placement.ReportId]" AccountId="@AccountId" ShowUnpin="true" OnUnpin="() => UnpinAsync(_pinIdsByReportId[placement.ReportId])"/>
            </Item>
        </EggIdentity.UI.Reports.ReportGrid>
    }
</div>

@code {
    [Parameter] [EditorRequired] public string AccountId { get; set; } = "";
    [Parameter] [EditorRequired] public string View { get; set; } = "";

    private List<PinnedReportRow> _pins = [];
    private List<LedgerReport> _reports = [];
    private List<ReportPlacement> _placements = [];
    private Dictionary<string, LedgerReport> _reportsById = [];
    private Dictionary<string, string> _pinIdsByReportId = [];
    private List<PickerOption> _pickerOptions = [];
    private string _loadedKey = "";

    protected override async Task OnParametersSetAsync() {
        var key = AccountId + ":" + View;
        if (key == _loadedKey) return;

        _loadedKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync() {
        if (string.IsNullOrEmpty(AccountId)) {
            _pins = [];
            _reports = [];
            _placements = [];
            _reportsById = [];
            _pinIdsByReportId = [];
            _pickerOptions = [];
            return;
        }

        _pins = [.. await PinStore.RetrieveAsync(AccountId, View)];

        if (_pins.Count == 0 && View == PinnedReportViews.Lifetime) {
            var defaults = new[] { ReportTemplates.ShipMix, ReportTemplates.DurationMix, ReportTemplates.RarityMix };
            for (var i = 0; i < defaults.Length; i++) {
                await PinStore.InsertAsync(new PinnedReportRow {
                    AccountId = AccountId,
                    View = View,
                    Kind = PinnedReportKinds.Template,
                    RefId = defaults[i],
                    SortOrder = i,
                });
            }

            await PinStore.InsertAsync(new PinnedReportRow {
                AccountId = AccountId,
                View = View,
                Kind = PinnedReportKinds.Template,
                RefId = PinnedReportSentinels.LifetimeSeedMarker,
                SortOrder = defaults.Length,
            });

            _pins = [.. await PinStore.RetrieveAsync(AccountId, View)];
        }

        var reports = new List<LedgerReport>();
        var pinIdsByReportId = new Dictionary<string, string>();
        foreach (var pin in _pins) {
            LedgerReport? report = null;
            if (pin.Kind == PinnedReportKinds.Template) {
                var def = ReportTemplates.Find(pin.RefId);
                if (def is not null) report = new LedgerReport(def, ReportTemplates.Placement(def.Id, pin.SortOrder)) { AccountId = AccountId };
            } else {
                var row = await ReportStore.RetrieveReportAsync(pin.RefId);
                if (row is not null) report = ReportMapping.ToReport(row, Logger);
            }
            if (report is null) continue;
            reports.Add(report);
            pinIdsByReportId[report.Id] = pin.Id;
        }

        _reports = reports;
        _reportsById = reports.ToDictionary(r => r.Id);
        _pinIdsByReportId = pinIdsByReportId;
        _placements = [.. _reports.Select((r, i) => r.Placement with { Order = i, Group = null })];

        var pinnedUserIds = _pins.Where(p => p.Kind == PinnedReportKinds.User).Select(p => p.RefId).ToHashSet();
        var pinnedTemplateIds = _pins.Where(p => p.Kind == PinnedReportKinds.Template).Select(p => p.RefId).ToHashSet();
        var userReports = await ReportStore.RetrieveAccountReportsAsync(AccountId);
        _pickerOptions = [
            .. userReports.Where(r => !pinnedUserIds.Contains(r.Id)).Select(r => new PickerOption { Value = "user:" + r.Id, Text = ReportMapping.ToReport(r).Definition.Title }),
            .. ReportTemplates.All.Where(t => !pinnedTemplateIds.Contains(t.Id)).Select(t => new PickerOption { Value = "template:" + t.Id, Text = t.Title + " (template)" }),
        ];
    }

    private async Task OnPickAsync(PickerOption opt) {
        var parts = opt.Value.Split(':', 2);
        if (parts.Length != 2) return;

        var kind = parts[0] == "template" ? PinnedReportKinds.Template : PinnedReportKinds.User;
        var refId = parts[1];
        if (_pins.Exists(p => p.Kind == kind && p.RefId == refId)) return;

        await PinStore.InsertAsync(new PinnedReportRow {
            AccountId = AccountId,
            View = View,
            Kind = kind,
            RefId = refId,
            SortOrder = _pins.Count,
        });

        await LoadAsync();
    }

    private async Task UnpinAsync(string pinId) {
        await PinStore.DeleteAsync(pinId);
        await LoadAsync();
    }
}
