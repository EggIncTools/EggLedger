@implements IDisposable
@implements IShipsViewActions
@inject ShipsViewState State

@if (State.AccountId is null) {
    <p class="text-gray-500 italic mt-0_75rem">Select an account in the sidebar to view its missions.</p>
} else if (State.Loading && State.AllMissions is null) {
    <div class="mt-8 flex flex-col items-center justify-center gap-2">
        <span class="p-0_5rem text-lg text-gray-500">Loading missions...</span>
        <img src="@ContentPaths.Asset("images/loading.gif")" alt="Loading..." class="xl-ico"/>
    </div>
} else if (State.AllMissions is null || State.AllMissions.Count == 0) {
    <NoDataFallback/>
} else {
    @if (State.ViewMode == ShipsViewMode.Calendar) {
        <MissionCalendarView Missions="State.TabFiltered ?? Array.Empty<DatabaseMission>()"
                             InFlightMissions="@State.TabFilteredInFlight"
                             AllMissions="State.TabFilteredAll ?? Array.Empty<DatabaseMission>()"
                             HasActiveFilter="State.HasActiveFilter"
                             RecolorDC="State.Opts.RecolorDC"
                             RecolorBC="State.Opts.RecolorBC"
                             OnViewMission="ViewMissionAsync"
                             LeadingControls="CalendarLeadingControls"/>
    } else {
        <div class="flex items-center gap-2 flex-wrap mt-0_75rem mb-0_5rem">
            @RenderModeTiles()
            @if (State.HasBothTypes) {
                @RenderTileSelector()
            }
            @RenderListControlSet()
        </div>
        <MissionResultsTable Grouping="State.Grouping"
                             ViewByDate="State.Opts.ViewByDate"
                             ViewMissionTimes="State.Opts.ViewMissionTimes"
                             MultiViewMode="State.Opts.MultiViewMode"
                             RecolorDC="State.Opts.RecolorDC"
                             RecolorBC="State.Opts.RecolorBC"
                             Config="State.CardPresets.ActivePreset()"
                             SelectedIds="State.MultiSelectedIds"
                             TabFiltered="State.TabFiltered ?? Array.Empty<DatabaseMission>()"
                             MissionBeingViewed="State.MissionBeingViewed"
                             FlatMissions="State.FlatSorted"
                             DropCounts="State.DropCounts"
                             OnViewMission="ViewMissionAsync"
                             OnViewRow="ViewRowAsync"
                             OnSelectionChanged="StateHasChanged"
                             OnGroupingChanged="StateHasChanged"/>
    }

    <MissionOverlay @ref="_overlay"
                    AccountId="@State.AccountId"
                    FilteredMissions="State.FlatSorted ?? State.TabFiltered ?? Array.Empty<DatabaseMission>()"
                    SortMethod="State.Opts.SortMethod"
                    ShowExpectedDrops="State.CardPresets.ActivePreset().ShowExpectedDropsPerShip"/>

    <div class="settings-section drops-widgets-section @(_widgetsOpen ? "is-open" : "")">
        <button type="button" class="settings-section-head" aria-expanded="@(_widgetsOpen ? "true" : "false")"
                @onclick="ToggleWidgets">
            <span class="settings-section-title">Reports</span>
            @if (_widgetsOpen) {
                <span class="settings-section-caret">&#9662;</span>
            } else {
                <span class="settings-section-caret">&#9656;</span>
            }
        </button>
        @if (_widgetsOpen && State.AccountId is { } accountId) {
            <div class="settings-section-body">
                <PinnedReportsStrip AccountId="accountId" View="PinnedReportViews.Missions"/>
            </div>
        }
    </div>
}

@code {
    private MissionOverlay? _overlay;
    private bool _widgetsOpen = true;

    protected override async Task OnInitializedAsync() {
        State.Changed += OnStateChanged;
        State.Actions = this;
        await State.EnsureInitializedAsync(InvokeAsync);
    }

    private void OnStateChanged() {
        InvokeAsync(StateHasChanged);
    }

    private void ToggleWidgets() {
        _widgetsOpen = !_widgetsOpen;
    }

    private RenderFragment RenderModeTiles() => __builder => {
        <div class="tile-group">
            <button type="button" class="tile-group-item @(State.ViewMode == ShipsViewMode.List ? "active" : "")" @onclick="@(() => State.SetViewMode(ShipsViewMode.List))">List</button>
            <button type="button" class="tile-group-item @(State.ViewMode == ShipsViewMode.Calendar ? "active" : "")" @onclick="@(() => State.SetViewMode(ShipsViewMode.Calendar))">Calendar</button>
        </div>
    };

    private RenderFragment CalendarLeadingControls => __builder => {
        @RenderModeTiles()
        @if (State.HasBothTypes) {
            @RenderTileSelector()
        }
    };

    private RenderFragment RenderTileSelector() => __builder => {
        <div class="tile-group">
            <button type="button" class="tile-group-item @(State.Opts.MissionTypeTab is null ? "active" : "")" @onclick="@(() => State.SelectTab(null))">All <span class="text-gray-500 ml-1">(@(State.Filtered?.Count ?? 0))</span></button>
            <button type="button" class="tile-group-item @(State.Opts.MissionTypeTab == 0 ? "active" : "")" @onclick="@(() => State.SelectTab(0))">Home <span class="text-gray-500 ml-1">(@State.CountOfType(0))</span></button>
            <button type="button" class="tile-group-item @(State.Opts.MissionTypeTab == 1 ? "active" : "")" @onclick="@(() => State.SelectTab(1))">Virtue <span class="text-gray-500 ml-1">(@State.CountOfType(1))</span></button>
        </div>
    };

    private bool AllMultiSelected =>
        (State.TabFiltered?.Count ?? 0) > 0 && State.MultiSelectedIds.Count >= (State.TabFiltered?.Count ?? 0);

    private RenderFragment RenderListControlSet() => __builder => {
        <div class="list-control-set ml-auto">
            <div class="tile-group">
                <button type="button" class="tile-group-item @(State.Opts.MultiViewMode == MultiViewMode.Off ? "active" : "")"
                        title="Multi-select off" @onclick="@(() => State.SetMultiViewAsync(MultiViewMode.Off))">
                    Off
                </button>
                <button type="button" class="tile-group-item @(State.Opts.MultiViewMode == MultiViewMode.Row ? "active" : "") @(State.Opts.SortByDropCount ? "opacity-40 cursor-not-allowed" : "")"
                        disabled="@State.Opts.SortByDropCount" title="Row/Date Select" @onclick="@(() => State.SetMultiViewAsync(MultiViewMode.Row))">
                    Row/Date
                </button>
                <button type="button" class="tile-group-item @(State.Opts.MultiViewMode == MultiViewMode.Free ? "active" : "")"
                        title="Free Select" @onclick="@(() => State.SetMultiViewAsync(MultiViewMode.Free))">
                    Free
                </button>
            </div>
            @if (State.Opts.MultiViewMode == MultiViewMode.Free) {
                <div class="list-control-actions">
                    <button type="button" class="list-control-action-btn" disabled="@(State.MultiSelectedIds.Count == 0)" @onclick="ViewSelectedMultiAsync">
                        View Selected (@State.MultiSelectedIds.Count)
                    </button>
                    @if (State.MultiSelectedIds.Count > 0) {
                        <button type="button" class="list-control-action-btn" @onclick="DeselectAllMulti">Deselect All</button>
                    }
                    @if (!AllMultiSelected) {
                        <button type="button" class="list-control-action-btn" @onclick="SelectAllMulti">Select All</button>
                    }
                </div>
            }
        </div>
    };

    private async Task ViewSelectedMultiAsync() {
        var ids = new List<string>();
        foreach (var m in State.TabFiltered ?? Array.Empty<DatabaseMission>()) {
            if (State.MultiSelectedIds.Contains(m.MissiondId)) {
                ids.Add(m.MissiondId);
            }
        }

        await ViewRowAsync(ids);
    }

    private void SelectAllMulti() {
        foreach (var m in State.TabFiltered ?? Array.Empty<DatabaseMission>()) {
            State.MultiSelectedIds.Add(m.MissiondId);
        }

        StateHasChanged();
    }

    private void DeselectAllMulti() {
        State.MultiSelectedIds.Clear();
        StateHasChanged();
    }

    public async Task ResortAsync(MissionSortMethod method) {
        if (_overlay is not null) {
            await _overlay.ReSortAsync(method);
        }
    }

    private async Task ViewMissionAsync(string missionId) {
        State.SetMissionBeingViewed(missionId);
        if (_overlay is not null) {
            await _overlay.OpenAsync(missionId);
        }
    }

    private async Task ViewRowAsync(IReadOnlyList<string> missionIds) {
        if (missionIds.Count == 0 || _overlay is null) {
            return;
        }

        if (missionIds.Count == 1) {
            await ViewMissionAsync(missionIds[0]);
            return;
        }

        State.SetMissionBeingViewed(null);
        await _overlay.OpenMultiAsync(missionIds);
    }

    public void Dispose() {
        State.Changed -= OnStateChanged;
        if (ReferenceEquals(State.Actions, this)) {
            State.Actions = null;
        }
    }

}
