@using System.Globalization
@* Year/month/day collapse tree, each mission a clickable row. Multi-view: Row/Date adds a
   per-day "View row" button; Free Select adds a per-mission checkbox. *@

@if (Grouping is null || Grouping.Missions.Count == 0) {
    <p class="text-gray-500 italic mt-0_75rem">No missions to display.</p>
} else {
    <div id="missionListDiv" class="mt-0_5rem px-2 py-1 shadow-sm block text-xs font-mono text-gray-500 bg-darkest rounded-md">
        <MissionCardCustomStyle Config="Config"/>
        <div class="sticky top-0 z-10 bg-darkest -mx-2 px-2 pt-1 pb-1">
            <div class="flex items-center gap-2 flex-wrap">
                <span class="text-xl">
                    Missions
                    <button type="button" class="text-xl toggle-link" @onclick="ToggleAll">
                        @(AllExpanded ? "Collapse All" : "Expand All")
                    </button>
                </span>
            </div>
            <hr class="mt-0_5rem mb-0_5rem w-full"/>
        </div>

        @if (FlatMissions is not null) {
            <div class="mt-1rem mission-grid mission-items-full">
                @foreach (var mission in FlatMissions) {
                    var m = mission;
                    <MissionCard Mission="m"
                                 Config="Config"
                                 IsSelected="@SelectedIds.Contains(m.MissiondId)"
                                 IsBeingViewed="@(MissionBeingViewed == m.MissiondId)"
                                 ViewByDate="@false"
                                 ViewMissionTimes="ViewMissionTimes"
                                 MultiViewMode="MultiViewMode"
                                 RecolorDC="RecolorDC"
                                 RecolorBC="RecolorBC"
                                 DropCount="@GetDropCount(m.MissiondId)"
                                 OnView="OnView"
                                 OnToggleSelected="ToggleSelected"/>
                }
            </div>
        } else {
            @for (var yi = 0; yi < Grouping.Missions.Count; yi++) {
                var yearIndex = yi;
                var year = Grouping.Arrays.Year[yearIndex];
                <div>
                    <span class="text-lg font-bold mr-0_5rem ledger-underline">@year.Year</span>
                    <button type="button" class="text-lg toggle-link" @onclick="@(() => ToggleYear(yearIndex))">
                        @(year.Enabled ? "Collapse" : "Expand")
                    </button>

                    @if (year.Enabled) {
                        @for (var mi = 0; mi < Grouping.Missions[yearIndex].Count; mi++) {
                            var monthIndex = mi;
                            var month = Grouping.Arrays.Month[yearIndex][monthIndex];
                            <div>
                                <div class="mt-1rem ml-2rem">
                                    <span class="text-base font-bold mr-0_5rem ledger-underline">
                                        @year.Year-@month.Month.ToString("00", CultureInfo.InvariantCulture)
                                    </span>
                                    <button type="button" class="text-base toggle-link" @onclick="@(() => ToggleMonth(yearIndex, monthIndex))">
                                        @(month.Enabled ? "Collapse" : "Expand")
                                    </button>

                                    @if (month.Enabled) {
                                        @for (var di = 0; di < Grouping.Missions[yearIndex][monthIndex].Count; di++) {
                                            var dayIndex = di;
                                            var day = Grouping.Arrays.Day[yearIndex][monthIndex][dayIndex];
                                            <div>
                                                <div class="mt-1rem ml-2rem">
                                                    @if (ViewByDate) {
                                                        <span class="text-sm font-bold mr-0_5rem ledger-underline">
                                                            @year.Year-@month.Month.ToString("00", CultureInfo.InvariantCulture)-@day.Day.ToString("00", CultureInfo.InvariantCulture)
                                                        </span>
                                                        <button type="button" class="text-sm mr-0_5rem toggle-link"
                                                                @onclick="@(() => ToggleDay(yearIndex, monthIndex, dayIndex))">
                                                            @(day.Enabled ? "Collapse" : "Expand")
                                                        </button>
                                                    }
                                                    <div class="mt-1rem flex items-start gap-2">
                                                        @if (MultiViewMode == MultiViewMode.Row) {
                                                            <button type="button" class="text-sm toggle-link shrink-0 self-center"
                                                                    @onclick="@(() => ViewRow(yearIndex, monthIndex, dayIndex))">
                                                                View row
                                                            </button>
                                                        }
                                                        <div class="mission-grid mission-items-full flex-1">
                                                            @if (DayVisible(yearIndex, monthIndex, dayIndex)) {
                                                                @foreach (var mission in Grouping.Missions[yearIndex][monthIndex][dayIndex]) {
                                                                    var m = mission;
                                                                    <MissionCard Mission="m"
                                                                                 Config="Config"
                                                                                 IsSelected="@SelectedIds.Contains(m.MissiondId)"
                                                                                 IsBeingViewed="@(MissionBeingViewed == m.MissiondId)"
                                                                                 ViewByDate="ViewByDate"
                                                                                 ViewMissionTimes="ViewMissionTimes"
                                                                                 MultiViewMode="MultiViewMode"
                                                                                 RecolorDC="RecolorDC"
                                                                                 RecolorBC="RecolorBC"
                                                                                 DropCount="@GetDropCount(m.MissiondId)"
                                                                                 OnView="OnView"
                                                                                 OnToggleSelected="ToggleSelected"/>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    }
                                </div>
                            </div>
                        }

                        <br/>
                        @if (yearIndex != Grouping.Missions.Count - 1) {
                            <hr class="pt-3rem pb-3rem invisible mt-1"/>
                        }
                    }
                </div>
            }
        }
    </div>
}

@code {
    [Parameter] public MissionGrouping? Grouping { get; set; }
    [Parameter] public bool ViewByDate { get; set; }
    [Parameter] public bool ViewMissionTimes { get; set; }
    [Parameter] public MultiViewMode MultiViewMode { get; set; } = MultiViewMode.Off;
    [Parameter] public bool RecolorDC { get; set; }
    [Parameter] public bool RecolorBC { get; set; }
    [Parameter] public MissionCardConfig Config { get; set; } = MissionCardConfig.Classic;

    [Parameter] public HashSet<string> SelectedIds { get; set; } = new();

    [Parameter] public IReadOnlyList<DatabaseMission> TabFiltered { get; set; } = Array.Empty<DatabaseMission>();

    [Parameter] public string? MissionBeingViewed { get; set; }

    [Parameter] public IReadOnlyList<DatabaseMission>? FlatMissions { get; set; }

    [Parameter] public Dictionary<string, int>? DropCounts { get; set; }

    [Parameter] public EventCallback<string> OnViewMission { get; set; }

    [Parameter] public EventCallback<IReadOnlyList<string>> OnViewRow { get; set; }

    [Parameter] public EventCallback OnSelectionChanged { get; set; }

    [Parameter] public EventCallback OnGroupingChanged { get; set; }

    private async Task OnView(string missionId) {
        await OnViewMission.InvokeAsync(missionId);
    }

    private async Task ViewRow(int yi, int mi, int di) {
        var ids = new List<string>();
        foreach (var m in Grouping!.Missions[yi][mi][di]) {
            ids.Add(m.MissiondId);
        }

        await OnViewRow.InvokeAsync(ids);
    }

    private string? _lastToggledId;

    private async Task ToggleSelected((string MissionId, bool Shift) args) {
        var (missionId, shift) = args;
        if (shift && _lastToggledId is not null && SelectRange(_lastToggledId, missionId)) {
            _lastToggledId = missionId;
            await OnSelectionChanged.InvokeAsync();
            return;
        }

        if (!SelectedIds.Remove(missionId)) {
            SelectedIds.Add(missionId);
        }

        _lastToggledId = missionId;
        await OnSelectionChanged.InvokeAsync();
    }

    private IReadOnlyList<DatabaseMission> DisplayOrder => FlatMissions ?? TabFiltered;

    private bool SelectRange(string fromId, string toId) {
        var order = DisplayOrder;
        var fromIndex = -1;
        var toIndex = -1;
        for (var i = 0; i < order.Count; i++) {
            if (order[i].MissiondId == fromId) {
                fromIndex = i;
            }

            if (order[i].MissiondId == toId) {
                toIndex = i;
            }
        }

        if (fromIndex < 0 || toIndex < 0) {
            return false;
        }

        var start = Math.Min(fromIndex, toIndex);
        var end = Math.Max(fromIndex, toIndex);
        for (var i = start; i <= end; i++) {
            SelectedIds.Add(order[i].MissiondId);
        }

        return true;
    }

    private bool DayVisible(int yi, int mi, int di) {
        return ViewByDate ? Grouping!.Arrays.Day[yi][mi][di].Enabled : Grouping!.Arrays.Month[yi][mi].Enabled;
    }


    private bool AllExpanded {
        get {
            if (Grouping is null) {
                return true;
            }

            foreach (var y in Grouping.Arrays.Year) {
                if (!y.Enabled) {
                    return false;
                }
            }

            return true;
        }
    }

    private async Task ToggleAll() {
        if (Grouping is null) {
            return;
        }

        SetAll(!AllExpanded);
        await NotifyAsync();
    }

    private void SetAll(bool enabled) {
        foreach (var y in Grouping!.Arrays.Year) {
            y.Enabled = enabled;
        }

        foreach (var months in Grouping.Arrays.Month) {
            foreach (var mo in months) {
                mo.Enabled = enabled;
            }
        }

        foreach (var yearDays in Grouping.Arrays.Day) {
            foreach (var monthDays in yearDays) {
                foreach (var d in monthDays) {
                    d.Enabled = enabled;
                }
            }
        }
    }

    private async Task ToggleYear(int yi) {
        var y = Grouping!.Arrays.Year[yi];
        y.Enabled = !y.Enabled;
        await NotifyAsync();
    }

    private async Task ToggleMonth(int yi, int mi) {
        var mo = Grouping!.Arrays.Month[yi][mi];
        mo.Enabled = !mo.Enabled;
        await NotifyAsync();
    }

    private async Task ToggleDay(int yi, int mi, int di) {
        var d = Grouping!.Arrays.Day[yi][mi][di];
        d.Enabled = !d.Enabled;
        await NotifyAsync();
    }

    private int? GetDropCount(string missionId) {
        if (DropCounts is not null && DropCounts.TryGetValue(missionId, out var count)) {
            return count;
        }

        return null;
    }

    private async Task NotifyAsync() {
        await OnGroupingChanged.InvokeAsync();
    }

}
