@using System.Globalization

<div class="rline" style="--rline-color: @Color;">
    @if (Points().Count >= 2) {
        var pts = Points();
        var max = MaxVal();
        var ticks = ChartGeometry.YTicks(max, H, Result.IsFloat);
        <svg viewBox="0 0 @Fmt(W) @Fmt(H)" preserveAspectRatio="none" class="rline-svg">
            <defs>
                <linearGradient id="@_gradId" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="@Color" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="@Color" stop-opacity="0.02"/>
                </linearGradient>
            </defs>

            @if (max > 0) {
                @foreach (var tick in ticks) {
                    <line class="rline-grid" x1="@Fmt(ChartGeometry.PadLeft)" y1="@Fmt(tick.Y)"
                          x2="@Fmt(W - ChartGeometry.PadRight)" y2="@Fmt(tick.Y)"
                          stroke-dasharray="3 3" stroke-width="0.5" vector-effect="non-scaling-stroke"/>
                }
            }

            @if (ChartType != "line") {
                <path d="@ChartGeometry.AreaPath(pts, H)" fill="url(#@_gradId)"/>
            }

            <polyline points="@ChartGeometry.PolylinePoints(pts)" fill="none"
                      stroke="@Color" stroke-width="1.5" stroke-linejoin="round" stroke-linecap="round"
                      vector-effect="non-scaling-stroke"/>
        </svg>

        @if (max > 0) {
            @foreach (var tick in ticks) {
                <span class="rline-ytick" style="@RightPos(ChartGeometry.PadLeft - 4, tick.Y)">@tick.Label</span>
            }
        }

        @foreach (var p in ChartGeometry.ThinLabels(pts)) {
            <span class="rline-xlabel" style="@RightPos(p.X, H - ChartGeometry.PadBottom + 4)">@ChartGeometry.FormatXLabel(p.Label)</span>
        }

        @for (var i = 0; i < pts.Count; i++) {
            var idx = i;
            var p = pts[i];
            <span class="rline-hit" style="@LeftPos(p.X, p.Y)"
                  @onmouseenter="() => _hover = idx" @onmouseleave="() => _hover = null">
                <span class="rline-dot"></span>
            </span>
        }

        @if (_hover is { } h && h < pts.Count) {
            <PointTooltip Visible="true" X="@Pct(pts[h].X, W)" Y="@Pct(pts[h].Y, H)"
                          Lines="@PointLines(pts[h])" PopClass="report-tooltip"/>
        }
    } else {
        <div class="rline-msg">
            <span class="rline-empty">Not enough data for a line chart</span>
        </div>
    }
</div>

@code {
    private const double W = 300;
    private const double H = 150;
    private int? _hover;
    private readonly string _gradId = "line-grad-" + Guid.NewGuid().ToString("N").Substring(0, 5);
    [Parameter] [EditorRequired] public ReportResult Result { get; set; } = new();
    [Parameter] [EditorRequired] public string Color { get; set; } = "#6366f1";
    [Parameter] public string? UnitLabel { get; set; }

    [Parameter] public string? ChartType { get; set; }

    private string UnitSuffix => string.IsNullOrEmpty(UnitLabel) ? "" : " " + UnitLabel;

    private List<double> Values() {
        return ChartGeometry.Values(Result.Values, Result.FloatValues, Result.IsFloat);
    }

    private double MaxVal() {
        return Values().DefaultIfEmpty(0).Max();
    }

    private List<ChartPoint> Points() {
        return ChartGeometry.Points(Values(), Result.Labels, W, H);
    }

    private string FormatValue(double v) {
        return Result.IsFloat
            ? v.ToString("0.00", CultureInfo.InvariantCulture)
            : Math.Round(v).ToString(CultureInfo.InvariantCulture);
    }

    private IReadOnlyList<TooltipLine> PointLines(ChartPoint p) {
        return [new TooltipLine(p.Label, Head: true), new TooltipLine(FormatValue(p.Value) + UnitSuffix)];
    }

    private static double Pct(double v, double total) {
        return v / total * 100;
    }

    private static string LeftPos(double x, double y) {
        return string.Create(CultureInfo.InvariantCulture, $"left:{Pct(x, W):0.###}%;top:{Pct(y, H):0.###}%");
    }

    private static string RightPos(double x, double y) {
        return string.Create(CultureInfo.InvariantCulture, $"right:{100 - Pct(x, W):0.###}%;top:{Pct(y, H):0.###}%");
    }

    private static string Fmt(double v) {
        return v.ToString("0.###", CultureInfo.InvariantCulture);
    }

}
