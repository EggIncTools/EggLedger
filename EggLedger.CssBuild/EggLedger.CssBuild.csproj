<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Build-time CSS compiler for EggLedger.Web: scans .razor/.html markup for utility/component class tokens and compiles wwwroot/styles.css via MonorailCss + EggIdentity.Styles.</Description>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonorailCss" Version="0.1.3" />
    <PackageReference Include="EggIdentity.Styles" Version="2.0.8" />
  </ItemGroup>

</Project>
