@using EggIdentity.Reports
@using EggIdentity.UI.Reports
@inject IndexedDbReportStore Store
@inject IReportRunner Runner
@inject ILogger<ReportBuilderPanel> Logger
@inject TimeProvider Time

<ModalHost Open="_open" OnClose="Close" Title="@(_editing ? "Edit Report" : "Add Report")" Width="ModalWidth.Regular">
    <ChildContent>
        @if (_report is not null) {
            <div class="rb">
                <div class="rb-body">
                    <ReportBuilderGuided OnApply="OnGuidedApply"/>

                    <ReportBuilder Sources="LedgerReportSources.All" Value="_report.Definition" ValueChanged="OnDefinitionChanged" Cost="_cost"/>

                    <div class="rb-field">
                        <span class="rb-label">Grid size</span>
                        <ReportGridSizePicker Width="_report.Placement.W" WidthChanged="SetWidth" Height="_report.Placement.H" HeightChanged="SetHeight"/>
                    </div>

                    <div class="rb-preview">
                        <div class="rb-preview-head">
                            <span class="rb-label">Preview</span>
                            <button type="button" class="rb-foot-btn rb-preview-btn" @onclick="RefreshPreviewAsync" disabled="@_previewLoading">Preview</button>
                        </div>
                        <EggIdentity.UI.Reports.ReportCard Definition="_report.Definition" Cube="_preview" Source="_previewSource" Loading="_previewLoading" Error="@_previewError"/>
                    </div>
                </div>

                <div class="rb-foot">
                    <button type="button" class="rb-foot-btn rb-foot-cancel" @onclick="Close">Cancel</button>
                    <button type="button" class="rb-foot-btn rb-foot-save" @onclick="SaveAsync" disabled="@string.IsNullOrWhiteSpace(_report.Definition.Title)">Save</button>
                </div>
            </div>
        }
    </ChildContent>
</ModalHost>

@code {
    [Parameter, EditorRequired] public string AccountId { get; set; } = "";

    [Parameter] public string? GroupId { get; set; }

    [Parameter] public EventCallback Saved { get; set; }

    private bool _open;
    private bool _editing;
    private LedgerReport? _report;
    private LedgerReportCost? _cost;
    private ReportCube? _preview;
    private IReportSource? _previewSource;
    private bool _previewLoading;
    private string? _previewError;

    public Task OpenForCreateAsync() {
        string id = Guid.NewGuid().ToString("D");
        _editing = false;
        _report = new LedgerReport(
            new ReportDefinition(ReportCodec.CurrentVersion, id, "", new ReportQuery(LedgerReportKeys.Missions), new ReportView(ReportCharts.Bar)),
            new ReportPlacement(id, 0, 0, 2, 2, int.MaxValue) { Group = GroupId }
        ) {
            AccountId = AccountId
        };
        _cost = new LedgerReportCost(Time);
        _preview = null;
        _previewSource = null;
        _previewError = null;
        _open = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task OpenForEditAsync(LedgerReport report) {
        _editing = true;
        _report = report;
        _cost = new LedgerReportCost(Time);
        _preview = null;
        _previewSource = null;
        _previewError = null;
        _open = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task OnDefinitionChanged(ReportDefinition d) {
        if (_report is null) return Task.CompletedTask;

        _report = _report with { Definition = d };
        return Task.CompletedTask;
    }

    private Task OnGuidedApply(ReportDefinition applied) {
        if (_report is null) return Task.CompletedTask;

        _report = _report with { Definition = applied with { Id = _report.Id } };
        return Task.CompletedTask;
    }

    private void SetWidth(int w) {
        if (_report is null) return;

        _report = _report with { Placement = _report.Placement with { W = w } };
    }

    private void SetHeight(int h) {
        if (_report is null) return;

        _report = _report with { Placement = _report.Placement with { H = h } };
    }

    private async Task RefreshPreviewAsync() {
        if (_report is null) return;

        _previewLoading = true;
        _previewError = null;

        try {
            _preview = await Runner.RunReportAsync(_report.Definition.Query, AccountId);
            _previewSource = LedgerReportSources.All.FirstOrDefault(s => string.Equals(s.Id, _report.Definition.Query.Source, StringComparison.Ordinal));
        } catch (Exception ex) {
            Logger.LogDebug(ex, "report preview failed");
            _preview = null;
            _previewError = "Preview failed";
        }

        _previewLoading = false;
    }

    private async Task SaveAsync() {
        if (_report is null || string.IsNullOrWhiteSpace(_report.Definition.Title)) return;

        var row = ReportMapping.ToRow(_report);
        if (_editing) {
            await Store.UpdateReportAsync(row);
        } else {
            await Store.InsertReportAsync(row);
        }

        _open = false;
        _report = null;
        await Saved.InvokeAsync();
    }

    private void Close() {
        _open = false;
        _report = null;
    }
}
